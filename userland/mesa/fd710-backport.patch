         magic_regs = a730_magic_regs,
         raw_magic_regs = a730_raw_magic_regs,
+    ))
+
+# FD710 (gen7_3_0, chip id 0x07010000: SM6475/SM7435 "parrot"), backported to 25.0.7 from
+# Mesa main 4db0b15c ("freedreno: Add support for Adreno 710 and 720"). Main's entry lists
+# every register in raw_magic_regs; 25.0.7 writes its named magic_regs after the raw ones, so
+# the values main captured for those (SP_CHICKEN_BITS, PC_MODE_CNTL, RB_CCU_DBG_ECO_CNTL =
+# RB_UNKNOWN_8E06) go into a710_magic_regs, and main's newer register names become 25.0.7's
+# (SP_CHICKEN_BITS_1-3 = SP_UNKNOWN_AE08-AE0A, SP_HLSQ_DBG_ECO_CNTL = SP_UNKNOWN_AE6C,
+# VFD_DBG_ECO_CNTL = VFD_UNKNOWN_A600, SP_ISDB_CNTL = SP_UNKNOWN_AE06,
+# SP_HLSQ_TIMEOUT_THRESHOLD_DP = SP_UNKNOWN_AE6B, SP_HLSQ_DBG_ECO_CNTL_1 = SP_UNKNOWN_AE73,
+# SP_HLSQ_MODE_CNTL = SP_UNKNOWN_AB02, GRAS_ROTATION_CNTL = GRAS_UNKNOWN_80A7,
+# RB_LRZ_CNTL2 = RB_UNKNOWN_8899; same offsets). Main does not write UCHE_CLIENT_PF for the
+# 710: here it is kgsl's own gen7_3_0 value, so the write changes nothing.
+a710_magic_regs = dict(a730_magic_regs,
+        SP_CHICKEN_BITS = 0x00000400,
+        PC_MODE_CNTL = 0x00001f1f,
+        UCHE_CLIENT_PF = 0x00000081,
+        RB_UNKNOWN_8E06 = 0x00080000,
+    )
+
+a710_raw_magic_regs = [
+        [A6XXRegs.REG_A6XX_UCHE_CACHE_WAYS, 0x00040004],
+        [A6XXRegs.REG_A6XX_TPL1_DBG_ECO_CNTL1, 0x00000700],
