kunzite (SM6475 parrot): MPIDR Aff1 = core index with Aff0 = 0, exactly
sweet's encoding (kunzite live FDT: 4x A55 at 0x000-0x300, 4x A78 at
0x400-0x700; every core has the 16K granule, xnu boots on ABL's core 0x000 and
PSCI-starts the rest). Inverse of 0080's SweetCPU hunk and of 0082; 0080's
sweethw=1 gating of the unported SM7150 key/touch/USB drivers stays.
diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -73,8 +73,8 @@ SweetCPU::start(IOService *provider)
 	if (*(const uint32_t *)reg->getBytesNoCopy() != cpu->phys_id) {
 		return false;
 	}
+	/* kunzite: MPIDR Aff1 = core idx, 0x000-0x300 A55, 0x400-0x700 A78 */
+	if (cpu->phys_id > 0x700 || (cpu->phys_id & 0xff) != 0 ||
-	/* topaz (SM6225): MPIDR Aff1 = cluster, Aff0 = core: 0x0-0x3 A53, 0x100-0x103 A73 */
-	if ((cpu->phys_id >> 8) > 1 || (cpu->phys_id & 0xff) > 3 ||
 	    topology->num_cpus > SWEET_SMP_MAX_CPUS) {
 		panic("SWEET CPU: invalid topology cpu=%u mpidr=0x%x count=%u",
 		    cpu->cpu_id, cpu->phys_id, topology->num_cpus);
@@ -82,7 +82,7 @@ SweetCPU::start(IOService *provider)
 	if (!IOCPU::start(provider)) {
 		return false;
 	}
+	cpuName = OSSymbol::withCStringNoCopy("Kryo (SM6475)");
-	cpuName = OSSymbol::withCStringNoCopy("Kryo 260");
 	if (cpuName == NULL) {
 		return false;
 	}
