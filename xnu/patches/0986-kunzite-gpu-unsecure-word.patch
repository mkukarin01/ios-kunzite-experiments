+/* the memory of ours an undo entry will free, by the entry's name (step 19's blocks), or 0 */
+static vm_offset_t
+kg_undo_mem(const char *name)
+{
+	for (unsigned i = 0; i < kg.nundo; i++) {
+		if (kg.undo[i].kind == KG_UNDO_KFREE && strcmp(kg.undo[i].name, name) == 0) {
+			return kg.undo[i].base;
+		}
+	}
+	return 0;
+}
