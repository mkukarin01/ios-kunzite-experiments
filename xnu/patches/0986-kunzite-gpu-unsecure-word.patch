+/* ---- step 21: out of secure mode, a word written by the GPU (the port map's 21) ---- */
+
+#define GEN7_RBBM_SECVID_TRUST_CNTL      0xf400
+#define KG_PKT_SET_SECURE_MODE 0x70e60001u  /* cp_type7_packet(CP_SET_SECURE_MODE 0x66, 1) */
+#define KG_PKT_MEM_WRITE       0x703d8003u  /* cp_type7_packet(CP_MEM_WRITE 0x3d, 3): lo, hi, value */
+#define KG_PKT_WAIT_MEM_WRITES 0x70928000u  /* cp_type7_packet(CP_WAIT_MEM_WRITES 0x12, 0) */
+#define KG_GPU_WORD_OFF  0x100u          /* in the scratch page, after the rptr shadow */
+#define KG_GPU_WORD      0x6b677021u     /* "!pgk" */
+
+/*
+ * Words appended to the ring at WPTR (no wrap: the ring is 8K words), WPTR
+ * moved past them (gen7_ringbuffer_submit; the fence is in allow mode),
+ * then adreno_spin_idle's test for up to 2 s: RPTR = WPTR, CX busy bit 23
+ * clear. CP, RBBM and context 0 status printed after.
+ */
+static bool
+kg_cp_submit(const char *what, const uint32_t *cmds, uint32_t n)
+{
+	vm_offset_t rb = kg_undo_mem("gpu ringbuffer");
+	uint32_t cb = (kg.smmu_pages + KG_GPU_CB) * kg.smmu_page, rptr = 0, busy = 0;
+	unsigned t;
+
+	if (rb == 0 || kg_rb_wptr == 0 || kg_rb_wptr + n > KG_RB_SIZE / 4) {
+		printf("SWEET KGPU: 21 no room in the ring for %s\n", what);
+		return false;
+	}
+	memcpy((uint32_t *)rb + kg_rb_wptr, cmds, 4u * n);
+	kg_to_memory(rb + 4u * kg_rb_wptr, 4u * n);
+	kg_rb_wptr += n;
+	kg_set("GPU", kg.gpu, 4u * GEN7_CP_RB_WPTR, kg_rb_wptr, what);
+	uint32_t fence = kg_gmu(GEN7_GMU_AHB_FENCE_STATUS);
+	for (t = 0; t < 20000; t++) {
+		rptr = kg_rd(kg.gpu, 4u * GEN7_CP_RB_RPTR);
+		busy = kg_gmu(GEN7_GMU_AO_GPU_CX_BUSY_STATUS);
+		if (rptr == kg_rb_wptr && !(busy & (1u << 23))) {
+			break;
+		}
+		delay(100);
+	}
+	kg_wr(kg.gpu, 4u * GEN7_CP_SQE_STAT_ADDR, 1);
+	printf("SWEET KGPU: 21   after %u.%u ms: rptr %u wptr %u, cx_busy %#x, fence status %#x; rbbm_status %#x int_0 %#x; "
+	    "cp interrupt %#x hw_fault %#x protect %#x sqe_stat %#x; cb0 fsr %#x\n", t / 10, t % 10, rptr, kg_rb_wptr,
+	    busy, fence, kg_rd(kg.gpu, 4u * GEN7_RBBM_STATUS), kg_rd(kg.gpu, 4u * GEN7_RBBM_INT_0_STATUS),
+	    kg_rd(kg.gpu, 4u * GEN7_CP_INTERRUPT_STATUS), kg_rd(kg.gpu, 4u * GEN7_CP_HW_FAULT),
+	    kg_rd(kg.gpu, 4u * GEN7_CP_PROTECT_STATUS), kg_rd(kg.gpu, 4u * GEN7_CP_SQE_STAT_DATA),
+	    kg_rd(kg.smmu, cb + SMMU_CB_FSR));
+	return rptr == kg_rb_wptr && !(busy & (1u << 23));
+}
+
+/*
+ * gen7_rb_start after adreno_zap_shader_load: CP_SET_SECURE_MODE 0 through
+ * the ring (kgsl writes RBBM_SECVID_TRUST_CNTL directly only when no zap is
+ * loaded), adreno_spin_idle. Then the port map's proof: CP_MEM_WRITE of a
+ * known word to the scratch page (GPU 0xe0008100), CP_WAIT_MEM_WRITES, idle,
+ * and the word read back from our side. Nothing new to undo: the CP is
+ * halted (step 20's entry) and its registers go with GX.
+ */
+static bool
+kg_step21(void)
+{
+	vm_offset_t scratch = kg_undo_mem("gpu scratch page");
+
+	if (kg_rb_wptr == 0 || scratch == 0 || !kg_gx_on()) {
+		printf("SWEET KGPU: 21 needs steps 1-20 (the CP running, in this run)\n");
+		return false;
+	}
+	volatile uint32_t *word = (volatile uint32_t *)(scratch + KG_GPU_WORD_OFF);
+	kg_to_memory(scratch, 0x1000);
+	kg_announce(21, "RBBM_SECVID_TRUST_CNTL and the scratch word before");
+	printf("SWEET KGPU: 21 secvid_trust_cntl %#x; scratch rptr shadow %u, word %#x\n",
+	    kg_rd(kg.gpu, 4u * GEN7_RBBM_SECVID_TRUST_CNTL), *(volatile uint32_t *)scratch, *word);
+
+	kg_next(21, "CP_SET_SECURE_MODE 0 through the ring (gen7_rb_start with the zap loaded): out of secure mode");
+	static const uint32_t secure[2] = { KG_PKT_SET_SECURE_MODE, 0 };
+	bool secure_ok = kg_cp_submit("cp_rb_wptr (cp_set_secure_mode 0)", secure, 2);
+	printf("SWEET KGPU: 21 secvid_trust_cntl %#x after: %s\n", kg_rd(kg.gpu, 4u * GEN7_RBBM_SECVID_TRUST_CNTL),
+	    secure_ok ? "the CP left secure mode and is idle" : "the CP did not get through CP_SET_SECURE_MODE");
+	if (!secure_ok) {
+		return false;
+	}
+
+	kg_next(21, "CP_MEM_WRITE 0x6b677021 to GPU 0xe0008100 (the scratch page), CP_WAIT_MEM_WRITES");
+	uint64_t va = KG_GPU_SCRATCH_VA + KG_GPU_WORD_OFF;
+	const uint32_t write[5] = { KG_PKT_MEM_WRITE, (uint32_t)va, (uint32_t)(va >> 32), KG_GPU_WORD,
+	    KG_PKT_WAIT_MEM_WRITES };
+	bool idle = kg_cp_submit("cp_rb_wptr (cp_mem_write)", write, 5);
+	kg_to_memory(scratch, 0x1000);
+	uint32_t got = *word;
+	printf("SWEET KGPU: 21 scratch word %#x (rptr shadow %u)\n", got, *(volatile uint32_t *)scratch);
+	bool ok = idle && got == KG_GPU_WORD;
+	printf("SWEET KGPU: 21 %s\n", ok ? "THE GPU WROTE A WORD: 0x6b677021 at 0xe0008100, out of secure mode" :
+	    got == KG_GPU_WORD ? "the word is there, but the GPU does not go idle" : "the word is not there");
+	return ok;
+}
+
