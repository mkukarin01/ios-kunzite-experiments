+/* TrustZone (qcom_scm.c / qcom_scm-smc.c: SiP, SMC64, yielding; the same as TopazModem's) */
+#define KG_SCM_FN(call)          (0x42000000u | (call))         /* the SMC function number */
+#define KG_SCM_ID(call)          (0x02000000u | (call))         /* the same call as an argument */
+#define KG_SCM_INFO_IS_AVAIL     0x601u          /* service << 8 | command */
+#define KG_SCM_PAS_INIT_IMAGE    0x201u
+#define KG_SCM_PAS_MEM_SETUP     0x202u
+#define KG_SCM_PAS_AUTH_RESET    0x205u
+#define KG_SCM_PAS_SHUTDOWN      0x206u
+#define KG_SCM_PAS_IS_SUPPORTED  0x207u
+#define KG_SCM_ARGS_VAL          1u              /* one plain value */
+#define KG_SCM_ARGS_VAL_RW       (2u | (2u << 6))  /* a value, then a buffer TZ reads and writes */
+#define KG_PAS_GPU               13u             /* kgsl_util.c GPU_PASID */
+#define KG_ZAP_MDT               "/usr/share/firmware/kunzite/a710_zap.mdt"
+/*
+ * The page the zap header goes in for TrustZone: low DDR, "System RAM" under
+ * Android (0xa7000000-0xe05fffff), never XNU's (its RAM is 0x900000000 on);
+ * below 4 GiB like Linux's (qcom_scm's 32-bit DMA mask). Mapped uncached.
+ * TrustZone may protect it during and after the call: nothing touches it again.
+ */
+#define KG_ZAP_META_PA           0xdff00000u
