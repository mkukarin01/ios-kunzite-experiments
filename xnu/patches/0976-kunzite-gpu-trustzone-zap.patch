+/* ---- step 11: TrustZone, calls that pass no memory ---- */
+
+/* one call, said before it is made (an SMC the hypervisor dislikes ends the run without a word) */
+static uint64_t
+kg_scm(unsigned step, const char *what, uint32_t call, uint64_t arginfo, uint64_t a, uint64_t b, uint64_t *res)
+{
+	printf("SWEET KGPU: %u smc %#x (%s) args %#llx %#llx\n", step, KG_SCM_FN(call), what, a, b);
+	*res = ~0ull;
+	uint64_t ret = topaz_scm(KG_SCM_FN(call), arginfo, a, b, 0, res);
+	printf("SWEET KGPU: %u   -> ret %#llx res %#llx\n", step, ret, *res);
+	return ret;
+}
+
+static bool
+kg_step11(void)
+{
+	static const struct { uint32_t call; const char *name; } calls[] = {
+		{ KG_SCM_PAS_INIT_IMAGE, "pas init image" }, { KG_SCM_PAS_MEM_SETUP, "pas mem setup" },
+		{ KG_SCM_PAS_AUTH_RESET, "pas auth and reset" }, { KG_SCM_PAS_SHUTDOWN, "pas shutdown" },
+		{ KG_SCM_PAS_IS_SUPPORTED, "pas is supported" },
+	};
+	static const struct { uint32_t id; const char *name; } images[] = {
+		{ 1, "ADSP" }, { 4, "modem" }, { 9, "video" }, { KG_PAS_GPU, "GPU zap shader" },
+	};
+	uint64_t res;
+	unsigned supported = 0;
+
+	kg_announce(11, "nothing; next: SCM is_call_available(is_call_available), Linux's first question to TrustZone");
+	if (kg_scm(11, "is_call_available", KG_SCM_INFO_IS_AVAIL, KG_SCM_ARGS_VAL, KG_SCM_ID(KG_SCM_INFO_IS_AVAIL), 0,
+	    &res) != 0 || res != 1) {
+		printf("SWEET KGPU: 11 TrustZone does not answer the way it answers Linux\n");
+		return false;
+	}
+	kg_announce(11, "nothing; next: is_call_available for the five PAS calls");
+	for (unsigned i = 0; i < sizeof(calls) / sizeof(calls[0]); i++) {
+		uint64_t ret = kg_scm(11, calls[i].name, KG_SCM_INFO_IS_AVAIL, KG_SCM_ARGS_VAL, KG_SCM_ID(calls[i].call), 0, &res);
+		printf("SWEET KGPU: 11 %s: %s\n", calls[i].name, ret == 0 && res == 1 ? "available" : "NOT available");
+	}
+	kg_announce(11, "nothing; next: pas_is_supported for images 1, 4, 9, 13");
+	for (unsigned i = 0; i < sizeof(images) / sizeof(images[0]); i++) {
+		uint64_t ret = kg_scm(11, images[i].name, KG_SCM_PAS_IS_SUPPORTED, KG_SCM_ARGS_VAL, images[i].id, 0, &res);
+		bool yes = ret == 0 && res == 1;
+		printf("SWEET KGPU: 11 PAS %u (%s): %s\n", images[i].id, images[i].name, yes ? "supported" : "not supported");
+		if (yes && images[i].id == KG_PAS_GPU) {
+			supported = 1;
+		}
+	}
+	printf("SWEET KGPU: 11 %s\n", supported ? "TRUSTZONE ANSWERS THIS KERNEL AND SUPPORTS THE GPU ZAP SHADER (PAS 13)" :
+	    "TrustZone answers, but does not list PAS 13: step 12 shows whether that matters");
+	return true;
+}
+
+/* ---- step 12: the zap shader's signature ---- */
+
+/* the .mdt as TrustZone takes it: ELF32 header, program headers, then the hash segment, nothing else */
+static bool
+kg_zap_header_ok(const uint8_t *m, size_t size)
+{
+	if (size < 52 || size > PAGE_SIZE || m[0] != 0x7f || m[1] != 'E' || m[2] != 'L' || m[3] != 'F' || m[4] != 1) {
+		printf("SWEET KGPU: 12 not a 32-bit ELF header of at most a page (%lu bytes)\n", (unsigned long)size);
+		return false;
+	}
+	uint32_t phoff = (uint32_t)m[28] | (uint32_t)m[29] << 8 | (uint32_t)m[30] << 16 | (uint32_t)m[31] << 24;
+	unsigned phnum = (unsigned)m[44] | (unsigned)m[45] << 8;
+	uint32_t hash = 0;
+	if (phoff != 52 || phnum < 2 || 52u + 32u * phnum > size) {
+		printf("SWEET KGPU: 12 unexpected program headers (at %u, %u of them)\n", phoff, phnum);
+		return false;
+	}
+	for (unsigned i = 0; i < phnum; i++) {
+		const uint8_t *p = m + 52 + 32 * i;
+		uint32_t flags = (uint32_t)p[24] | (uint32_t)p[25] << 8 | (uint32_t)p[26] << 16 | (uint32_t)p[27] << 24;
+		if (((flags >> 24) & 7u) == 2) {        /* QCOM_MDT_TYPE_HASH */
+			hash = (uint32_t)p[16] | (uint32_t)p[17] << 8 | (uint32_t)p[18] << 16 | (uint32_t)p[19] << 24;
+		}
+	}
+	printf("SWEET KGPU: 12 zap header: %u program headers, hash segment %u bytes, file %lu bytes\n", phnum, hash,
+	    (unsigned long)size);
+	if (hash == 0 || 52u + 32u * phnum + hash != size) {
+		printf("SWEET KGPU: 12 the file is not the headers followed by the hash segment alone\n");
+		return false;
+	}
+	return true;
+}
+
+static bool
+kg_step12(void)
+{
+	void *data = NULL;
+	size_t size = 0;
+	uint64_t res;
+
+	kg_announce(12, "the zap shader's header " KG_ZAP_MDT " from the root filesystem");
+	if (!topaz_root_mounted()) {
+		printf("SWEET KGPU: 12 the root filesystem is not mounted yet: raise kgpu_delay\n");
+		return false;
+	}
+	int err = topaz_fw_read(KG_ZAP_MDT, &data, &size);
+	if (err != 0) {
+		printf("SWEET KGPU: 12 cannot read " KG_ZAP_MDT " (error %d): upload the phone's "
+		    "/vendor/firmware/a710_zap.mdt there\n", err);
+		return false;
+	}
+	if (!kg_zap_header_ok(data, size)) {
+		topaz_fw_free(data, size);
+		return false;
+	}
+	kg_next(12, "the header into the page 0xdff00000 (low DDR, uncached), then PAS_INIT_IMAGE(13)");
+	vm_offset_t page = kg_map("zap metadata page", KG_ZAP_META_PA, PAGE_SIZE);
+	if (page == 0) {
+		topaz_fw_free(data, size);
+		return false;
+	}
+	printf("SWEET KGPU: 12 write zap metadata page %#x: %lu bytes\n", KG_ZAP_META_PA, (unsigned long)size);
+	for (size_t off = 0; off < PAGE_SIZE; off += 4) {      /* device memory: aligned words only */
+		uint32_t w = 0;
+		for (size_t k = 0; k < 4 && off + k < size; k++) {
+			w |= (uint32_t)((const uint8_t *)data)[off + k] << (8 * k);
+		}
+		kg_wr(page, (uint32_t)off, w);
+	}
+	topaz_fw_free(data, size);
+	__asm__ volatile("dsb sy" ::: "memory");
+	uint64_t ret = kg_scm(12, "pas init image (zap signature)", KG_SCM_PAS_INIT_IMAGE, KG_SCM_ARGS_VAL_RW, KG_PAS_GPU,
+	    KG_ZAP_META_PA, &res);
+	if (ret == 0 && res == 0) {
+		printf("SWEET KGPU: 12 TRUSTZONE ACCEPTS THE ZAP SHADER'S SIGNATURE FROM THIS KERNEL\n");
+		return true;
+	}
+	printf("SWEET KGPU: 12 TrustZone does not take it (ret %#llx res %#llx)\n", ret, res);
+	return false;
+}
+
