+/* undo the newest write on the list (the end of the run does all of them, in reverse) */
+static void
+kg_undo_pop(void)
+{
+	if (kg.nundo == 0) {
+		return;
+	}
+	--kg.nundo;
+	vm_offset_t base = kg.undo[kg.nundo].base;
+	uint32_t off = kg.undo[kg.nundo].off, value = kg.undo[kg.nundo].value;
+	const char *name = kg.undo[kg.nundo].name;
+	switch (kg.undo[kg.nundo].kind) {
+	case KG_UNDO_WORD:
+		kg_wr(base, off, value);
+		break;
+	case KG_UNDO_CLEAR:
+		kg_wr(base, off, kg_rd(base, off) & ~value);
+		break;
+	case KG_UNDO_RCG:               /* off = the CFG register; CMD is 4 before it */
+		kg_wr(base, off, value);
+		kg_wr(base, off - 4, kg_rd(base, off - 4) | KG_RCG_UPDATE);
+		(void)kg_poll(base, off - 4, KG_RCG_UPDATE, 0, 10);
+		break;
+	case KG_UNDO_GDSC:              /* the vendor's driver does not check the status on disable */
+		kg_wr(base, off, kg_rd(base, off) | KG_GDSC_COLLAPSE);
+		(void)kg_poll(base, off, KG_GDSC_PWR_ON, 0, 100);
+		break;
+	}
+	printf("SWEET KGPU: undo %s +%#x: now %#x\n", name, off, kg_rd(base, off));
+}
+
