 }
 
+/* ---- step 10: the GMU's memory takes what is written ---- */
+
+#define KG_GMU_OFF(reg)  (4u * (reg) - (KG_GMU_PA - KG_GPU_PA))
+
+/*
+ * Firmware is loaded by writing it into the GMU processor's memories through
+ * these registers while the processor is held in reset (kgsl
+ * gen7_gmu_load_fw). Two words of DTCM go there and back, and what was there
+ * is put back at once.
+ */
+static bool
+kg_step10(void)
+{
+	static const uint32_t pattern[2] = { 0x600d0001u, 0x0a110002u };
+	uint32_t back[2];
+
+	if (!kg_cx_ready(10) || kg.gmu == 0) {
+		printf("SWEET KGPU: 10 needs steps 4-6\n");
+		return false;
+	}
+	kg_announce(10, "the GMU's reset and firmware state");
+	uint32_t sysreset = kg_gmu(GEN7_GMU_CM3_SYSRESET), init = kg_gmu(GEN7_GMU_CM3_FW_INIT_RESULT);
+	printf("SWEET KGPU: 10 cm3 sysreset %#x fw_init_result %#x\n", sysreset, init);
+	if (!(sysreset & 1u) || (init & (1u << 8))) {
+		printf("SWEET KGPU: 10 the GMU's processor is running (or has run firmware): leaving its memory alone\n");
+		return false;
+	}
+	kg_next(10, "two words into the GMU's DTCM (0x3d71000), read back, then restored");
+	for (unsigned i = 0; i < 2; i++) {
+		kg_put("GMU", kg.gmu, KG_GMU_OFF(GEN7_GMU_CM3_DTCM_START + i), pattern[i], KG_UNDO_WORD, 0, "dtcm");
+	}
+	for (unsigned i = 0; i < 2; i++) {
+		back[i] = kg_gmu(GEN7_GMU_CM3_DTCM_START + i);
+	}
+	kg_undo_pop();
+	kg_undo_pop();
+	bool takes = back[0] == pattern[0] && back[1] == pattern[1];
+	printf("SWEET KGPU: 10 read back %#x %#x: the GMU's memory %s\n", back[0], back[1],
+	    takes ? "TAKES WHAT IS WRITTEN: its firmware can be loaded" : "does not hold what was written");
+	return takes;
+}
+
 /* ---- end of the run: undo every write, in reverse ---- */
 
