-/* a private patch may answer which container a process is in (a strong definition wins) */
-__attribute__((weak)) int
-sweet_sandbox_container_path(__unused user_addr_t arg)
+/*
+ * kunzite 1003: answer op 4, the container-path lookup. Boot #62's dump showed
+ * it is called by everyone (cfprefsd alone 21,368 times in ten minutes,
+ * retrying on our ENOENT) with the struct { pid, 0 or pid-version, the caller's
+ * out-buffer, 0x400 } — sandbox_container_path_for_pid/_for_audit_token, both
+ * with buf at word 2 and its length at word 3. Nothing calls the setters, so
+ * there is no registry to consult: the answer is the target's home
+ * (/private/var/root for uid 0, /private/var/mobile for everyone else). A pid
+ * that no longer exists gets ESRCH; the old answer was ENOENT for everything.
+ */
+int
+sweet_sandbox_container_path(user_addr_t arg)
 {
-	return ENOENT;
+	uint64_t a[5];
+	char path[] = "/private/var/mobile";
+	kauth_cred_t cred;
+	proc_t target;
+	size_t length;
+	int error, pid;
+
+	error = copyin(arg, a, sizeof(a));
+	if (error != 0) {
+		return error;
+	}
+	pid = (int)a[0];
+	if (pid <= 0) {
+		pid = proc_pid(current_proc());
+	}
+	target = proc_find(pid);
+	if (target == PROC_NULL) {
+		return ESRCH;
+	}
+	cred = kauth_cred_proc_ref(target);
+	if (kauth_cred_getuid(cred) == 0) {
+		strlcpy(path, "/private/var/root", sizeof(path));
+	}
+	kauth_cred_unref(&cred);
+	proc_rele(target);
+	length = strlen(path) + 1;
+	if (a[3] < length) {
+		return ENAMETOOLONG;
+	}
+	return copyout(path, (user_addr_t)a[2], length);
 }
 
 static int
