+/*
+ * kunzite 1003: the fallback answer. Most processes here have no CFFIXED_USER_HOME —
+ * boot #62's dump showed op 4 called by everyone, answered ENOENT, and retried (cfprefsd
+ * alone 21,368 times in ten minutes). With the target's uid known, answer its home:
+ * /private/var/root for uid 0, /private/var/mobile otherwise — a valid, existing,
+ * absolute path, so callers stop retrying and stop reading missing paths.
+ */
+static int
+sandbox_container_home(uid_t uid, user_addr_t buffer, user_size_t size)
+{
+	const char *path = uid == 0 ? "/private/var/root" : "/private/var/mobile";
+	size_t length = strlen(path) + 1;
+
+	return size < length ? ENAMETOOLONG : copyout(path, buffer, length);
+}
