-/* the answers of glue plan 3.3 come with K4 */
+/*
+ * MSM_PARAM_*, as Linux's adreno_get_param answers them, with glue plan 3.3's values for
+ * the 710 here: chip id from the FDT, GMEM 512K at kgsl's 16M, hbb 14 (LPDDR4X), UBWC
+ * swizzle levels 2 and 3, macrotile 8 channels (RBBM_NC_MODE_CNTL 1, boot #48). VA_START
+ * and VA_SIZE are not answered: RedwoodGPU hands out the addresses (MSM_INFO_GET_IOVA).
+ */
 bool
-redwood_gpu_parameter(__unused uint32_t which, __unused uint64_t *value)
+redwood_gpu_parameter(uint32_t which, uint64_t *value)
 {
-	return false;
+	uint32_t hi, lo;
+
+	switch (which) {
+	case 0x01:                                      /* GPU_ID */
+		*value = 710;
+		return true;
+	case 0x02:                                      /* GMEM_SIZE */
+		*value = 0x80000;
+		return true;
+	case 0x03:                                      /* CHIP_ID: FDT qcom,chipid */
+		*value = 0x07010000;
+		return true;
+	case 0x04:                                      /* MAX_FREQ: the level held (perf 2) */
+		*value = 345000000;
+		return true;
+	case 0x05:                                      /* TIMESTAMP: the GMU's always-on counter, 19.2 MHz */
+		if (!kg.kept || kg.gmu == 0) {
+			return false;
+		}
+		do {
+			hi = kg_gmu(GEN7_GMU_ALWAYS_ON_COUNTER_H);
+			lo = kg_gmu(GEN7_GMU_ALWAYS_ON_COUNTER_L);
+		} while (hi != kg_gmu(GEN7_GMU_ALWAYS_ON_COUNTER_H));
+		*value = (uint64_t)hi << 32 | lo;
+		return true;
+	case 0x06:                                      /* GMEM_BASE: kgsl's uche_gmem_base */
+		*value = 0x1000000;
+		return true;
+	case 0x07:                                      /* PRIORITIES: one ring */
+		*value = 1;
+		return true;
+	case 0x08:                                      /* PP_PGTABLE */
+	case 0x09:                                      /* FAULTS */
+	case 0x0a:                                      /* SUSPENDS */
+	case 0x11:                                      /* RAYTRACING */
+		*value = 0;
+		return true;
+	case 0x10:                                      /* HIGHEST_BANK_BIT */
+		*value = 14;
+		return true;
+	case 0x12:                                      /* UBWC_SWIZZLE */
+		*value = 6;
+		return true;
+	case 0x13:                                      /* MACROTILE_MODE */
+		*value = 1;
+		return true;
+	default:
+		return false;
+	}
 }
 
