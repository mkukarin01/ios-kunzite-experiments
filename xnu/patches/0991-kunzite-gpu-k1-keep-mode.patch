+/* ---- keep mode (K1): the GPU held up after step 21 ---- */
+
+static unsigned
+kg_seconds_since(uint64_t began)
+{
+	uint64_t nanos;
+	absolutetime_to_nanoseconds(mach_absolute_time() - began, &nanos);
+	return (unsigned)(nanos / NSEC_PER_SEC);
+}
+
+/* the kept GPU's state; then what the GMU has put in its message and debug queues */
+static void
+kg_keep_report(unsigned s)
+{
+	uint32_t cb = (kg.smmu_pages + KG_GPU_CB) * kg.smmu_page;
+
+	printf("SWEET KGPU: kept %u s: gx gdsc %#x rpmh_power_state %#x gfx_pwr_clk_status %#x cx_busy %#x; "
+	    "rbbm_status %#x cp rptr/wptr %u/%u sqe_cntl %#x hw_fault %#x; cb0 fsr %#x; gmu2host_intr_info %#x, "
+	    "hfi message r/w %u/%u debug r/w %u/%u\n", s, kg_rd(kg.gpucc, KG_GX_GDSCR), kg_gmu(GEN7_GMU_RPMH_POWER_STATE),
+	    kg_gmu(GEN7_GMU_GFX_PWR_CLK_STATUS), kg_gmu(GEN7_GMU_AO_GPU_CX_BUSY_STATUS), kg_rd(kg.gpu, 4u * GEN7_RBBM_STATUS),
+	    kg_rd(kg.gpu, 4u * GEN7_CP_RB_RPTR), kg_rb_wptr, kg_rd(kg.gpu, 4u * GEN7_CP_SQE_CNTL),
+	    kg_rd(kg.gpu, 4u * GEN7_CP_HW_FAULT), kg_rd(kg.smmu, cb + SMMU_CB_FSR), kg_gmu(GEN7_GMU_GMU2HOST_INTR_INFO),
+	    kg_hfi->q[1].read_index, kg_hfi->q[1].write_index, kg_hfi->q[2].read_index, kg_hfi->q[2].write_index);
+	/* glue plan 3.3: the GMEM range gen7_start wrote (read 0 right after it on #41/#45/#47), hbb 14, macrotile */
+	printf("SWEET KGPU: kept %u s: uche_gmem_range min %#x:%08x max %#x:%08x; rbbm_nc_mode_cntl %#x; "
+	    "rb_nc_mode_cntl %#x tpl1 %#x sp %#x gras %#x uche_mode_cntl %#x\n", s,
+	    kg_rd(kg.gpu, 4u * 0x0e0c), kg_rd(kg.gpu, 4u * 0x0e0b), kg_rd(kg.gpu, 4u * 0x0e0e), kg_rd(kg.gpu, 4u * 0x0e0d),
+	    kg_rd(kg.gpu, 4u * 0x0534), kg_rd(kg.gpu, 4u * 0x8e08), kg_rd(kg.gpu, 4u * 0xb604),
+	    kg_rd(kg.gpu, 4u * 0xae02), kg_rd(kg.gpu, 4u * 0x8602), kg_rd(kg.gpu, 4u * 0x0e01));
+	kg_hfi_drain(1);
+	kg_hfi_drain(2);
+}
+
+/*
+ * Steps 1-21 done and nothing undone: hold the GPU until kgpu_keep_s runs out or the
+ * system shuts down, with a report every kgpu_keep_report seconds. Returns when it is
+ * to go; the caller undoes the run.
+ */
+static void
+kg_keep(void)
+{
+	uint64_t began = mach_absolute_time();
+	unsigned s = 0, said = 0;
+
+	kg_keep_report(0);
+	kg.kept = true;
+	if (kg.keep_s != 0) {
+		printf("SWEET KGPU: THE GPU IS KEPT: GX on (OOB_GPU held), HFI up, the CP running out of secure mode, "
+		    "idle; redwood_gpu_ready() true; for %u s (kgpu_keep_s), then undone\n", kg.keep_s);
+	} else {
+		printf("SWEET KGPU: THE GPU IS KEPT: GX on (OOB_GPU held), HFI up, the CP running out of secure mode, "
+		    "idle; redwood_gpu_ready() true; until the system shuts down\n");
+	}
+	for (;;) {
+		unsigned next = kg.report_s != 0 ? said + kg.report_s : ~0u;
+
+		if (kg.keep_s != 0 && kg.keep_s < next) {
+			next = kg.keep_s;
+		}
+		if (next != ~0u && next > s) {
+			kg_wait((next - s) * 1000u);
+		} else if (next == ~0u) {
+			kg_wait(3600u * 1000u);
+		}
+		s = kg_seconds_since(began);
+		if (kg.exit_asked || (kg.keep_s != 0 && s >= kg.keep_s)) {
+			break;
+		}
+		if (kg.report_s != 0 && s >= said + kg.report_s) {
+			kg_keep_report(s);
+			said = s;
+		}
+	}
+	kg.kept = false;
+	kg.hold_s = s;
+	printf("SWEET KGPU: the kept GPU goes after %u s: %s\n", s, kg.exit_asked ? kg.exit_why : "kgpu_keep_s ran out");
+	kg_keep_report(s);
+}
