+/*
+ * From reboot_kernel (bsd/kern/kern_shutdown.c), before processes are told to exit and
+ * not for a panic (the reset after one takes the GPU down with the SoC). A kept GPU, or
+ * a run still going, is taken down by its own thread, by the run's undo: the CP halted
+ * first, then the GMU's slumber (GX off), the GMU into reset, CX off. At most 5 s here.
+ */
+void
+kunzite_adreno_shutdown(int howto)
+{
+	unsigned ms;
+
+	if (!kg.running) {
+		return;
+	}
+	kg.exit_why = (howto & RB_HALT) ? "the system halts" : "the system restarts";
+	kg.exit_asked = true;
+	thread_wakeup(&kg_sleep_chan);
+	for (ms = 0; kg.running && ms < 5000; ms += 10) {
+		delay(10000);
+	}
+	printf("SWEET KGPU: shutdown: %s after %u ms\n", kg.running ? "the GPU still going down, carrying on" : "the GPU is down",
+	    ms);
+}
