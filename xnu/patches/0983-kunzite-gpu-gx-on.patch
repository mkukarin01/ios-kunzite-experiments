+/* ---- step 18: GX on (the port map's 17, its second half) ---- */
+
+#define GEN7_GMU_CX_GMU_POWER_COUNTER_ENABLE 0x1f840
+#define GEN7_GMU_RSCC_CONTROL_REQ        0x23b07
+#define GEN7_CP_CP2GMU_STATUS            0x812
+#define GEN7_CP_STATUS_1                 0x825
+#define GEN7_RBBM_STATUS                 0x210
+#define KG_GPU_REGS      0x4000u         /* RBBM/CP registers (GX side), read only while GX is on */
+#define KG_H2F_GX_BW_PERF_VOTE 30u
+#define KG_H2F_PREPARE_SLUMBER 33u
+#define KG_DCVS_ACK_BLOCK 1u
+#define KG_DCVS_NONE     0xffu           /* INVALID_DCVS_IDX */
+#define KG_BW_NO_AB      0xffff0000u     /* adreno_gmu_bus_ab_quantize without a GMU AB vote */
+#define KG_PERF_DEFAULT  2u              /* gpu_level_num 10 - qcom,initial-pwrlevel 7 - 1: 345 MHz */
+#define KG_BUS_DEFAULT   2u              /* pwrlevel 7's qcom,bus-freq-ddr7 */
+#define KG_OOB_GPU_SET   (1u << 30)      /* kgsl gen7_gmu_oob_set(oob_gpu): HOST2GMU_INTR_SET BIT(30 - 2 req) */
+#define KG_OOB_GPU_ACK   (1u << 31)      /* GMU2HOST_INTR_INFO BIT(31 - req) */
+#define KG_OOB_GPU_CLEAR (1u << 31)      /* gen7_gmu_oob_clear: BIT(31 - 2 req) */
+
+/* GEN7_RSCC_TCS0..9_DRV0_STATUS */
+static const uint32_t kg_rscc_tcs_status[10] = {
+	0x346, 0x3ee, 0x496, 0x53e, 0x5e6, 0x68e, 0x736, 0x7de, 0x886, 0x92e,
+};
+
+/* kgsl gen7_gmu_gx_is_on: GFX_PWR_CLK_STATUS bit 0 = GX GDSC off, bit 1 = GX clock off */
+static bool
+kg_gx_on(void)
+{
+	return (kg_gmu(GEN7_GMU_GFX_PWR_CLK_STATUS) & 3u) == 0;
+}
+
+static void
+kg_gx_state(const char *when)
+{
+	uint32_t s = kg_gmu(GEN7_GMU_GFX_PWR_CLK_STATUS);
+	printf("SWEET KGPU: %u gx %s: gfx_pwr_clk_status %#x (gdsc %s, clock %s), gx gdscr %#x, rpmh_power_state %#x, "
+	    "cx_busy %#x\n", kg.step, when, s, (s & 1u) ? "off" : "on", (s & 2u) ? "off" : "on",
+	    kg_rd(kg.gpucc, KG_GX_GDSCR), kg_gmu(GEN7_GMU_RPMH_POWER_STATE), kg_gmu(GEN7_GMU_AO_GPU_CX_BUSY_STATUS));
+}
+
+/*
+ * The undo of step 18, after the OOB clear: kgsl gen7_gmu_power_off. The
+ * lowest idle level (GPU_HW_ACTIVE: IFPC off), the RSC's TCSes done,
+ * H2F_MSG_PREPARE_SLUMBER (the GMU takes GX down and its votes to the
+ * slumber levels), the GPU idle, then gen7_rscc_sleep_sequence: the CM3
+ * into reset and the RSC handing the votes to the PDC. If GX still reads on,
+ * gen7_gmu_pwrctrl_suspend's last resort: its GDSC collapsed from here. The
+ * GBIF halt, the HFI alias, clocks and CX follow from the rest of the undo.
+ */
+static void
+kg_slumber(void)
+{
+	unsigned busy = 0;
+
+	printf("SWEET KGPU: undo slumber: rpmh_power_state %#x (lowest idle: 0, GPU_HW_ACTIVE)\n",
+	    kg_gmu(GEN7_GMU_RPMH_POWER_STATE));
+	for (unsigned i = 0; i < 10; i++) {
+		busy += !kg_poll(kg.rscc, 4u * kg_rscc_tcs_status[i], 1u, 1u, 2);
+	}
+	printf("SWEET KGPU: undo slumber: rscc tcs %u of 10 still busy after 2 ms each\n", busy);
+	kg_wr(kg.gmu, KG_GMU_OFF(GEN7_GMU_CX_GMU_POWER_COUNTER_ENABLE), 0);
+	if (kg_hfi != NULL) {
+		uint32_t req[3] = { KG_H2F_PREPARE_SLUMBER, KG_BW_NO_AB | KG_BUS_DEFAULT, KG_PERF_DEFAULT };
+		(void)kg_hfi_cmd("prepare slumber", req, 3);
+	}
+	kg_wr(kg.gmu, KG_GMU_OFF(GEN7_GMU_AO_AHB_FENCE_CTRL), 0);
+	kg_wr(kg.gmu, KG_GMU_OFF(GEN7_GMU_CX_FALNEXT_INTF), 1);
+	bool idle = kg_poll(kg.gmu, KG_GMU_OFF(GEN7_GMU_AO_GPU_CX_BUSY_STATUS), 1u << 30, 0, 100);
+	kg_gx_state("after prepare slumber");
+
+	kg_wr(kg.gmu, KG_GMU_OFF(GEN7_GMU_CM3_SYSRESET), 1);
+	uint32_t wptr = kg_gmu(GEN7_GMU_GENERAL_9);
+	kg_wr(kg.gmu, KG_GMU_OFF(GEN7_GMU_RSCC_CONTROL_REQ), 1);
+	bool slept = kg_poll(kg.rscc, 4u * GEN7_RSCC_RSC_STATUS0_DRV0, 1u << 16, 1u << 16, 100);
+	uint32_t status0 = kg_rd(kg.rscc, 4u * GEN7_RSCC_RSC_STATUS0_DRV0);
+	kg_wr(kg.gmu, KG_GMU_OFF(GEN7_GMU_RSCC_CONTROL_REQ), 0);
+	printf("SWEET KGPU: undo slumber: gpu %s; cm3 into reset (log wptr %u); rsc sleep %s (status0 %#x, "
+	    "control_ack %#x)\n", idle ? "idle" : "STILL BUSY", wptr, slept ? "done" : "NOT DONE", status0,
+	    kg_gmu(GEN7_GMU_RSCC_CONTROL_ACK));
+	kg_gx_state("after the rsc sleep");
+	if (kg_gx_on()) {
+		printf("SWEET KGPU: undo slumber: GX STILL ON: its GDSC collapsed from here\n");
+		kg_wr(kg.gpucc, KG_GX_GDSCR, kg_rd(kg.gpucc, KG_GX_GDSCR) | KG_GDSC_COLLAPSE);
+		(void)kg_poll(kg.gpucc, KG_GX_GDSCR, KG_GDSC_PWR_ON, 0, 100);
+		kg_gx_state("after the collapse");
+	}
+}
+
+/*
+ * kgsl after gen7_hfi_start: kgsl_pwrctrl_setup_default_votes (the default
+ * perf level, then the bus level, as H2F_MSG_GX_BW_PERF_VOTE), then
+ * gen7_gpu_boot's gen7_gmu_oob_set(oob_gpu): the GMU powers GX. GX
+ * registers are read only once GFX_PWR_CLK_STATUS says on. Undo, in this
+ * order: the OOB clear, then the slumber above.
+ */
+static bool
+kg_step18(void)
+{
+	if (!kg_hfi_talks || kg_hfi == NULL) {
+		printf("SWEET KGPU: 18 needs steps 1-17 (the GMU talking HFI in this run)\n");
+		return false;
+	}
+	kg_announce(18, "the GX state before the GMU is asked for it");
+	kg_gx_state("before");
+	if (kg_gx_on()) {
+		printf("SWEET KGPU: 18 GX is already on: not asking for it\n");
+		return false;
+	}
+	kg.gpu = kg_map("GPU", KG_GPU_PA, KG_GPU_REGS);
+	if (kg.gpu == 0) {
+		return false;
+	}
+
+	kg_next(18, "kgsl_pwrctrl_setup_default_votes: H2F_MSG_GX_BW_PERF_VOTE perf 2 (345 MHz), then bus 2 "
+	    "(DDR 2136718 KBps)");
+	uint32_t perf[4] = { KG_H2F_GX_BW_PERF_VOTE, KG_DCVS_ACK_BLOCK, KG_PERF_DEFAULT, KG_BW_NO_AB | KG_DCVS_NONE };
+	uint32_t bus[4] = { KG_H2F_GX_BW_PERF_VOTE, KG_DCVS_ACK_BLOCK, KG_DCVS_NONE, KG_BW_NO_AB | KG_BUS_DEFAULT };
+	if (!kg_hfi_cmd("default perf vote", perf, 4) || !kg_hfi_cmd("default bus vote", bus, 4)) {
+		return false;
+	}
+	kg_gx_state("after the votes");
+
+	kg_next(18, "OOB_GPU (kgsl gen7_gmu_oob_set: HOST2GMU_INTR_SET bit 30, then GMU2HOST_INTR_INFO bit 31 for up "
+	    "to 100 ms): THE GMU POWERS GX");
+	kg_undo_push(KG_UNDO_SLUMBER, kg.gmu, 0, 0, "slumber");
+	kg_undo_push(KG_UNDO_WORD, kg.gmu, KG_GMU_OFF(GEN7_GMU_HOST2GMU_INTR_SET), KG_OOB_GPU_CLEAR,
+	    "oob_gpu clear (host2gmu_intr_set bit 31)");
+	kg_wr(kg.gmu, KG_GMU_OFF(GEN7_GMU_HOST2GMU_INTR_SET), KG_OOB_GPU_SET);
+	bool acked = kg_poll(kg.gmu, KG_GMU_OFF(GEN7_GMU_GMU2HOST_INTR_INFO), KG_OOB_GPU_ACK, KG_OOB_GPU_ACK, 100);
+	uint32_t info = kg_gmu(GEN7_GMU_GMU2HOST_INTR_INFO);
+	kg_wr(kg.gmu, KG_GMU_OFF(GEN7_GMU_GMU2HOST_INTR_CLR), KG_OOB_GPU_ACK);
+	printf("SWEET KGPU: 18 oob_gpu %s: gmu2host_intr_info %#x fw_init_result %#x\n", acked ? "acked" :
+	    "NOT ACKED in 100 ms", info, kg_gmu(GEN7_GMU_CM3_FW_INIT_RESULT));
+	kg_hfi_drain(1);
+	kg_hfi_drain(2);
+	kg_gx_state("after oob_gpu");
+
+	bool gx = kg_gx_on();
+	if (gx) {
+		kg_announce(18, "GX registers (GX is on): RBBM_STATUS, CP_STATUS_1, CP2GMU_STATUS");
+		printf("SWEET KGPU: 18 rbbm_status %#x cp_status_1 %#x cp2gmu_status %#x\n",
+		    kg_rd(kg.gpu, 4u * GEN7_RBBM_STATUS), kg_rd(kg.gpu, 4u * GEN7_CP_STATUS_1),
+		    kg_rd(kg.gpu, 4u * GEN7_CP_CP2GMU_STATUS));
+	}
+	uint32_t cb = (kg.smmu_pages + KG_GMU_CB) * kg.smmu_page;
