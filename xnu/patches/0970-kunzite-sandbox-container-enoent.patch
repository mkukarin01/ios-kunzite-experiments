kunzite: sandbox op 4 (container path, topaz 0936) answers ENOENT whenever it has no path.
0936 returned 0 without writing the buffer for a process without CFFIXED_USER_HOME (and on
its early exits); syncdefaultsd and webbookmarksd then read their uninitialised buffer as a path
and +[NSURL fileURLWithPath:] threw (abort loop, boot #25). ENOENT is what op 4 answered before
0936 (0149's weak default).

diff --git a/bsd/kern/topaz_sandbox_container.c b/bsd/kern/topaz_sandbox_container.c
--- a/bsd/kern/topaz_sandbox_container.c
+++ b/bsd/kern/topaz_sandbox_container.c
@@ -59,7 +59,7 @@ sweet_sandbox_container_path(user_addr_t arg)
 	task = proc_task(p);
 	if (user_stack == 0 || argslen == 0 || task == TASK_NULL) {
 		proc_rele(p);
-		return 0;
+		return ENOENT;
 	}
 	/* the same way as sysctl_procargsx(): the task keeps the map alive once the process is let go */
 	task_reference(task);
@@ -67,7 +67,7 @@ sweet_sandbox_container_path(user_addr_t arg)
 	map = get_task_map_reference(task);
 	task_deallocate(task);
 	if (map == VM_MAP_NULL) {
-		return 0;
+		return ENOENT;
 	}
 	strings_size = vm_map_round_page(argslen, vm_map_page_mask(map));
 	if (kmem_alloc(kernel_map, &strings, strings_size, KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_BSD) != KERN_SUCCESS) {
@@ -83,9 +83,15 @@ sweet_sandbox_container_path(user_addr_t arg)
 			vm_map_copy_discard(copy);
 		}
 		kmem_free(kernel_map, strings, strings_size);
-		return 0;                       /* the process is on its way out, or has unmapped its own stack */
+		return ENOENT;                  /* the process is on its way out, or has unmapped its own stack */
 	}
 
+	/*
+	 * kunzite: no CFFIXED_USER_HOME is ENOENT, as op 4 answered before 0936. Success without
+	 * a path made callers read their own uninitialised buffer as one (syncdefaultsd,
+	 * webbookmarksd: +[NSURL fileURLWithPath:] threw, boot #25).
+	 */
+	error = ENOENT;
 	end = (const char *)(strings + strings_size);
 	for (s = end - argslen; s < end; s += len + 1) {
 		len = strnlen(s, end - s);
