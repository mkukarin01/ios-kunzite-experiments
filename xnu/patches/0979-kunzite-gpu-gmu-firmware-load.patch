+/*
+ * The GMU's page tables: 3 levels of 4K tables, 39-bit addresses, table 0 the
+ * root. All of them come from a pool made in step 13, before the context is
+ * on, so no table is allocated (or freed) while the SMMU may walk them; the
+ * pool's pages are freed at the end, after stream 5 is unrouted.
+ */
+#define KG_SPACE_TABLES  8u
+static struct {
+	uint64_t *table[KG_SPACE_TABLES];
+	uint64_t phys[KG_SPACE_TABLES];
+	vm_offset_t page[KG_SPACE_TABLES];
+	unsigned npages, ntables, used;
+} kg_space;
+
+static bool
+kg_space_pool(void)
+{
+	unsigned per_page = (unsigned)(PAGE_SIZE / 0x1000);
+
+	while (kg_space.ntables < KG_SPACE_TABLES) {
+		vm_offset_t page = 0;
+		if (kmem_alloc(kernel_map, &page, PAGE_SIZE, KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_BSD) != KERN_SUCCESS) {
+			return false;
+		}
+		kg_undo_push(KG_UNDO_KFREE, page, 0, (uint32_t)PAGE_SIZE, "gmu page tables");
+		kg_space.page[kg_space.npages++] = page;
+		for (unsigned i = 0; i < per_page && kg_space.ntables < KG_SPACE_TABLES; i++) {
+			kg_space.table[kg_space.ntables] = (uint64_t *)(page + 0x1000u * i);
+			kg_space.phys[kg_space.ntables] = kvtophys(page + 0x1000u * i);
+			kg_space.ntables++;
+		}
+	}
+	kg_space.used = 1;              /* table 0 is the root */
+	return true;
+}
+
+/* the table an entry leads to, made (from the pool) if the entry is empty */
+static uint64_t *
+kg_space_next(uint64_t *entry)
+{
+	if (*entry & 1u) {
+		for (unsigned i = 0; i < kg_space.used; i++) {
+			if (kg_space.phys[i] == (*entry & 0x0000fffffffff000ull)) {
+				return kg_space.table[i];
+			}
+		}
+		return NULL;
+	}
+	if (kg_space.used == kg_space.ntables) {
+		return NULL;
+	}
+	*entry = kg_space.phys[kg_space.used] | PTE_TABLE;
+	return kg_space.table[kg_space.used++];
+}
+
+/* one 4K page of the GMU's address space */
+static bool
+kg_space_map(uint64_t va, uint64_t pa, uint64_t attrs)
+{
+	uint64_t *l2 = (va >> 39) ? NULL : kg_space_next(&kg_space.table[0][(va >> 30) & 0x1ffu]);
+	uint64_t *l3 = l2 != NULL ? kg_space_next(&l2[(va >> 21) & 0x1ffu]) : NULL;
+
+	if (l3 == NULL) {
+		printf("SWEET KGPU: %u no page table for GMU %#llx (pool of %u used up?)\n", kg.step, va, kg_space.ntables);
+		return false;
+	}
+	l3[(va >> 12) & 0x1ffu] = pa | attrs | PTE_PAGE;
+	return true;
+}
+
+static void
+kg_space_commit(void)
+{
+	for (unsigned i = 0; i < kg_space.npages; i++) {
+		kg_to_memory(kg_space.page[i], PAGE_SIZE);
+	}
+}
