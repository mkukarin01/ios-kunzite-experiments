+/* ---- step 14: the GMU's firmware ---- */
+
+#define KG_GMU_FW        "/usr/share/firmware/kunzite/gmu_gen70000.bin"
+#define KG_GMU_ITCM_VA   0x00000000u     /* kgsl gen7_gmu_vma: ITCM 16K at 0 */
+#define KG_GMU_DTCM_VA   0x10004000u     /* DTCM 16K at 256M + 16K */
+#define KG_GMU_TCM_SIZE  0x4000u
+#define KG_GMU_FW_MIN    0x40000000u     /* gen7_3_0 gmu_fw_version: GMU_VERSION(4, 0, 0) */
+#define KG_GMU_BLOCKS    8u
+#define KG_BLK_PREALLOC  1u              /* GMU_BLK_TYPE_PREALLOC_REQ */
+#define KG_BLK_PERSIST   7u              /* GMU_BLK_TYPE_PREALLOC_PERSIST_REQ */
+
+/* memory of ours the GMU sees, one per block the firmware asks for */
+static struct {
+	uint32_t addr, size;
+	vm_offset_t mem;
+} kg_gmu_mem[KG_GMU_BLOCKS];
+static unsigned kg_gmu_nmem;
+
+/* [a, a + s) inside [base, base + len) */
+static bool
+kg_inside(uint32_t a, uint32_t s, uint32_t base, uint32_t len)
+{
+	return a >= base && s <= len && a - base <= len - s;
+}
+
+/* a block the firmware asks for (kgsl gen7_gmu_process_prealloc): zeroed memory of ours at its GMU address */
+static bool
+kg_gmu_alloc(uint32_t addr, uint32_t len)
+{
+	vm_offset_t mem = 0;
+	uint32_t size = (len + 0xfffu) & ~0xfffu;
+	vm_size_t alloc = ((vm_size_t)size + PAGE_SIZE - 1) & ~((vm_size_t)PAGE_SIZE - 1);
+
+	if ((addr & 0xfffu) || len == 0 || kg_gmu_nmem == KG_GMU_BLOCKS) {
+		printf("SWEET KGPU: 14 cannot place GMU %#x+%#x\n", addr, len);
+		return false;
+	}
+	if (kmem_alloc(kernel_map, &mem, alloc, KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_BSD) != KERN_SUCCESS) {
+		printf("SWEET KGPU: 14 no memory for GMU %#x+%#x\n", addr, len);
+		return false;
+	}
+	kg_undo_push(KG_UNDO_KFREE, mem, 0, (uint32_t)alloc, "gmu firmware memory");
+	for (uint32_t o = 0; o < size; o += 0x1000u) {
+		if (!kg_space_map(addr + o, kvtophys(mem + o), PTE_GMU)) {
+			return false;
+		}
+	}
+	kg_gmu_mem[kg_gmu_nmem].addr = addr;
+	kg_gmu_mem[kg_gmu_nmem].size = size;
+	kg_gmu_mem[kg_gmu_nmem].mem = mem;
+	kg_gmu_nmem++;
+	printf("SWEET KGPU: 14 GMU %#x..%#x -> memory %#llx (%u pages)\n", addr, addr + size, kvtophys(mem), size >> 12);
 	return true;
 }
 
+/* a block for a TCM, through the GMU's registers (kgsl load_tcm), read back word by word */
+static bool
+kg_load_tcm(const char *name, uint32_t reg_start, uint32_t base, uint32_t addr, const uint8_t *src, uint32_t size)
+{
+	uint32_t first = reg_start + (addr - base) / 4u, words = size / 4u, bad = 0, w;
+
+	printf("SWEET KGPU: 14 write GMU %s %#x..%#x: %u words from register %#x\n", name, addr, addr + size, words, first);
+	for (uint32_t i = 0; i < words; i++) {
+		memcpy(&w, src + 4u * i, 4);
+		kg_wr(kg.gmu, KG_GMU_OFF(first + i), w);
+	}
+	for (uint32_t i = 0; i < words; i++) {
+		memcpy(&w, src + 4u * i, 4);
+		bad += kg_gmu(first + i) != w;
+	}
+	printf("SWEET KGPU: 14   read back: %u of %u words differ\n", bad, words);
+	return bad == 0;
+}
+
+/*
+ * kgsl gen7_gmu_parse_fw + gen7_gmu_load_fw + gen7_gmu_version_info. The
+ * file is a chain of blocks {addr, size, type, value} + size bytes: size 0
+ * blocks are requests (PREALLOC / PERSIST: value bytes at addr), the others
+ * data for ITCM/DTCM (written through registers while the CM3 is held in
+ * reset) or for memory the requests made. The TCMs are not restored at the
+ * end (SRAM; the CM3 stays in reset and CX collapses); the memory is freed.
+ */
+static bool
+kg_step14(void)
+{
+	struct { uint32_t addr, size, type, value; } b;
+	void *data = NULL;
+	size_t size = 0, off;
+	unsigned blocks = 0, loads = 0;
+	bool ok = false;
+
+	if (!kg_cx_ready(14) || kg.gmu == 0 || kg_space.ntables == 0) {
+		printf("SWEET KGPU: 14 needs steps 4-13\n");
+		return false;
+	}
+	kg_announce(14, "the GMU's reset state, then " KG_GMU_FW);
+	uint32_t sysreset = kg_gmu(GEN7_GMU_CM3_SYSRESET), init = kg_gmu(GEN7_GMU_CM3_FW_INIT_RESULT);
+	printf("SWEET KGPU: 14 cm3 sysreset %#x fw_init_result %#x\n", sysreset, init);
+	if (!(sysreset & 1u) || (init & (1u << 8))) {
+		printf("SWEET KGPU: 14 the GMU's processor is running (or has run firmware): not loading\n");
+		return false;
+	}
+	if (!topaz_root_mounted()) {
+		printf("SWEET KGPU: 14 the root filesystem is not mounted yet: raise kgpu_delay\n");
+		return false;
+	}
+	int err = topaz_fw_read(KG_GMU_FW, &data, &size);
+	if (err != 0) {
+		printf("SWEET KGPU: 14 cannot read " KG_GMU_FW " (error %d): upload the phone's "
+		    "/vendor/firmware/gmu_gen70000.bin there\n", err);
+		return false;
+	}
+	const uint8_t *fw = data;
+
+	/* pass 1: the chain, and the memory it asks for, through context 1 */
+	for (off = 0; off + 16 <= size; off += 16 + b.size) {
+		memcpy(&b, fw + off, 16);
+		if (b.size > size - off - 16 || (b.size & 3u)) {
+			printf("SWEET KGPU: 14 block %u at %#lx: size %#x does not fit the file\n", blocks, (unsigned long)off, b.size);
+			goto out;
+		}
+		blocks++;
+		if (b.size != 0) {
+			loads++;
+		} else if (b.type == KG_BLK_PREALLOC || b.type == KG_BLK_PERSIST) {
+			bool tcm = kg_inside(b.addr, b.value, KG_GMU_ITCM_VA, KG_GMU_TCM_SIZE) ||
+			    kg_inside(b.addr, b.value, KG_GMU_DTCM_VA, KG_GMU_TCM_SIZE);
+			if (!tcm && !kg_gmu_alloc(b.addr, b.value)) {
+				goto out;
+			}
+		}
+	}
+	if (off != size) {
+		printf("SWEET KGPU: 14 %lu bytes after the last block\n", (unsigned long)(size - off));
+		goto out;
+	}
+	printf("SWEET KGPU: 14 %s: %lu bytes, %u blocks, %u to load, %u memory blocks mapped\n", KG_GMU_FW,
+	    (unsigned long)size, blocks, loads, kg_gmu_nmem);
+	kg_space_commit();
+	uint32_t cb = (kg.smmu_pages + KG_GMU_CB) * kg.smmu_page;
+	printf("SWEET KGPU: 14 command tlbiasid <- %u, tlbsync <- 1 (new mappings in context 1)\n", KG_GMU_CB);
+	kg_wr(kg.smmu, cb + SMMU_CB_TLBIASID, KG_GMU_CB);
+	kg_wr(kg.smmu, cb + SMMU_CB_TLBSYNC, 1);
+	if (!kg_poll(kg.smmu, cb + SMMU_CB_TLBSTATUS, 1u, 0, 100)) {
+		printf("SWEET KGPU: 14 TLB sync does not finish\n");
+		goto out;
+	}
+
+	/* pass 2: the data */
+	kg_next(14, "the firmware's data into ITCM/DTCM (registers) and into its memory");
+	for (off = 0; off + 16 <= size; off += 16 + b.size) {
+		memcpy(&b, fw + off, 16);
+		if (b.size == 0) {
+			continue;
+		}
+		const uint8_t *src = fw + off + 16;
+		if (kg_inside(b.addr, b.size, KG_GMU_ITCM_VA, KG_GMU_TCM_SIZE)) {
+			if (!kg_load_tcm("itcm", GEN7_GMU_CM3_ITCM_START, KG_GMU_ITCM_VA, b.addr, src, b.size)) {
+				goto out;
+			}
+		} else if (kg_inside(b.addr, b.size, KG_GMU_DTCM_VA, KG_GMU_TCM_SIZE)) {
+			if (!kg_load_tcm("dtcm", GEN7_GMU_CM3_DTCM_START, KG_GMU_DTCM_VA, b.addr, src, b.size)) {
+				goto out;
+			}
+		} else {
+			unsigned m;
+			for (m = 0; m < kg_gmu_nmem && !kg_inside(b.addr, b.size, kg_gmu_mem[m].addr, kg_gmu_mem[m].size); m++) {
+			}
+			if (m == kg_gmu_nmem) {
+				printf("SWEET KGPU: 14 no memory for the block GMU %#x+%#x\n", b.addr, b.size);
+				goto out;
+			}
+			vm_offset_t dst = kg_gmu_mem[m].mem + (b.addr - kg_gmu_mem[m].addr);
+			memcpy((void *)dst, src, b.size);
+			kg_to_memory(dst, b.size);
+			printf("SWEET KGPU: 14 copied %#x bytes to GMU %#x (memory %#llx), first word %#x\n", b.size, b.addr,
+			    kvtophys(dst), *(const uint32_t *)dst);
+		}
+	}
+
+	/* kgsl gen7_gmu_version_info: five words at a fixed place in DTCM */
+	uint32_t core = kg_gmu(GEN7_GMU_CM3_DTCM_START + 0xff8);
+	printf("SWEET KGPU: 14 versions core %#x core_dev %#x pwr %#x pwr_dev %#x hfi %#x (kgsl wants core >= %#x)\n", core,
+	    kg_gmu(GEN7_GMU_CM3_DTCM_START + 0xff9), kg_gmu(GEN7_GMU_CM3_DTCM_START + 0xffa),
+	    kg_gmu(GEN7_GMU_CM3_DTCM_START + 0xffb), kg_gmu(GEN7_GMU_CM3_DTCM_START + 0xffc), KG_GMU_FW_MIN);
+	ok = core >= KG_GMU_FW_MIN;
+	printf("SWEET KGPU: 14 %s\n", ok ? "THE GMU FIRMWARE IS LOADED (the CM3 stays in reset)" : "version check FAILED");
+out:
+	topaz_fw_free(data, size);
+	return ok;
+}
