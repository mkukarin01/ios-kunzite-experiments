+/*
+ * kgsl gen7_gmu_first_boot after load_fw: gen7_gmu_register_config (with
+ * gen7_gmu_power_config), then gen7_gmu_device_start. Skipped: the TZ CX
+ * regs call and the AOP ACD message (optional, ACD off), interrupts (we poll),
+ * the bus vote (DDR is up for the CPU), VRB (optional). The configuration is
+ * kept; the undo puts the processor back into reset before anything is freed.
+ */
+static bool
+kg_step15(void)
+{
+	static const uint8_t prio[3] = { 10, 10, 40 };  /* HFI_CMD_PRI, HFI_MSG_PRI, HFI_DBG_PRI */
+
+	if (!kg_cx_ready(15) || !kg_gmu_loaded || kg.gbif == 0) {
+		printf("SWEET KGPU: 15 needs steps 4-14 (GMU firmware loaded in this run)\n");
+		return false;
+	}
+	kg_announce(15, "the GMU's reset state");
+	if (!(kg_gmu(GEN7_GMU_CM3_SYSRESET) & 1u)) {
+		printf("SWEET KGPU: 15 the GMU's processor is not held in reset: not configuring it while it runs\n");
+		return false;
+	}
+
+	/* the log and the HFI queues, where kgsl's allocator would put them */
+	if (!kg_gmu_alloc(KG_GMU_LOG_VA, KG_GMU_LOG_SIZE) || !kg_gmu_alloc(KG_GMU_HFI_VA, KG_GMU_HFI_SIZE)) {
+		return false;
+	}
+	struct kg_hfi_table *t = (struct kg_hfi_table *)kg_gmu_host(KG_GMU_HFI_VA);
+	t->version = 0;
+	t->size = sizeof(*t) / 4;
+	t->qhdr0_offset = 6;
+	t->qhdr_size = sizeof(struct kg_hfi_queue) / 4;
+	t->num_q = t->num_active_q = 3;
+	for (uint32_t i = 0; i < 3; i++) {
+		t->q[i].status = 1;
+		t->q[i].start_addr = KG_GMU_HFI_VA + ((sizeof(*t) + 15u) & ~15u) + 0x1000u * i;
+		t->q[i].type = i | (uint32_t)prio[i] << 8;
+		t->q[i].queue_size = 0x1000u / 4;
+	}
+	/* all of it to memory: KMA_ZERO's zeroes still in this processor's cache would land on what the GMU writes */
+	for (unsigned m = 0; m < kg_gmu_nmem; m++) {
+		kg_to_memory(kg_gmu_mem[m].mem, kg_gmu_mem[m].size);
+	}
