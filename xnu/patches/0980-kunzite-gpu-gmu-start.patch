+/* kgsl adreno_hfi.h: the queue table at the head of the HFI memory, 17 queue headers of 12 words */
+struct kg_hfi_queue {
+	uint32_t status, start_addr, type, queue_size, msg_size, unused[5], read_index, write_index;
+};
+struct kg_hfi_table {
+	uint32_t version, size, qhdr0_offset, qhdr_size, num_q, num_active_q;
+	struct kg_hfi_queue q[17];
+};
+_Static_assert(sizeof(struct kg_hfi_table) == 840, "kgsl struct hfi_queue_table: 210 words");
+
+/* the memory of ours behind a GMU address (steps 14-15), or 0 */
+static vm_offset_t
+kg_gmu_host(uint32_t addr)
+{
+	for (unsigned m = 0; m < kg_gmu_nmem; m++) {
+		if (kg_inside(addr, 1, kg_gmu_mem[m].addr, kg_gmu_mem[m].size)) {
+			return kg_gmu_mem[m].mem + (addr - kg_gmu_mem[m].addr);
+		}
+	}
+	return 0;
+}
