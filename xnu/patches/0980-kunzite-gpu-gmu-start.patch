+	printf("SWEET KGPU: 15 hfi table at GMU %#x (%lu bytes, queues at %#x/%#x/%#x), log at GMU %#x; tlbiasid, tlbsync\n",
+	    KG_GMU_HFI_VA, (unsigned long)sizeof(*t), t->q[0].start_addr, t->q[1].start_addr, t->q[2].start_addr,
+	    KG_GMU_LOG_VA);
+	kg_wr(kg.smmu, cb + SMMU_CB_TLBIASID, KG_GMU_CB);
+	kg_wr(kg.smmu, cb + SMMU_CB_TLBSYNC, 1);
+	if (!kg_poll(kg.smmu, cb + SMMU_CB_TLBSTATUS, 1u, 0, 100)) {
+		printf("SWEET KGPU: 15 TLB sync does not finish\n");
+		return false;
+	}
+
+	kg_next(15, "the GMU's configuration (kgsl gen7_gmu_register_config, gen7_gmu_power_config)");
+	kg_set("GMU", kg.gmu, KG_GMU_OFF(GEN7_GMU_CX_FALNEXT_INTF), 1, "cx_falnext_intf");
