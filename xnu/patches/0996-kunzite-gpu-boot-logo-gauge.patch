 void RedwoodGPUStop(void);
+/*
+ * The boot logo as a gauge (keep mode). The window server now starts only once the GPU is kept
+ * (userland/gpu/bbd_wrap.c waits for RedwoodGPU), and meanwhile the boot logo stays on the
+ * panel. So the logo fills with amber from the bottom up as the steps are done, and it turns
+ * green once RedwoodGPU is published, or red if the run ends short. Its pixels are found once
+ * (whatever is not black in the middle of the panel) and kept; each picture is drawn from those,
+ * a pixel's brightness times the colour. Nothing is drawn once the window server has presented
+ * a frame (sweet_fb_presented, SweetFramebuffer.cpp): the panel is iOS's from then on.
+ */
+#define KG_LOGO_X0       140u            /* the part of the panel searched for the logo */
+#define KG_LOGO_X1       940u
+#define KG_LOGO_Y0       400u
+#define KG_LOGO_Y1       2000u
+#define KG_LOGO_DARK     0x30u           /* a pixel with no channel above this is background */
+#define KG_LOGO_AMBER    0xffffb000u     /* panel pixels are 0xAARRGGBB (BGRA in memory) */
+#define KG_LOGO_GREEN    0xff34c759u
+#define KG_LOGO_RED      0xffff3b30u
+
+extern volatile int sweet_fb_presented;  /* iokit/Kernel/arm/SweetFramebuffer.cpp: set by the first frame */
+
+static struct {
+	vm_offset_t panel;              /* the panel memory, write-combined; 0: no gauge */
+	vm_offset_t orig;               /* the logo's pixels as found, w x h */
+	vm_size_t orig_size;
+	uint32_t x0, y0, w, h;
+} kg_logo;
+
+static uint32_t
+kg_logo_tint(uint32_t pixel, uint32_t colour)
+{
+	uint32_t r = (pixel >> 16) & 0xffu, g = (pixel >> 8) & 0xffu, b = pixel & 0xffu;
+	uint32_t l = r > g ? (r > b ? r : b) : (g > b ? g : b);
+
+	return 0xff000000u | ((((colour >> 16) & 0xffu) * l / 255u) << 16) | ((((colour >> 8) & 0xffu) * l / 255u) << 8) |
+	       ((colour & 0xffu) * l / 255u);
+}
+
+static void
+kg_logo_release(void)
+{
+	if (kg_logo.panel != 0) {
+		ml_io_unmap(kg_logo.panel, KG_PANEL_MAP);
+		kg_logo.panel = 0;
+	}
+	if (kg_logo.orig != 0) {
+		kmem_free(kernel_map, kg_logo.orig, kg_logo.orig_size);
+		kg_logo.orig = 0;
+	}
+}
+
+/* the logo's box and pixels, once, at the start of a kept run */
+static void
+kg_logo_find(void)
+{
+	uint32_t x0 = ~0u, y0 = ~0u, x1 = 0, y1 = 0;
+
+	if (sweet_fb_presented) {
+		printf("SWEET KGPU: logo gauge: none, the window server already shows its frames\n");
+		return;
+	}
+	kg_logo.panel = ml_io_map_unmappable(KG_PANEL_PA, KG_PANEL_MAP, VM_WIMG_WCOMB);
+	if (kg_logo.panel == 0) {
+		printf("SWEET KGPU: logo gauge: none, no mapping of the panel memory\n");
+		return;
+	}
+	for (uint32_t y = KG_LOGO_Y0; y < KG_LOGO_Y1; y++) {
+		const volatile uint32_t *row = (const volatile uint32_t *)(kg_logo.panel + (vm_offset_t)y * KG_PANEL_ROW);
+
+		for (uint32_t x = KG_LOGO_X0; x < KG_LOGO_X1; x++) {
+			uint32_t p = row[x];
+
+			if (((p >> 16) & 0xffu) > KG_LOGO_DARK || ((p >> 8) & 0xffu) > KG_LOGO_DARK || (p & 0xffu) > KG_LOGO_DARK) {
+				x0 = x < x0 ? x : x0;
+				x1 = x > x1 ? x : x1;
+				y0 = y < y0 ? y : y0;
+				y1 = y > y1 ? y : y1;
+			}
+		}
+	}
+	if (x0 == ~0u) {
+		printf("SWEET KGPU: logo gauge: none, nothing but black in the middle of the panel\n");
+		kg_logo_release();
+		return;
+	}
+	kg_logo.x0 = x0;
+	kg_logo.y0 = y0;
+	kg_logo.w = x1 - x0 + 1;
+	kg_logo.h = y1 - y0 + 1;
+	kg_logo.orig_size = round_page((vm_size_t)kg_logo.w * kg_logo.h * 4u);
+	if (kmem_alloc(kernel_map, &kg_logo.orig, kg_logo.orig_size, KMA_DATA, VM_KERN_MEMORY_BSD) != KERN_SUCCESS) {
+		kg_logo.orig = 0;
+		printf("SWEET KGPU: logo gauge: none, no memory for the logo's %u x %u pixels\n", kg_logo.w, kg_logo.h);
+		kg_logo_release();
+		return;
+	}
+	for (uint32_t y = 0; y < kg_logo.h; y++) {
+		const volatile uint32_t *row = (const volatile uint32_t *)(kg_logo.panel + (vm_offset_t)(kg_logo.y0 + y) * KG_PANEL_ROW);
+		uint32_t *keep = (uint32_t *)(kg_logo.orig + (vm_offset_t)y * kg_logo.w * 4u);
+
+		for (uint32_t x = 0; x < kg_logo.w; x++) {
+			keep[x] = row[kg_logo.x0 + x];
+		}
+	}
+	printf("SWEET KGPU: logo gauge: the logo at %u,%u, %u x %u: amber per step, green when RedwoodGPU is published, red "
+	    "if the run ends short\n", kg_logo.x0, kg_logo.y0, kg_logo.w, kg_logo.h);
+}
+
+/* the logo's bottom `rows` rows in the colour, the rest as found; false once the panel is iOS's */
+static bool
+kg_logo_draw(uint32_t colour, uint32_t rows)
+{
+	if (kg_logo.panel == 0) {
+		return false;
+	}
+	if (sweet_fb_presented) {
+		kg_logo_release();
+		return false;
+	}
+	for (uint32_t y = 0; y < kg_logo.h; y++) {
+		volatile uint32_t *row = (volatile uint32_t *)(kg_logo.panel + (vm_offset_t)(kg_logo.y0 + y) * KG_PANEL_ROW);
+		const uint32_t *keep = (const uint32_t *)(kg_logo.orig + (vm_offset_t)y * kg_logo.w * 4u);
+		bool tinted = y >= kg_logo.h - rows;
+
+		for (uint32_t x = 0; x < kg_logo.w; x++) {
+			row[kg_logo.x0 + x] = tinted ? kg_logo_tint(keep[x], colour) : keep[x];
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return true;
+}
+
+static void
+kg_logo_progress(unsigned done, unsigned total)
+{
+	if (kg_logo.panel != 0 && total != 0) {
+		(void)kg_logo_draw(KG_LOGO_AMBER, (uint32_t)((uint64_t)kg_logo.h * done / total));
+	}
+}
+
+/* the whole logo in its last colour, which stays until the window server's first frame */
+static void
+kg_logo_end(uint32_t colour)
+{
+	if (kg_logo_draw(colour, kg_logo.h)) {
+		printf("SWEET KGPU: logo gauge: %s\n", colour == KG_LOGO_GREEN ? "green, the GPU is ready" : "red, the run ended short");
+	}
+	kg_logo_release();
+}
+
 static bool kg_redwood;                 /* RedwoodGPUStart() was called */
 
