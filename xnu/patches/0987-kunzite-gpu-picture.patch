+/* ---- step 22: a picture drawn by the GPU, on the panel (the port map's 22) ---- */
+
+/*
+ * hk's step 22 on redwood, for a7xx: the 2D engine fills a rectangle with one
+ * colour three times (Mesa fd6_blitter.cc fd6_clear_surface / emit_blit_setup
+ * / emit_blit_fini with CHIP = A7XX; register numbers and fields from Linux's
+ * registers/adreno/a6xx.xml), into memory of ours; we copy it to the panel.
+ * a7xx moves SP_A2D_OUTPUT_INFO (0xacc0 -> 0xa9bf), adds TPL1_A2D_BLT_CNTL,
+ * keeps the CCU's sysmem placement in RB_CCU_CACHE_CNTL, and takes its events
+ * as CP_EVENT_WRITE7. The panel memory (0xb8000000, 1080x2400, 4320-byte rows:
+ * not a multiple of 64, which the 2D engine's pitch must be) is what the
+ * display controller scans out; iOS's presenter writes there too.
+ */
+#define KG_PIC_W         1080u
+#define KG_PIC_H         2400u
+#define KG_PIC_ROW       4352u           /* 1088 pixels: the next multiple of 64 bytes */
+#define KG_GPU_PIC_VA    (KG_GPU_VA + 0x200000u)
+#define KG_PANEL_PA      0xb8000000u     /* the ABL splash framebuffer AppleCLCD presents into */
+#define KG_PANEL_ROW     4320u
+#define KG_SHOW_S        15u             /* the picture copied to the panel again every 250 ms for this long */
+#define KG_A2D_SOLID_8888 (1u << 7 | 0x30u << 8 | 0xfu << 20)  /* solid, FMT6_8_8_8_8_UNORM, mask 0xf, R2D_UNORM8 */
+#define KG_GPU_MARK      0x6b677022u     /* written after the picture, as step 21's word */
+
+static uint32_t kg_cs[256];
+static unsigned kg_cs_n;
+
+/* pm4_calc_odd_parity_bit, cp_type7_packet, cp_type4_packet (adreno_pm4types.h) */
+static uint32_t
+kg_parity(uint32_t v)
+{
+	return (0x9669u >> (0xfu & (v ^ v >> 4 ^ v >> 8 ^ v >> 12 ^ v >> 16 ^ v >> 20 ^ v >> 24 ^ v >> 28))) & 1u;
+}
+
+static void
+kg_cs_pkt7(uint32_t op, uint32_t cnt)
+{
+	kg_cs[kg_cs_n++] = 7u << 28 | cnt | kg_parity(cnt) << 15 | (op & 0x7fu) << 16 | kg_parity(op) << 23;
+}
+
+static void
+kg_cs_word(uint32_t w)
+{
+	kg_cs[kg_cs_n++] = w;
+}
+
+static void
+kg_cs_reg(uint32_t reg, uint32_t val)
+{
+	kg_cs[kg_cs_n++] = 4u << 28 | 1u | kg_parity(1) << 7 | (reg & 0x3ffffu) << 8 | kg_parity(reg) << 27;
+	kg_cs[kg_cs_n++] = val;
+}
+
+/* one band: fd6_clear_surface's registers for a linear 8888 target, then emit_blit_fini */
+static void
+kg_cs_fill(uint32_t top, uint32_t bottom, uint32_t r, uint32_t g, uint32_t b)
+{
+	kg_cs_reg(0x8c00, KG_A2D_SOLID_8888);           /* RB_A2D_BLT_CNTL */
+	kg_cs_reg(0x8400, KG_A2D_SOLID_8888);           /* GRAS_A2D_BLT_CNTL */
+	kg_cs_reg(0xb2d2, 1u << 29);                    /* TPL1_A2D_BLT_CNTL (a7xx): type A6XX_TEX_2D */
+	kg_cs_reg(0xa9bf, 0x30u << 3 | 0xfu << 12);     /* SP_A2D_OUTPUT_INFO (a7xx): float, 8888, mask */
+	kg_cs_reg(0x8c01, 0);                           /* RB_A2D_PIXEL_CNTL: no blending */
+	for (uint32_t reg = 0xb2c0; reg <= 0xb2c4; reg++) {
+		kg_cs_reg(reg, 0);                      /* TPL1_A2D_SRC_TEXTURE_*: no source */
+	}
+	kg_cs_reg(0x8c2c, r);                           /* RB_A2D_CLEAR_COLOR_DW0..3: R, G, B, A in 0..255 */
+	kg_cs_reg(0x8c2d, g);
+	kg_cs_reg(0x8c2e, b);
+	kg_cs_reg(0x8c2f, 255);
+	for (uint32_t reg = 0x8401; reg <= 0x8404; reg++) {
+		kg_cs_reg(reg, 0);                      /* GRAS_A2D_SRC_XMIN..YMAX */
+	}
+	kg_cs_reg(0x8c17, 0x30u | 1u << 10);            /* RB_A2D_DEST_BUFFER_INFO: 8888, linear, WXYZ (blue first) */
+	kg_cs_reg(0x8c18, (uint32_t)KG_GPU_PIC_VA);     /* RB_A2D_DEST_BUFFER_BASE */
+	kg_cs_reg(0x8c19, (uint32_t)(KG_GPU_PIC_VA >> 32));
+	kg_cs_reg(0x8c1a, KG_PIC_ROW >> 6);             /* RB_A2D_DEST_BUFFER_PITCH, 64-byte units */
+	kg_cs_reg(0x8405, top << 16);                   /* GRAS_A2D_DEST_TL */
+	kg_cs_reg(0x8406, (KG_PIC_W - 1) | (bottom - 1) << 16);  /* GRAS_A2D_DEST_BR */
+	kg_cs_pkt7(0x46, 1);                            /* CP_EVENT_WRITE7 DEBUG_LABEL (Mesa's FD_LABEL) */
+	kg_cs_word(0x3f);
+	kg_cs_pkt7(0x2c, 1);                            /* CP_BLIT BLIT_OP_SCALE */
+	kg_cs_word(3);
+}
+
+static bool
+kg_pixel_is(const volatile uint8_t *p, uint32_t x, uint32_t y, uint8_t r, uint8_t g, uint8_t b)
+{
+	const volatile uint8_t *q = p + (size_t)y * KG_PIC_ROW + 4u * x;
+	return q[0] == b && q[1] == g && q[2] == r && q[3] == 0xff;
+}
+
+/*
+ * Three bands (orange, white, blue from the top), drawn by the 2D engine
+ * into a 1080x2400 picture of ours at GPU 0xe0200000; then the CCU and the
+ * cache cleaned to memory, a wait for idle and a marker word, checked from
+ * our side: every 50th row at three columns against its band's colour. Then
+ * copied into the panel memory, again every 250 ms for 15 s (iOS's own
+ * frames would draw over it). Undo: the picture's memory freed; the panel
+ * keeps it until iOS draws its next frame.
+ */
+static bool
+kg_step22(void)
+{
+	static const struct {
+		uint32_t top, bottom;
+		uint8_t r, g, b;
+	} band[3] = { { 0, 800, 255, 128, 0 }, { 800, 1600, 255, 255, 255 }, { 1600, KG_PIC_H, 0, 128, 255 } };
+	vm_offset_t scratch = kg_undo_mem("gpu scratch page");
+
+	if (!kg_gpu_wrote || scratch == 0 || !kg_gx_on()) {
+		printf("SWEET KGPU: 22 needs steps 1-21 (the CP running out of secure mode, in this run)\n");
+		return false;
+	}
+	kg_announce(22, "nothing: memory for a 1080x2400 picture, mapped for the GPU at 0xe0200000");
+	vm_offset_t pic = kg_gpu_alloc("gpu picture", KG_GPU_PIC_VA, KG_PIC_ROW * KG_PIC_H);
+	if (pic == 0) {
+		return false;
+	}
+	kg_to_memory(pic, KG_PIC_ROW * KG_PIC_H);
+	kg_space_commit();
+	uint32_t cb = (kg.smmu_pages + KG_GPU_CB) * kg.smmu_page;
+	kg_wr(kg.smmu, cb + SMMU_CB_TLBIASID, KG_GPU_CB);
+	kg_wr(kg.smmu, cb + SMMU_CB_TLBSYNC, 1);
+	if (!kg_poll(kg.smmu, cb + SMMU_CB_TLBSTATUS, 1u, 0, 100)) {
+		printf("SWEET KGPU: 22 TLB sync does not finish\n");
+		return false;
+	}
+	printf("SWEET KGPU: 22 %u of %u tables used\n", kg_space.used, kg_space.ntables);
+
+	kg_cs_n = 0;
+	kg_cs_pkt7(0x46, 1);                            /* CCU_INVALIDATE_COLOR */
+	kg_cs_word(0x19);
+	kg_cs_pkt7(0x65, 1);                            /* CP_SET_MARKER RM6_BLIT2DSCALE */
+	kg_cs_word(12);
+	kg_cs_reg(0x88e5, 0x40u << 23);                 /* RB_CCU_CACHE_CNTL, sysmem: colour cache at 256K (1 CCU) */
+	for (unsigned i = 0; i < 3; i++) {
+		kg_cs_fill(band[i].top, band[i].bottom, band[i].r, band[i].g, band[i].b);
+	}
+	kg_cs_pkt7(0x46, 1);                            /* CCU_CLEAN_COLOR: the colour cache to memory */
+	kg_cs_word(0x21);
+	kg_cs_pkt7(0x46, 1);                            /* CACHE_CLEAN: UCHE to memory */
+	kg_cs_word(0x31);
+	kg_cs_pkt7(0x26, 0);                            /* CP_WAIT_FOR_IDLE */
+	uint64_t mark = KG_GPU_SCRATCH_VA + KG_GPU_WORD_OFF + 4;
+	kg_cs_pkt7(0x3d, 3);                            /* CP_MEM_WRITE: the marker, after it all */
+	kg_cs_word((uint32_t)mark);
+	kg_cs_word((uint32_t)(mark >> 32));
+	kg_cs_word(KG_GPU_MARK);
+	kg_cs_pkt7(0x12, 0);                            /* CP_WAIT_MEM_WRITES */
+
+	kg_next(22, "three 2D fills (orange, white, blue), the caches to memory, a marker word: the GPU DRAWS");
+	bool idle = kg_cp_submit("cp_rb_wptr (2d fills)", kg_cs, kg_cs_n);
+	kg_to_memory(scratch, 0x1000);
+	kg_to_memory(pic, KG_PIC_ROW * KG_PIC_H);
+	const volatile uint8_t *p = (const volatile uint8_t *)pic;
+	unsigned bad = 0, seen = 0;
+	for (unsigned i = 0; i < 3; i++) {
+		for (uint32_t y = band[i].top; y < band[i].bottom; y += 50) {
+			for (uint32_t x = 0; x < KG_PIC_W; x += KG_PIC_W / 2 - 1) {
+				seen++;
+				bad += !kg_pixel_is(p, x, y, band[i].r, band[i].g, band[i].b);
+			}
+		}
+	}
+	printf("SWEET KGPU: 22 marker %#x (%#x wanted); first pixel %02x %02x %02x %02x, middle %02x %02x %02x %02x, last "
+	    "row %02x %02x %02x %02x (blue green red alpha); %u of %u samples wrong\n",
+	    *(volatile uint32_t *)(scratch + KG_GPU_WORD_OFF + 4), KG_GPU_MARK, p[0], p[1], p[2], p[3],
+	    p[1200 * KG_PIC_ROW + 2160], p[1200 * KG_PIC_ROW + 2161], p[1200 * KG_PIC_ROW + 2162],
+	    p[1200 * KG_PIC_ROW + 2163], p[2399 * KG_PIC_ROW + 4316], p[2399 * KG_PIC_ROW + 4317],
+	    p[2399 * KG_PIC_ROW + 4318], p[2399 * KG_PIC_ROW + 4319], bad, seen);
+	if (!idle || bad != 0) {
+		printf("SWEET KGPU: 22 the picture is not what the GPU was told to draw\n");
+		return false;
+	}
+
+	kg_next(22, "the picture into the panel memory 0xb8000000 (row by row), again every 250 ms for 15 s");
+	vm_offset_t panel = ml_io_map_unmappable(KG_PANEL_PA, (vm_size_t)KG_PANEL_ROW * KG_PIC_H, VM_WIMG_WCOMB);
+	if (panel == 0) {
+		printf("SWEET KGPU: 22 no mapping of the panel memory\n");
+		return false;
+	}
+	for (unsigned n = 0; n < KG_SHOW_S * 4u; n++) {
+		for (uint32_t y = 0; y < KG_PIC_H; y++) {
+			memcpy((void *)(panel + (vm_offset_t)y * KG_PANEL_ROW), (const void *)(pic + (vm_offset_t)y * KG_PIC_ROW),
+			    KG_PANEL_ROW);
+		}
+		__asm__ volatile("dsb sy" ::: "memory");
+		if (n == 0) {
+			printf("SWEET KGPU: 22 A PICTURE DRAWN BY THE GPU IS ON THE PANEL: orange, white, blue from the top "
+			    "(held %u s)\n", KG_SHOW_S);
+		}
+		kg_wait(250);
+	}
+	ml_io_unmap(panel, (vm_size_t)KG_PANEL_ROW * KG_PIC_H);
+	return true;
+}
