+static void
+kg_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+/* every write: said before it is made (the last line before a reset names it), and how to undo it */
+static void
+kg_put(const char *block, vm_offset_t base, uint32_t off, uint32_t val, enum kg_undo_kind kind, uint32_t undo,
+    const char *name)
+{
+	uint32_t was = kg_rd(base, off);
+	printf("SWEET KGPU: %u write %s %s +%#x: %#x -> %#x\n", kg.step, block, name, off, was, val);
+	if (kg.nundo < KG_UNDO_MAX) {
+		kg.undo[kg.nundo].kind = kind;
+		kg.undo[kg.nundo].base = base;
+		kg.undo[kg.nundo].off = off;
+		kg.undo[kg.nundo].value = kind == KG_UNDO_WORD ? was : undo;
+		kg.undo[kg.nundo].name = name;
+		kg.nundo++;
+	} else {
+		printf("SWEET KGPU: %u undo list full: %s stays as written\n", kg.step, name);
+	}
+	kg_wr(base, off, val);
+}
+
+/* poll until (reg & mask) == want, for up to ms milliseconds */
+static bool
+kg_poll(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t want, unsigned ms)
+{
+	for (unsigned i = 0; i < ms * 10u; ++i) {
+		if ((kg_rd(base, off) & mask) == want) {
+			return true;
+		}
+		delay(100);
+	}
+	return (kg_rd(base, off) & mask) == want;
+}
