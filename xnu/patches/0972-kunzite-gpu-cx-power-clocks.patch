+/* ---- step 4: the CX GDSC on ---- */
+
+static bool
+kg_cx_on(void)
+{
+	return ((kg_rd(kg.gpucc, KG_CX_GDSCR) | kg_rd(kg.gpucc, KG_CX_HW_CTRL)) & KG_GDSC_PWR_ON) != 0;
+}
+
+static bool
+kg_step4(void)
+{
+	if (kg.gpucc == 0 || !kg.ahb_on) {
+		printf("SWEET KGPU: 4 GPU_CC not readable (step 3)\n");
+		return false;
+	}
+	kg_announce(4, "the CX and GX GDSCs before switching CX on");
+	uint32_t cx = kg_rd(kg.gpucc, KG_CX_GDSCR), gx = kg_rd(kg.gpucc, KG_GX_GDSCR);
+	printf("SWEET KGPU: 4 cx gdsc %#x hw_ctrl %#x, gx gdsc %#x\n", cx, kg_rd(kg.gpucc, KG_CX_HW_CTRL), gx);
+	if (cx & KG_GDSC_HW_CTRL) {
+		printf("SWEET KGPU: 4 the CX GDSC is under hardware control: not ours to switch\n");
+		return false;
+	}
+	if (gx & KG_GDSC_PWR_ON) {
+		printf("SWEET KGPU: 4 the GX GDSC (3D core) has power already: something else runs the GPU; stopping\n");
+		return false;
+	}
+	if (kg_cx_on()) {
+		printf("SWEET KGPU: 4 CX is on already (not by this run): going on without switching it\n");
+		return true;
+	}
+	kg_next(4, "CX GDSC SW_COLLAPSE off (the first write to the GPU block)");
+	kg_put("GPU_CC", kg.gpucc, KG_CX_GDSCR, cx & ~KG_GDSC_COLLAPSE, KG_UNDO_GDSC, 0, "cx_gdscr");
+	bool on = false;
+	for (unsigned i = 0; i < 500 && !(on = kg_cx_on()); ++i) {
+		delay(100);
+	}
+	printf("SWEET KGPU: 4 cx gdsc %#x hw_ctrl %#x: CX %s\n", kg_rd(kg.gpucc, KG_CX_GDSCR),
+	    kg_rd(kg.gpucc, KG_CX_HW_CTRL), on ? "ON" : "does not come on in 50 ms");
+	return on;
+}
+
+/* ---- step 5: the CX-side clocks ---- */
+
+static bool
+kg_rcg(const char *name, uint32_t rcgr, uint32_t source)
+{
+	uint32_t cfg = kg_rd(kg.gpucc, rcgr + 4);
+	if ((cfg & KG_RCG_CFG_MASK) == source) {
+		printf("SWEET KGPU: 5 %s already at cfg %#x\n", name, cfg);
+		return true;
+	}
+	kg_put("GPU_CC", kg.gpucc, rcgr + 4, (cfg & ~KG_RCG_CFG_MASK) | source, KG_UNDO_RCG, cfg, name);
+	kg_wr(kg.gpucc, rcgr, kg_rd(kg.gpucc, rcgr) | KG_RCG_UPDATE);
+	if (!kg_poll(kg.gpucc, rcgr, KG_RCG_UPDATE, 0, 10)) {
+		printf("SWEET KGPU: 5 %s does not take its new source (cmd %#x)\n", name, kg_rd(kg.gpucc, rcgr));
+		return false;
+	}
+	printf("SWEET KGPU: 5 %s cmd %#x cfg %#x\n", name, kg_rd(kg.gpucc, rcgr), kg_rd(kg.gpucc, rcgr + 4));
+	return true;
+}
+
+/* enable a branch; `must`: its status bit is one to believe (BRANCH_HALT) and has to show it running */
+static bool
+kg_branch(const char *block, vm_offset_t base, uint32_t cbcr, const char *name, bool must)
+{
+	uint32_t was = kg_rd(base, cbcr);
+	if (!(was & KG_CBCR_ENABLE)) {
+		kg_put(block, base, cbcr, was | KG_CBCR_ENABLE, KG_UNDO_WORD, 0, name);
+	}
+	bool runs = kg_poll(base, cbcr, KG_CBCR_OFF, 0, 10);
+	printf("SWEET KGPU: 5 %s %s %#x: %s\n", block, name, kg_rd(base, cbcr),
+	    runs ? "running" : must ? "STAYS OFF" : "off (status not reliable for this one)");
+	return runs || !must;
+}
+
+static bool
+kg_step5(void)
+{
+	if (!kg_cx_on()) {
+		printf("SWEET KGPU: 5 CX is off (step 4)\n");
+		return false;
+	}
+	kg_next(5, "GCC GPLL0 div vote (0x62000 bit 16) and ddrss_gpu_axi 0x81154 on");
+	uint32_t vote = kg_rd(kg.gcc, KG_GCC_VOTE);
+	if (!(vote & KG_GCC_DIV_VOTE)) {
+		kg_put("GCC", kg.gcc, KG_GCC_VOTE, vote | KG_GCC_DIV_VOTE, KG_UNDO_CLEAR, KG_GCC_DIV_VOTE, "gpll0_div vote");
+		delay(10);
+	}
+	(void)kg_branch("GCC", kg.gcc, KG_GCC_DDRSS_AXI, "ddrss_gpu_axi", false);
+	printf("SWEET KGPU: 5 GCC memnoc_gfx %#x snoc_dvm_gfx %#x\n", kg_rd(kg.gcc, KG_GCC_MEMNOC),
+	    kg_rd(kg.gcc, KG_GCC_SNOC_DVM));
+
+	kg_next(5, "gmu_clk_src -> 200 MHz, hub_clk_src -> 150 MHz (GPLL0 div)");
+	if (!kg_rcg("gmu_clk_src", KG_GMU_RCGR, KG_RCG_GPLL0_DIV(3)) ||       /* 300 MHz / 1.5 */
+	    !kg_rcg("hub_clk_src", KG_HUB_RCGR, KG_RCG_GPLL0_DIV(4))) {       /* 300 MHz / 2 */
+		return false;
+	}
+
+	kg_next(5, "GPU_CC cxo, cx_gmu, hub_cx_int, hlos1_vote_gpu_smmu on");
+	if (!kg_branch("GPU_CC", kg.gpucc, 0x9144, "cxo", true) ||
+	    !kg_branch("GPU_CC", kg.gpucc, 0x913c, "cx_gmu", true) ||
+	    !kg_branch("GPU_CC", kg.gpucc, 0x9148, "hub_cx_int", true) ||
+	    !kg_branch("GPU_CC", kg.gpucc, 0x7000, "hlos1_vote_gpu_smmu", false)) {
+		return false;
+	}
+	printf("SWEET KGPU: 5 gmu_clk_src cmd %#x (%s), hub_clk_src cmd %#x (%s)\n",
+	    kg_rd(kg.gpucc, KG_GMU_RCGR), (kg_rd(kg.gpucc, KG_GMU_RCGR) & KG_RCG_ROOT_OFF) ? "root off" : "root on",
+	    kg_rd(kg.gpucc, KG_HUB_RCGR), (kg_rd(kg.gpucc, KG_HUB_RCGR) & KG_RCG_ROOT_OFF) ? "root off" : "root on");
+	return true;
+}
+
+/* ---- end of the run: undo every write, in reverse ---- */
+
+static void
+kg_teardown(void)
+{
+	if (kg.nundo == 0) {
+		return;
+	}
+	kg.step = 0;
+	if (kg.gpucc != 0) {
+		printf("SWEET KGPU: held %u s: cx gdsc %#x hw_ctrl %#x gx gdsc %#x gmu_rcg %#x/%#x hub_rcg %#x/%#x "
+		    "cxo %#x cx_gmu %#x hub_cx_int %#x smmu_vote %#x\n", kg.hold_s,
+		    kg_rd(kg.gpucc, KG_CX_GDSCR), kg_rd(kg.gpucc, KG_CX_HW_CTRL), kg_rd(kg.gpucc, KG_GX_GDSCR),
+		    kg_rd(kg.gpucc, KG_GMU_RCGR), kg_rd(kg.gpucc, KG_GMU_RCGR + 4),
+		    kg_rd(kg.gpucc, KG_HUB_RCGR), kg_rd(kg.gpucc, KG_HUB_RCGR + 4),
+		    kg_rd(kg.gpucc, 0x9144), kg_rd(kg.gpucc, 0x913c), kg_rd(kg.gpucc, 0x9148), kg_rd(kg.gpucc, 0x7000));
+	}
+	printf("SWEET KGPU: undoing %u writes, in reverse\n", kg.nundo);
+	kg_wait(kg.pause_ms);
+	while (kg.nundo > 0) {
+		--kg.nundo;
+		vm_offset_t base = kg.undo[kg.nundo].base;
+		uint32_t off = kg.undo[kg.nundo].off, value = kg.undo[kg.nundo].value;
+		const char *name = kg.undo[kg.nundo].name;
+		switch (kg.undo[kg.nundo].kind) {
+		case KG_UNDO_WORD:
+			kg_wr(base, off, value);
+			break;
+		case KG_UNDO_CLEAR:
+			kg_wr(base, off, kg_rd(base, off) & ~value);
+			break;
+		case KG_UNDO_RCG:               /* off = the CFG register; CMD is 4 before it */
+			kg_wr(base, off, value);
+			kg_wr(base, off - 4, kg_rd(base, off - 4) | KG_RCG_UPDATE);
+			(void)kg_poll(base, off - 4, KG_RCG_UPDATE, 0, 10);
+			break;
+		case KG_UNDO_GDSC:              /* the vendor's driver does not check the status on disable */
+			kg_wr(base, off, kg_rd(base, off) | KG_GDSC_COLLAPSE);
+			(void)kg_poll(base, off, KG_GDSC_PWR_ON, 0, 100);
+			break;
+		}
+		printf("SWEET KGPU: undo %s +%#x: now %#x\n", name, off, kg_rd(base, off));
+	}
+	if (kg.gpucc != 0) {
+		printf("SWEET KGPU: after undo: cx gdsc %#x hw_ctrl %#x gx gdsc %#x\n", kg_rd(kg.gpucc, KG_CX_GDSCR),
+		    kg_rd(kg.gpucc, KG_CX_HW_CTRL), kg_rd(kg.gpucc, KG_GX_GDSCR));
+	}
+}
