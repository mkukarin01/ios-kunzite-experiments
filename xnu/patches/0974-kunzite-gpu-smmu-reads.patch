+/* ---- step 8: the GPU SMMU's global registers and streams ---- */
+
+/* the register space's layout from IDR0/IDR1; false if it is not what the FDT says */
+static bool
+kg_smmu_layout(unsigned step)
+{
+	uint32_t idr0 = kg_rd(kg.smmu, SMMU_IDR0), idr1 = kg_rd(kg.smmu, SMMU_IDR1);
+
+	kg.smmu_page = (idr1 >> 31) ? 0x10000u : 0x1000u;
+	kg.smmu_pages = 2u << ((idr1 >> 28) & 7u);
+	kg.smmu_cbs = idr1 & 0xffu;
+	kg.smmu_smrs = idr0 & 0xffu;
+	printf("SWEET KGPU: %u smmu idr0 %#x idr1 %#x: %u stream match registers, %u contexts, %u pages of %#x\n", step,
+	    idr0, idr1, kg.smmu_smrs, kg.smmu_cbs, kg.smmu_pages, kg.smmu_page);
+	if (2u * kg.smmu_pages * kg.smmu_page != KG_SMMU_SIZE) {
+		printf("SWEET KGPU: %u that makes %#x of registers, the FDT says %#x: not reading further\n", step,
+		    2u * kg.smmu_pages * kg.smmu_page, KG_SMMU_SIZE);
+		return false;
+	}
+	return true;
+}
+
+/* which of the HLOS stream match entries takes `stream`, or -1 */
+static int
+kg_smmu_match(uint32_t stream)
+{
+	for (uint32_t i = 0; i < kg.smmu_smrs && i < KG_SMMU_HLOS; i++) {
+		uint32_t smr = kg_rd(kg.smmu, SMMU_SMR(i));
+		uint32_t id = smr & 0x7fffu, mask = (smr >> 16) & 0x7fffu;
+		if ((smr >> 31) && ((stream ^ id) & ~mask & 0x7fffu) == 0) {
+			return (int)i;
+		}
+	}
+	return -1;
+}
+
+static bool
+kg_step8(void)
+{
+	if (!kg_cx_ready(8)) {
+		return false;
+	}
+	kg_announce(8, "GPU SMMU 0x3da0000: ID registers, sCR0, sGFSR (global registers)");
+	kg.smmu = kg_map("SMMU", KG_SMMU_PA, KG_SMMU_SIZE);
+	if (kg.smmu == 0 || !kg_smmu_layout(8)) {
+		return false;
+	}
+	printf("SWEET KGPU: 8 smmu idr2 %#x idr7 %#x scr0 %#x sgfsr %#x\n", kg_rd(kg.smmu, SMMU_IDR2),
+	    kg_rd(kg.smmu, SMMU_IDR7), kg_rd(kg.smmu, SMMU_SCR0), kg_rd(kg.smmu, SMMU_SGFSR));
+
+	kg_announce(8, "the SMMU's first 6 stream match entries and contexts' kinds (the HLOS ones)");
+	for (uint32_t i = 0; i < kg.smmu_smrs && i < KG_SMMU_HLOS; i++) {
+		uint32_t smr = kg_rd(kg.smmu, SMMU_SMR(i)), s2cr = kg_rd(kg.smmu, SMMU_S2CR(i));
+		printf("SWEET KGPU: 8 smr%u %#x (%s, stream %#x mask %#x) s2cr %#x (%s, context %u)\n", i, smr,
+		    (smr >> 31) ? "valid" : "unused", smr & 0x7fffu, (smr >> 16) & 0x7fffu, s2cr,
+		    ((s2cr >> 16) & 3u) == 0 ? "translate" : ((s2cr >> 16) & 3u) == 1 ? "bypass" : "fault", s2cr & 0xffu);
+	}
+	for (uint32_t i = 0; i < kg.smmu_cbs && i < KG_SMMU_HLOS; i++) {
+		printf("SWEET KGPU: 8 cbar%u %#x cba2r %#x\n", i, kg_rd(kg.smmu, kg.smmu_page + SMMU_CBAR(i)),
+		    kg_rd(kg.smmu, kg.smmu_page + SMMU_CBA2R(i)));
+	}
+	static const struct { uint32_t stream; const char *name; } users[] = {
+		{ 0x0, "GPU (gfx3d_user)" }, { 0x2, "secure (gfx3d_secure)" }, { 0x5, "GMU" },
+	};
+	kg.gpu_cb = -1;
+	for (unsigned u = 0; u < sizeof(users) / sizeof(users[0]); u++) {
+		int m = kg_smmu_match(users[u].stream);
+		if (m < 0) {
+			printf("SWEET KGPU: 8 stream %#x %s: no HLOS match entry (unmatched streams follow sCR0)\n",
+			    users[u].stream, users[u].name);
+			continue;
+		}
+		uint32_t s2cr = kg_rd(kg.smmu, SMMU_S2CR((uint32_t)m));
+		printf("SWEET KGPU: 8 stream %#x %s: entry %d, s2cr %#x\n", users[u].stream, users[u].name, m, s2cr);
+		if (users[u].stream == 0 && ((s2cr >> 16) & 3u) == 0 && (s2cr & 0xffu) < KG_SMMU_HLOS) {
+			kg.gpu_cb = (int)(s2cr & 0xffu);
+		}
+	}
+	return true;
+}
+
+/* ---- step 9: a translation context ---- */
+
+static void
+kg_smmu_cb(uint32_t cb)
+{
+	uint32_t at = (kg.smmu_pages + cb) * kg.smmu_page;
+	printf("SWEET KGPU: 9 cb%u sctlr %#x actlr %#x ttbr0 %#x:%08x tcr %#x mair0 %#x fsr %#x far %#x:%08x\n", cb,
+	    kg_rd(kg.smmu, at + SMMU_CB_SCTLR), kg_rd(kg.smmu, at + SMMU_CB_ACTLR),
+	    kg_rd(kg.smmu, at + SMMU_CB_TTBR0 + 4), kg_rd(kg.smmu, at + SMMU_CB_TTBR0), kg_rd(kg.smmu, at + SMMU_CB_TCR),
+	    kg_rd(kg.smmu, at + SMMU_CB_MAIR0), kg_rd(kg.smmu, at + SMMU_CB_FSR),
+	    kg_rd(kg.smmu, at + SMMU_CB_FAR + 4), kg_rd(kg.smmu, at + SMMU_CB_FAR));
+}
+
+static bool
+kg_step9(void)
+{
+	if (!kg_cx_ready(9) || kg.smmu == 0 || kg.smmu_pages == 0) {
+		printf("SWEET KGPU: 9 needs step 8\n");
+		return false;
+	}
+	kg_announce(9, "SMMU translation context 0 (the GPU's in kgsl and Linux)");
+	kg_smmu_cb(0);
+	if (kg.gpu_cb > 0) {
+		kg_announce(9, "the context stream 0 is matched to");
+		kg_smmu_cb((uint32_t)kg.gpu_cb);
+	}
+	return true;
+}
