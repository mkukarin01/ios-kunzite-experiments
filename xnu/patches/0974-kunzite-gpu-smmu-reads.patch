+/* GPU SMMU (arm-smmu.h, SMMUv2 / MMU-500) */
+#define KG_SMMU_PA       0x03da0000u
+#define KG_SMMU_SIZE     0x00040000u     /* FDT "base" */
+#define KG_SMMU_HLOS     6u              /* FDT qcom,num-smr-override / qcom,num-context-banks-override */
+#define SMMU_SCR0        0x000u
+#define SMMU_IDR0        0x020u          /* [7:0] stream match registers */
+#define SMMU_IDR1        0x024u          /* bit 31 64K pages, [30:28] log2(pages)-1, [7:0] contexts */
+#define SMMU_IDR2        0x028u
+#define SMMU_IDR7        0x03cu
+#define SMMU_SGFSR       0x048u
