+/*
+ * kunzite touch: read one PMIC register (L7E status) through the same
+ * observer path. Read only, like everything here; ENODEV until the arbiter
+ * was probed above (sweetkeys=0 leaves it unprobed).
+ */
+int
+sweet_spmi_peek(unsigned sid, unsigned addr, uint8_t *out)
+{
+	if (!keys_count) {
+		return ENODEV;
+	}
+	uint16_t apid = keys_find_apid((uint16_t)(((sid & 0xfu) << 8) | ((addr >> 8) & 0xffu)), keys_count);
+	if (apid == KEYS_NO_APID) {
+		return ENOENT;
+	}
+	return keys_read(apid, (uint16_t)addr, out) ? 0 : EIO;
+}
