+/*
+ * kunzite (POCO M8 5G, SM6475 parrot) touch: Goodix GT9916K ("Berlin-D") on
+ * SPI, QUP1 SE3 ("se9", 0xa8c000), FIFO mode, polled. Call once after the
+ * scheduler is running; all work runs on one thread.
+ *
+ * Facts (live FDT, Xiaomi kunzite-v-oss, Android logs; NOTES.md "touch"):
+ *  - SPI pins GPIO10 MISO / 11 MOSI / 12 CLK / 13 CS: function 1 (qup1_se3),
+ *    6 mA, no pull. TLMM pin N config at 0xf100000 + 0x1000 * N
+ *    (pinctrl-parrot.h REG_BASE 0x100000), IO word at +4.
+ *  - Touch: IRQ GPIO65 (input, pull-up), reset GPIO131 (low = in reset),
+ *    IOVDD load switch GPIO38 (high = on), AVDD = PM6150L L7E 3.3 V, an
+ *    RPMh VRM resource ("ldoe7"); nothing else uses L7E.
+ *  - GCC (gcc-parrot.c): vote register 0x62008 bits 18 core-2x, 19 core,
+ *    20 m-ahb, 21 s-ahb, 25 s3; S3 RCG 0x283b0 (DFS: SE_GENI_CLK_SEL picks
+ *    the perf level), S3 branch 0x283a8.
+ *  - Android: "a8c000.spi: tx_fifo 16 rx_fifo 16 tx_width 32" - the FIFO
+ *    interface is enabled (GSI-only SEs report 0) and the boot chain loaded
+ *    the SPI firmware.
+ *  - Berlin SPI (Linux goodix_berlin_spi.c): read = F1 + be32 address + 3
+ *    dummy bytes, then data, one full-duplex transfer; write = F0 + be32
+ *    address + data. Core (goodix_berlin_core.c): device confirm = 8 x 0xAA
+ *    written and read back at 0x10000; firmware version at 0x10014; IC info
+ *    at 0x10070 gives touch_data_addr; events are read there and
+ *    acknowledged by writing 0 to its status byte.
+ *  - RPMh (rpmh-rsc.c, cmd-db.c): apps RSC DRV2 at 0x17a20000, TCS bank at
+ *    +0xd00, v3 register layout when RSC_DRV_ID major >= 3, ACTIVE TCS 0-2
+ *    (tcs-config order: ACTIVE 3, SLEEP 2, WAKE 2, FAST_PATH 1); cmd-db in
+ *    reserved memory at 0x80860000 (128 KiB).
+ * Writes: GCC votes (OR only), the S3 RCG only when DFS is off, the seven
+ * touch pins, SE3 registers, one RPMh ACTIVE vote for L7E, and the Berlin
+ * device-confirm/event-acknowledge writes Linux does. No firmware or config
+ * upload; the PMIC itself is only read (L7E status, via sweet_keys.c).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+/* Mach MIG declaration is not included by BSD's exported thread.h. */
+extern kern_return_t thread_terminate(thread_t);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+extern int sweet_spmi_peek(unsigned sid, unsigned addr, uint8_t *out);
+void kunzite_touch_init(void);
+
+#define KT_GCC_PA        0x00100000u
+#define KT_GCC_SIZE      0x00070000u
+#define KT_GCC_VOTE      0x62008u
+#define KT_GCC_BITS      ((1u << 18) | (1u << 19) | (1u << 20) | (1u << 21) | (1u << 25))
+#define KT_S3_CBCR       0x283a8u
+#define KT_S3_RCG        0x283b0u        /* CMD; CFG +4; DFS: CMD_DFSR +0x14, PERF_DFSR(l) +0x1c+4l */
+#define KT_CORE_CBCR     0x33140u
+#define KT_CORE2X_CBCR   0x3314cu
+#define KT_MAHB_CBCR     0x28004u
+#define KT_SAHB_CBCR     0x28008u
+#define KT_TLMM_PA       0x0f100000u     /* TLMM 0xf000000 + REG_BASE 0x100000 */
+#define KT_TLMM_SIZE     0x00084000u     /* pins 0..131 */
+#define KT_PIN_CFG(n)    (0x1000u * (n))
+#define KT_PIN_IO(n)     (0x1000u * (n) + 4u)
+#define KT_PIN_IOVDD     38u
+#define KT_PIN_IRQ       65u
+#define KT_PIN_RESET     131u
+#define KT_SE_PA         0x00a8c000u
+#define KT_QUP_PA        0x00ac0000u     /* QUP1 wrapper: QUP_HW_VER at +4 */
+#define KT_RSC_PA        0x17a20000u     /* apps RSC DRV2 */
+#define KT_RSC_SIZE      0x10000u
+#define KT_TCS_OFF       0xd00u
+#define KT_CMDDB_PA      0x80860000u
+#define KT_CMDDB_SIZE    0x20000u
+
+/* GENI SE (qcom-geni-se.c, spi-geni-qcom.c) */
+#define SE_FORCE_DEFAULT 0x020u
+#define SE_OUTPUT_CTRL   0x024u
+#define SE_CGC_CTRL      0x028u
+#define SE_STATUS        0x040u
+#define SE_M_CLK_CFG     0x048u
+#define SE_IF_DISABLE    0x064u
+#define SE_FW_REV        0x068u
+#define SE_CLK_SEL       0x07cu
+#define SE_SPI_CPHA      0x224u
+#define SE_SPI_LOOPBACK  0x22cu
+#define SE_SPI_CPOL      0x230u
+#define SE_SPI_DEMUX_INV 0x24cu
+#define SE_SPI_DEMUX_SEL 0x250u
+#define SE_BYTE_GRAN     0x254u
+#define SE_DMA_MODE      0x258u
+#define SE_SPI_TRANS_CFG 0x25cu
+#define SE_TX_PACK0      0x260u
+#define SE_TX_PACK1      0x264u
+#define SE_SPI_WORD_LEN  0x268u
+#define SE_SPI_TX_LEN    0x26cu
+#define SE_SPI_RX_LEN    0x270u
+#define SE_RX_PACK0      0x284u
+#define SE_RX_PACK1      0x288u
+#define SE_M_CMD0        0x600u
+#define SE_M_CMD_CTRL    0x604u
+#define SE_M_IRQ         0x610u
+#define SE_M_IRQ_EN      0x614u
+#define SE_M_IRQ_CLR     0x618u
+#define SE_S_IRQ_CLR     0x648u
+#define SE_TX_FIFO       0x700u
+#define SE_RX_FIFO       0x780u
+#define SE_TX_STATUS     0x800u
+#define SE_RX_STATUS     0x804u
+#define SE_TX_WM         0x80cu
+#define SE_RX_WM         0x810u
+#define SE_RX_RFR        0x814u
+#define SE_DMA_TX_CLR    0xc44u
+#define SE_DMA_RX_CLR    0xd44u
+#define SE_GSI_EVENT_EN  0xe18u
+#define SE_IRQ_EN        0xe1cu
+#define SE_HW_PARAM0     0xe24u
+#define SE_DMA_GEN_CFG   0xe30u
+/* spi-msm-geni.c: 3 = full duplex; 7 (SPI_TX_RX) is TX *then* RX, which on
+ * boot #20 made reads land 16 bytes late and writes run on with zeros */
+#define SPI_FULL_DUPLEX  3u
+#define M_DONE           (1u << 0)
+#define M_CANCEL         (1u << 4)
+#define M_ABORT          (1u << 5)
+#define M_ERRORS         (0x0eu | (3u << 24) | (3u << 28))   /* overrun/illegal/failure, FIFO rd/wr */
+#define M_FIFO_EVENTS    (M_DONE | (1u << 26) | (1u << 27))  /* + RX watermark, RX last */
+/* geni_se_config_packing(8, 4, msb first, tx, rx): FIFO bytes stay LSB first */
+#define SE_PACK0         0x0007f8feu
+#define SE_PACK1         0x000ffefeu
+
+/* Berlin */
+#define GB_BOOTOPTION    0x10000u
+#define GB_FW_VERSION    0x10014u
+#define GB_IC_INFO       0x10070u
+#define GB_READ_PREFIX   8u              /* F1 + be32 address + 3 dummy */
+#define GB_WRITE_PREFIX  5u
+#define GB_CHUNK         64u
+#define GB_HEAD          8u
+#define GB_POINT         8u
+#define GB_MAX_TOUCH     10u
+#define GB_EVENT_HEAD    (GB_HEAD + 2u * GB_POINT + 2u)
+#define KT_W             1080
+#define KT_H             2392
+/*
+ * SweetHIDTouch maps y onto the 2436-row iPhone X display as y + 18 (a
+ * 2400-row panel), SweetFramebuffer places this 2392-row panel at row 22.
+ */
+#define KT_HID_YOFF      4
+
+static struct {
+	vm_offset_t gcc, tlmm, se, qup, rsc, db;
+	bool started, dead;
+	unsigned depth, div, logleft, stale_ms;
+	int clk_idx;
+	uint32_t touch_addr;
+	uint32_t active;
+	int x[GB_MAX_TOUCH], y[GB_MAX_TOUCH];
+	unsigned frames, errs, bad_sum, downs, ups, resets;
+	uint64_t last_event;
+	/* RPMh register layout (v2.7 or v3.0) */
+	uint32_t r_wait, r_control, r_status, r_enable, r_msgid, r_addr, r_data, r_cmdst, r_cmd;
+	unsigned ncpt;
+	bool rh_poisoned;
+} kt;
+static int kt_sleep_chan;
+
+static uint32_t
+kt_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+kt_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+kt_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&kt_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+kt_wait_clear(vm_offset_t base, uint32_t off, uint32_t mask)
+{
+	for (unsigned i = 0; i < 2000; ++i) {
+		if (!(kt_rd(base, off) & mask)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/* pull: 0 none, 1 down, 3 up; drive code = mA / 2 - 1 */
+static void
+kt_gpio(unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out, bool high)
+{
+	uint32_t cfg = kt_rd(kt.tlmm, KT_PIN_CFG(pin));
+	if (out) {
+		/* Latch the level before enabling the output (reset is active low). */
+		kt_wr(kt.tlmm, KT_PIN_IO(pin),
+		    (kt_rd(kt.tlmm, KT_PIN_IO(pin)) & ~2u) | (high ? 2u : 0u));
+	}
+	cfg &= ~0x3ffu;
+	cfg |= pull | (mux << 2) | (drive << 6) | (out ? 0x200u : 0u);
+	kt_wr(kt.tlmm, KT_PIN_CFG(pin), cfg);
+}
+
+static void
+kt_pin_dump(const char *when)
+{
+	printf("SWEET TOUCH: pins %s: spi %#x/%#x/%#x/%#x iovdd %#x/%#x irq %#x/%#x reset %#x/%#x\n", when,
+	    kt_rd(kt.tlmm, KT_PIN_CFG(10)), kt_rd(kt.tlmm, KT_PIN_CFG(11)),
+	    kt_rd(kt.tlmm, KT_PIN_CFG(12)), kt_rd(kt.tlmm, KT_PIN_CFG(13)),
+	    kt_rd(kt.tlmm, KT_PIN_CFG(KT_PIN_IOVDD)), kt_rd(kt.tlmm, KT_PIN_IO(KT_PIN_IOVDD)),
+	    kt_rd(kt.tlmm, KT_PIN_CFG(KT_PIN_IRQ)), kt_rd(kt.tlmm, KT_PIN_IO(KT_PIN_IRQ)),
+	    kt_rd(kt.tlmm, KT_PIN_CFG(KT_PIN_RESET)), kt_rd(kt.tlmm, KT_PIN_IO(KT_PIN_RESET)));
+}
+
+/* ---- AVDD: PM6150L L7E through RPMh (port of sweet_rpmh.c, v3 layout) ---- */
+
+#define RH_IRQ_EN        0x00u
+#define RH_IRQ_STATUS    0x04u
+#define RH_IRQ_CLEAR     0x08u
+#define RH_TCS_STRIDE    0x2a0u
+#define RH_ACTIVE_N      3u
+#define RH_AMC_EN        (1u << 16)
+#define RH_TRIGGER       (1u << 24)
+#define RH_ISSUED        (1u << 8)
+#define RH_COMPLETE      (1u << 16)
+#define RH_WRITE_ACK     (8u | (1u << 8) | (1u << 16))
+#define RH_DB_MAGIC      0x0c0330dbu
+#define RH_DB_HEADER     144u
+#define RH_DB_ENTRY      24u
+#define RH_VRM           4u
+#define RH_TIMEOUT_US    100000u
+#define KT_L7E_MV        3300u           /* FDT: min = init 3.3 V, max 3.544 V */
+#define KT_L7E_SID       4u              /* PM6150L ("e") */
+#define KT_L7E_BASE      0x4600u         /* PMIC5 LDO7 */
+
+static uint32_t
+rh_tcs(uint32_t off)
+{
+	return kt_rd(kt.rsc, KT_TCS_OFF + off);
+}
+
+static bool
+rh_sync(uint32_t off, uint32_t value)
+{
+	kt_wr(kt.rsc, KT_TCS_OFF + off, value);
+	for (unsigned i = 0; i < 1000; ++i) {
+		if (rh_tcs(off) == value) {
+			return true;
+		}
+		delay(1);
+	}
+	printf("SWEET TOUCH RPMH: readback timeout off=%#x want=%#x got=%#x\n",
+	    off, value, rh_tcs(off));
+	return false;
+}
+
+/* DB is little endian; avoid packed structs and unaligned Device loads. */
+static uint16_t
+rh_db16(uint32_t off)
+{
+	uint32_t v = kt_rd(kt.db, off & ~3u);
+	return (uint16_t)(v >> (8u * (off & 3u)));
+}
+
+static bool
+rh_range(uint32_t off, uint32_t size)
+{
+	return off <= KT_CMDDB_SIZE && size <= KT_CMDDB_SIZE - off;
+}
+
+static int
+rh_setup(void)
+{
+	uint32_t id = kt_rd(kt.rsc, 0);
+	uint32_t solver = kt_rd(kt.rsc, 4);
+	uint32_t config = kt_rd(kt.rsc, 0x0c);
+	unsigned major = (id >> 16) & 0xffu;
+	unsigned count = (config >> 12) & 0x3fu;        /* DRV 2 */
+	kt.ncpt = (config >> 27) & 0x1fu;
+	if (major >= 3) {
+		kt.r_wait = 0x20; kt.r_control = 0x24; kt.r_status = 0x28; kt.r_enable = 0x2c;
+		kt.r_msgid = 0x34; kt.r_addr = 0x38; kt.r_data = 0x3c; kt.r_cmdst = 0x40; kt.r_cmd = 0x18;
+	} else {
+		kt.r_wait = 0x10; kt.r_control = 0x14; kt.r_status = 0x18; kt.r_enable = 0x1c;
+		kt.r_msgid = 0x30; kt.r_addr = 0x34; kt.r_data = 0x38; kt.r_cmdst = 0x3c; kt.r_cmd = 0x14;
+	}
+	printf("SWEET TOUCH RPMH: drv2=%#x id=%#x (v%u.%u) solver=%#x config=%#x TCS=%u ncpt=%u\n",
+	    KT_RSC_PA, id, major, (id >> 8) & 0xffu, solver, config, count, kt.ncpt);
+	if (id == 0xffffffffu || major < 2 || major > 4 || config == 0xffffffffu ||
+	    count < RH_ACTIVE_N || KT_TCS_OFF + count * RH_TCS_STRIDE > KT_RSC_SIZE ||
+	    kt.ncpt < 3 || kt.ncpt > 16) {
+		printf("SWEET TOUCH RPMH: unsupported RSC geometry/revision\n");
+		return ENODEV;
+	}
+	uint32_t db_version = kt_rd(kt.db, 0);
+	uint32_t magic = kt_rd(kt.db, 4);
+	uint32_t flags = kt_rd(kt.db, 140);
+	printf("SWEET TOUCH RPMH: cmd-db %#x version=%#x magic=%#x flags=%#x\n",
+	    KT_CMDDB_PA, db_version, magic, flags);
+	if (magic != RH_DB_MAGIC || db_version != 1 || (flags & 1u)) {
+		printf("SWEET TOUCH RPMH: unsupported/standalone cmd-db\n");
+		return EINVAL;
+	}
+	return 0;
+}
+
+static int
+rh_lookup(const char *res, uint32_t *address)
+{
+	uint32_t key[2] = {0, 0};
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	unsigned matches = 0;
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
+		unsigned count = rh_db16(h + 6);
+		if (slave < 3 || slave > 5 || (entries & 3u) ||
+		    !rh_range(entries, count * RH_DB_ENTRY) || !rh_range(aux, 0)) {
+			printf("SWEET TOUCH RPMH: malformed cmd-db slave header %u\n", i);
+			return EINVAL;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (kt_rd(kt.db, e) != key[0] || kt_rd(kt.db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t addr = kt_rd(kt.db, e + 16);
+			if (slave != RH_VRM || (addr >> 16) != RH_VRM || (addr & 15u) ||
+			    !rh_range(aux + rh_db16(e + 22), rh_db16(e + 20))) {
+				printf("SWEET TOUCH RPMH: invalid VRM entry for %s\n", res);
+				return EINVAL;
+			}
+			*address = addr;
+			++matches;
+			printf("SWEET TOUCH RPMH: %s addr=%#x slave=%u\n", res, addr, slave);
+		}
+	}
+	if (matches != 1) {
+		printf("SWEET TOUCH RPMH: %s lookup matches=%u; refusing\n", res, matches);
+		return ENODEV;
+	}
+	return 0;
+}
+
+static bool
+rh_free(unsigned t)
+{
+	uint32_t b = t * RH_TCS_STRIDE;
+	/* Idle alone is insufficient: a sleep/wake payload can be armed and idle. */
+	return rh_tcs(b + kt.r_status) != 0 &&
+	    rh_tcs(b + kt.r_status) != 0xffffffffu &&
+	    rh_tcs(b + kt.r_control) == 0 &&
+	    rh_tcs(b + kt.r_enable) == 0 &&
+	    rh_tcs(b + kt.r_wait) == 0 &&
+	    !(rh_tcs(RH_IRQ_STATUS) & (1u << t));
+}
+
+static int
+rh_send(uint32_t address, unsigned mv)
+{
+	int chosen = -1;
+	for (unsigned t = 0; t < RH_ACTIVE_N; ++t) {
+		uint32_t b = t * RH_TCS_STRIDE;
+		uint32_t enabled = rh_tcs(b + kt.r_enable);
+		printf("SWEET TOUCH RPMH: ACTIVE TCS%u idle=%#x control=%#x enable=%#x wait=%#x\n",
+		    t, rh_tcs(b + kt.r_status), rh_tcs(b + kt.r_control), enabled, rh_tcs(b + kt.r_wait));
+		if (enabled & ~((1u << kt.ncpt) - 1u)) {
+			return EIO;
+		}
+		for (unsigned c = 0; c < kt.ncpt; ++c) {
+			if ((enabled & (1u << c)) &&
+			    (rh_tcs(b + kt.r_addr + c * kt.r_cmd) & ~15u) == address) {
+				printf("SWEET TOUCH RPMH: conflicting inherited L7E request in TCS%u\n", t);
+				return EBUSY;
+			}
+		}
+		if (chosen < 0 && rh_free(t)) {
+			chosen = (int)t;
+		}
+	}
+	if (chosen < 0) {
+		printf("SWEET TOUCH RPMH: no empty idle ACTIVE TCS; leaving inherited state intact\n");
+		return EBUSY;
+	}
+	unsigned t = (unsigned)chosen;
+	uint32_t b = t * RH_TCS_STRIDE, bit = 1u << t;
+	uint32_t irq_en = rh_tcs(RH_IRQ_EN);
+	if (irq_en == 0xffffffffu || !rh_free(t)) {
+		return EBUSY;
+	}
+	/* Only this TCS's source is masked. Other sources/CPU IRQs remain intact. */
+	if (!rh_sync(RH_IRQ_EN, irq_en & ~bit)) {
+		kt.rh_poisoned = true;
+		return EIO;
+	}
+	if (!rh_free(t)) {
+		/* No payload was touched. Do not acknowledge somebody else's IRQ. */
+		if (!rh_sync(RH_IRQ_EN, (rh_tcs(RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+			kt.rh_poisoned = true;
+		}
+		return EBUSY;
+	}
+	/* From here an uncertain write/timeout quarantines our slot for this boot. */
+	kt.rh_poisoned = true;
+	/* VRM voltage (mV), mode (PMIC5 LDO HPM = 7, FDT init-mode HPM), enable last. */
+	const uint32_t offsets[3] = {0, 8, 4};
+	const uint32_t values[3] = {mv, 7, 1};
+	printf("SWEET TOUCH RPMH: TCS%u ACTIVE %u mV mode=7 enable=1 irq-enable=%#x\n", t, mv, irq_en);
+	for (unsigned c = 0; c < 3; ++c) {
+		uint32_t cmd = b + c * kt.r_cmd;
+		if (!rh_sync(cmd + kt.r_msgid, RH_WRITE_ACK) ||
+		    !rh_sync(cmd + kt.r_addr, address + offsets[c]) ||
+		    !rh_sync(cmd + kt.r_data, values[c])) {
+			return EIO;
+		}
+	}
+	if (!rh_sync(b + kt.r_wait, 7) || !rh_sync(b + kt.r_enable, 7) ||
+	    !rh_sync(b + kt.r_control, 0) || !rh_sync(b + kt.r_control, RH_AMC_EN)) {
+		return EIO;
+	}
+	kt_wr(kt.rsc, KT_TCS_OFF + b + kt.r_control, RH_AMC_EN | RH_TRIGGER);
+	uint32_t irq = 0, idle = 0, status[3] = {0, 0, 0};
+	bool done = false, progress = false;
+	for (unsigned us = 0; us < RH_TIMEOUT_US; ++us) {
+		irq = rh_tcs(RH_IRQ_STATUS);
+		idle = rh_tcs(b + kt.r_status);
+		bool complete = true;
+		for (unsigned c = 0; c < 3; ++c) {
+			status[c] = rh_tcs(b + kt.r_cmdst + c * kt.r_cmd);
+			complete &= status[c] != 0xffffffffu &&
+			    (status[c] & (RH_ISSUED | RH_COMPLETE)) == (RH_ISSUED | RH_COMPLETE);
+		}
+		/* A fresh IRQ or observed execution transition excludes stale CMD_STATUS. */
+		progress |= idle == 0 || !complete;
+		if (idle && idle != 0xffffffffu && irq != 0xffffffffu &&
+		    ((irq & bit) || progress) && complete) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	printf("SWEET TOUCH RPMH: TCS%u done=%d irq=%#x idle=%#x control=%#x cmd-status=%#x/%#x/%#x\n",
+	    t, done, irq, idle, rh_tcs(b + kt.r_control), status[0], status[1], status[2]);
+	if (!done) {
+		printf("SWEET TOUCH RPMH: timeout; TCS quarantined, IRQ remains masked; no reset/retry\n");
+		return ETIMEDOUT;
+	}
+	/* Proven completion: clear trigger before mode, then free only our commands. */
+	if (!rh_sync(b + kt.r_control, RH_AMC_EN) || !rh_sync(b + kt.r_control, 0) ||
+	    !rh_sync(b + kt.r_enable, 0) || !rh_sync(b + kt.r_wait, 0)) {
+		return EIO;
+	}
+	kt_wr(kt.rsc, KT_TCS_OFF + RH_IRQ_CLEAR, bit); /* W1C: never clear other TCS bits */
+	if ((rh_tcs(RH_IRQ_STATUS) & bit) ||
+	    !rh_sync(RH_IRQ_EN, (rh_tcs(RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+		return EIO;
+	}
+	kt.rh_poisoned = false;
+	return 0;
+}
+
+/* Read-only view of LDO7 on PM6150L: STATUS1 bit 7 = VREG_READY, EN_CTL bit 7. */
+static int
+kt_l7e_dump(const char *when)
+{
+	uint8_t st1 = 0, en = 0, lb = 0, ub = 0, mode = 0;
+	int e1 = sweet_spmi_peek(KT_L7E_SID, KT_L7E_BASE + 0x08u, &st1);
+	int e2 = sweet_spmi_peek(KT_L7E_SID, KT_L7E_BASE + 0x46u, &en);
+	int e3 = sweet_spmi_peek(KT_L7E_SID, KT_L7E_BASE + 0x40u, &lb);
+	int e4 = sweet_spmi_peek(KT_L7E_SID, KT_L7E_BASE + 0x41u, &ub);
+	int e5 = sweet_spmi_peek(KT_L7E_SID, KT_L7E_BASE + 0x45u, &mode);
+	printf("SWEET TOUCH: L7E %s: status1=%#x en=%#x vset=%u mV mode=%#x (spmi %d/%d/%d/%d/%d)\n",
+	    when, st1, en, ((unsigned)ub << 8) | lb, mode, e1, e2, e3, e4, e5);
+	if (e1 || e2) {
+		return -1;      /* unreadable: boot #20 found no APID for SID 4 0x46 */
+	}
+	return (st1 & 0x80u) && (en & 0x80u);
+}
+
+static int
+kt_avdd(void)
+{
+	int on = kt_l7e_dump("before");
+	int power = 1;
+	(void)PE_parse_boot_argn("sweettouchpower", &power, sizeof(power));
+	if (!power) {
+		printf("SWEET TOUCH: sweettouchpower=0: no RPMh vote, L7E as found (on=%d)\n", on);
+		return 0;
+	}
+	if (kt.rh_poisoned) {
+		return EIO;
+	}
+	uint32_t address = 0;
+	int error = rh_setup();
+	if (!error) {
+		error = rh_lookup("ldoe7", &address);
+	}
+	if (!error) {
+		error = rh_send(address, KT_L7E_MV);
+	}
+	kt_wait(15);    /* vendor: 15 ms for AVDD to settle */
+	on = kt_l7e_dump("after");
+	printf("SWEET TOUCH: L7E ACTIVE vote error=%d rail-on=%s\n", error,
+	    on < 0 ? "unreadable" : on ? "yes" : "no");
+	return error;
+}
+
+/* ---- QUP1 SE3: clocks, GENI SPI in FIFO mode, polled transfers ---- */
+
+static bool
+kt_clocks(void)
+{
+	uint32_t vote = kt_rd(kt.gcc, KT_GCC_VOTE);
+	uint32_t dfs = kt_rd(kt.gcc, KT_S3_RCG + 0x14u);
+	printf("SWEET TOUCH: gcc vote=%#x s3=%#x core=%#x/%#x ahb=%#x/%#x rcg=%#x/%#x dfs=%#x\n",
+	    vote, kt_rd(kt.gcc, KT_S3_CBCR), kt_rd(kt.gcc, KT_CORE_CBCR),
+	    kt_rd(kt.gcc, KT_CORE2X_CBCR), kt_rd(kt.gcc, KT_MAHB_CBCR),
+	    kt_rd(kt.gcc, KT_SAHB_CBCR), kt_rd(kt.gcc, KT_S3_RCG),
+	    kt_rd(kt.gcc, KT_S3_RCG + 4u), dfs);
+	/* The vote register is shared: OR our five bits in, never clear any. */
+	kt_wr(kt.gcc, KT_GCC_VOTE, vote | KT_GCC_BITS);
+	kt.clk_idx = -1;
+	if (dfs & 1u) {
+		/* DFS: firmware programmed the perf levels; pick the XO /1 = 19.2 MHz one. */
+		for (unsigned l = 0; l < 8; ++l) {
+			uint32_t cfg = kt_rd(kt.gcc, KT_S3_RCG + 0x1cu + 4u * l);
+			unsigned src = (cfg >> 8) & 7u, mode = (cfg >> 12) & 3u, hid = cfg & 0x1fu;
+			printf("SWEET TOUCH: s3 dfs level %u cfg=%#x src=%u div=%u mnd=%u\n", l, cfg, src, hid, mode);
+			if (kt.clk_idx < 0 && src == 0 && mode == 0 && hid <= 1) {
+				kt.clk_idx = (int)l;
+			}
+		}
+	} else {
+		/* No DFS: XO parent, divider 1 = 19.2 MHz, as topaz's SE2 setup. */
+		kt_wr(kt.gcc, KT_S3_RCG + 4u, 1u);
+		kt_wr(kt.gcc, KT_S3_RCG, kt_rd(kt.gcc, KT_S3_RCG) | 1u);
+		if (!kt_wait_clear(kt.gcc, KT_S3_RCG, 1u)) {
+			printf("SWEET TOUCH: S3 RCG update timeout\n");
+			return false;
+		}
+		kt.clk_idx = 0;
+	}
+	const uint32_t cbcr[5] = {KT_MAHB_CBCR, KT_SAHB_CBCR, KT_CORE_CBCR, KT_CORE2X_CBCR, KT_S3_CBCR};
+	bool ok = true;
+	for (unsigned i = 0; i < 5; ++i) {
+		/* clk-branch.c: no CLK_OFF check while in hardware gating (HW_CTL, bit 1) */
+		if (!(kt_rd(kt.gcc, cbcr[i]) & 2u)) {
+			ok &= kt_wait_clear(kt.gcc, cbcr[i], 1u << 31);
+		}
+	}
+	printf("SWEET TOUCH: gcc vote=%#x s3=%#x core=%#x/%#x ahb=%#x/%#x clk-idx=%d ok=%d\n",
+	    kt_rd(kt.gcc, KT_GCC_VOTE), kt_rd(kt.gcc, KT_S3_CBCR), kt_rd(kt.gcc, KT_CORE_CBCR),
+	    kt_rd(kt.gcc, KT_CORE2X_CBCR), kt_rd(kt.gcc, KT_MAHB_CBCR),
+	    kt_rd(kt.gcc, KT_SAHB_CBCR), kt.clk_idx, ok);
+	return ok && kt.clk_idx >= 0;
+}
+
+static bool
+kt_se_init(void)
+{
+	uint32_t fw = kt_rd(kt.se, SE_FW_REV);
+	uint32_t ifdis = kt_rd(kt.se, SE_IF_DISABLE);
+	uint32_t hw0 = kt_rd(kt.se, SE_HW_PARAM0);
+	uint32_t ver = kt_rd(kt.qup, 4);
+	unsigned proto = (fw >> 8) & 0xffu, major = ver >> 28, minor = (ver >> 16) & 0xfffu;
+	/* geni_se_get_tx_fifo_depth: 8-bit depth field from QUP v3.10 on */
+	kt.depth = (major == 3 && minor >= 10) || major > 3 ? (hw0 >> 16) & 0xffu : (hw0 >> 16) & 0x3fu;
+	unsigned width = (hw0 >> 24) & 0x3fu;
+	printf("SWEET TOUCH: se3 fw=%#x proto=%u if-disable=%#x hw0=%#x depth=%u width=%u qup=%#x status=%#x m-irq=%#x\n",
+	    fw, proto, ifdis, hw0, kt.depth, width, ver, kt_rd(kt.se, SE_STATUS), kt_rd(kt.se, SE_M_IRQ));
+	if (proto != 1 || (ifdis & 1u) || kt.depth < 8 || kt.depth > 64 || width != 32) {
+		printf("SWEET TOUCH: SE3 is not a FIFO-mode SPI master; stopping\n");
+		return false;
+	}
+	if (kt_rd(kt.se, SE_STATUS) & 1u) {
+		printf("SWEET TOUCH: SE3 has an active command; stopping\n");
+		return false;
+	}
+	/* geni_se_init(): irq clear, io init, FIFO mode, watermarks */
+	kt_wr(kt.se, SE_GSI_EVENT_EN, 0);
+	kt_wr(kt.se, SE_M_IRQ_CLR, 0xffffffffu);
+	kt_wr(kt.se, SE_S_IRQ_CLR, 0xffffffffu);
+	kt_wr(kt.se, SE_DMA_TX_CLR, 0xffffffffu);
+	kt_wr(kt.se, SE_DMA_RX_CLR, 0xffffffffu);
+	kt_wr(kt.se, SE_CGC_CTRL, kt_rd(kt.se, SE_CGC_CTRL) | 0x7fu);
+	kt_wr(kt.se, SE_DMA_GEN_CFG, kt_rd(kt.se, SE_DMA_GEN_CFG) | 0xfu);
+	kt_wr(kt.se, SE_OUTPUT_CTRL, 0x7fu);
+	kt_wr(kt.se, SE_FORCE_DEFAULT, 1u);
+	kt_wr(kt.se, SE_IRQ_EN, kt_rd(kt.se, SE_IRQ_EN) | 0xfu);
+	kt_wr(kt.se, SE_DMA_MODE, kt_rd(kt.se, SE_DMA_MODE) & ~1u);
+	kt_wr(kt.se, SE_RX_WM, kt.depth - 3u);
+	kt_wr(kt.se, SE_RX_RFR, kt.depth - 2u);
+	kt_wr(kt.se, SE_TX_WM, 0);
+	kt_wr(kt.se, SE_M_IRQ_EN, kt_rd(kt.se, SE_M_IRQ_EN) | 0x7eu | (0xfu << 22) |
+	    (3u << 28) | M_FIFO_EVENTS);
+	/* SPI mode 0, CS0 active low, 8-bit words, CS held for each whole command */
+	kt_wr(kt.se, SE_SPI_LOOPBACK, 0);
+	kt_wr(kt.se, SE_SPI_CPOL, 0);
+	kt_wr(kt.se, SE_SPI_CPHA, 0);
+	kt_wr(kt.se, SE_SPI_DEMUX_INV, 0);
+	kt_wr(kt.se, SE_SPI_DEMUX_SEL, 0);
+	kt_wr(kt.se, SE_SPI_TRANS_CFG, kt_rd(kt.se, SE_SPI_TRANS_CFG) & ~2u);  /* no CS_TOGGLE */
+	kt_wr(kt.se, SE_SPI_WORD_LEN, 8u - 4u);
+	kt_wr(kt.se, SE_TX_PACK0, SE_PACK0);
+	kt_wr(kt.se, SE_TX_PACK1, SE_PACK1);
+	kt_wr(kt.se, SE_RX_PACK0, SE_PACK0);
+	kt_wr(kt.se, SE_RX_PACK1, SE_PACK1);
+	kt_wr(kt.se, SE_BYTE_GRAN, 0);
+	kt_wr(kt.se, SE_CLK_SEL, (uint32_t)kt.clk_idx & 7u);
+	kt_wr(kt.se, SE_M_CLK_CFG, (kt.div << 4) | 1u);
+	/* Drain anything a previous owner left behind. */
+	for (unsigned n = kt_rd(kt.se, SE_RX_STATUS) & 0x1ffffffu; n; --n) {
+		(void)kt_rd(kt.se, SE_RX_FIFO);
+	}
+	printf("SWEET TOUCH: se3 ready: 19.2 MHz / %u = %u kHz, mode 0, fifo %u x 32 bit, m-irq-en=%#x\n",
+	    kt.div, 19200u / kt.div, kt.depth, kt_rd(kt.se, SE_M_IRQ_EN));
+	return true;
+}
+
+/* i2c/spi-geni: CANCEL, then ABORT if the cancel does not finish. */
+static void
+kt_abort(void)
+{
+	kt_wr(kt.se, SE_M_CMD_CTRL, 1u << 2);
+	if (!kt_wait_clear(kt.se, SE_STATUS, 1u)) {
+		kt_wr(kt.se, SE_M_CMD_CTRL, 1u << 1);
+		if (!kt_wait_clear(kt.se, SE_STATUS, 1u)) {
+			printf("SWEET TOUCH: SE3 abort failed (status=%#x); stopping\n", kt_rd(kt.se, SE_STATUS));
+			kt.dead = true;
+		}
+	}
+	for (unsigned n = kt_rd(kt.se, SE_RX_STATUS) & 0x1ffffffu; n; --n) {
+		(void)kt_rd(kt.se, SE_RX_FIFO);
+	}
+	kt_wr(kt.se, SE_M_IRQ_CLR, 0xffffffffu);
+}
+
+/* One full-duplex command: CS low for all len bytes. */
+static int
+kt_xfer(const uint8_t *tx, uint8_t *rx, unsigned len)
+{
+	if (kt.dead) {
+		return EIO;
+	}
+	if (kt_rd(kt.se, SE_STATUS) & 1u) {
+		return EBUSY;
+	}
+	kt_wr(kt.se, SE_M_IRQ_CLR, 0xffffffffu);
+	kt_wr(kt.se, SE_SPI_TX_LEN, len);
+	kt_wr(kt.se, SE_SPI_RX_LEN, len);
+	kt_wr(kt.se, SE_M_CMD0, SPI_FULL_DUPLEX << 27);   /* no FRAGMENTATION: CS rises at the end */
+	unsigned ti = 0, ri = 0;
+	uint32_t irq = 0;
+	for (unsigned spin = 0; spin < 20000; ++spin) {
+		unsigned queued = kt_rd(kt.se, SE_TX_STATUS) & 0x0fffffffu;
+		bool progress = false;
+		while (ti < len && queued < kt.depth) {
+			uint32_t w = 0;
+			for (unsigned j = 0; j < 4 && ti + j < len; ++j) {
+				w |= (uint32_t)tx[ti + j] << (8u * j);
+			}
+			kt_wr(kt.se, SE_TX_FIFO, w);
+			ti += 4;
+			++queued;
+			progress = true;
+		}
+		for (unsigned n = kt_rd(kt.se, SE_RX_STATUS) & 0x1ffffffu; n; --n) {
+			uint32_t w = kt_rd(kt.se, SE_RX_FIFO);
+			for (unsigned j = 0; j < 4 && ri < len; ++j, ++ri) {
+				rx[ri] = (uint8_t)(w >> (8u * j));
+			}
+			progress = true;
+		}
+		irq = kt_rd(kt.se, SE_M_IRQ);
+		if (irq & M_ERRORS) {
+			break;
+		}
+		if ((irq & M_DONE) && ri >= len) {
+			kt_wr(kt.se, SE_M_IRQ_CLR, irq);
+			return 0;
+		}
+		if (!progress) {
+			delay(1);
+		}
+	}
+	printf("SWEET TOUCH: spi xfer len=%u failed irq=%#x status=%#x tx=%u rx=%u\n",
+	    len, irq, kt_rd(kt.se, SE_STATUS), ti, ri);
+	kt_abort();
+	return (irq & M_ERRORS) ? EIO : ETIMEDOUT;
+}
+
+/* ---- Goodix Berlin-D ---- */
+
+static int
+gb_read(uint32_t addr, uint8_t *out, unsigned n)
+{
+	uint8_t tx[GB_READ_PREFIX + GB_CHUNK], rx[GB_READ_PREFIX + GB_CHUNK];
+	for (unsigned off = 0; off < n; off += GB_CHUNK) {
+		unsigned c = n - off < GB_CHUNK ? n - off : GB_CHUNK;
+		uint32_t a = addr + off;
+		memset(tx, 0, sizeof(tx));
+		tx[0] = 0xf1;
+		tx[1] = (uint8_t)(a >> 24);
+		tx[2] = (uint8_t)(a >> 16);
+		tx[3] = (uint8_t)(a >> 8);
+		tx[4] = (uint8_t)a;
+		tx[5] = tx[6] = tx[7] = 0xff;
+		int err = kt_xfer(tx, rx, GB_READ_PREFIX + c);
+		if (err) {
+			return err;
+		}
+		memcpy(out + off, rx + GB_READ_PREFIX, c);
+	}
+	return 0;
+}
+
+static int
+gb_write(uint32_t addr, const uint8_t *data, unsigned n)
+{
+	uint8_t tx[GB_WRITE_PREFIX + 16], rx[GB_WRITE_PREFIX + 16];
+	if (n > 16) {
+		return EINVAL;
+	}
+	tx[0] = 0xf0;
+	tx[1] = (uint8_t)(addr >> 24);
+	tx[2] = (uint8_t)(addr >> 16);
+	tx[3] = (uint8_t)(addr >> 8);
+	tx[4] = (uint8_t)addr;
+	memcpy(tx + GB_WRITE_PREFIX, data, n);
+	return kt_xfer(tx, rx, GB_WRITE_PREFIX + n);
+}
+
+static unsigned
+gb_le16(const uint8_t *p)
+{
+	return (unsigned)p[0] | ((unsigned)p[1] << 8);
+}
+
+/* Byte sum of all but the trailing le16, compared with it (goodix_berlin_checksum_valid). */
+static bool
+gb_checksum(const uint8_t *p, unsigned len)
+{
+	if (len < 2) {
+		return false;
+	}
+	unsigned sum = 0;
+	for (unsigned i = 0; i + 2 < len; ++i) {
+		sum += p[i];
+	}
+	return (sum & 0xffffu) == gb_le16(p + len - 2);
+}
+
+static void
+gb_hex(const char *what, const uint8_t *p, unsigned n)
+{
+	char line[3 * 32 + 1];
+	unsigned m = n < 32 ? n : 32;
+	for (unsigned i = 0; i < m; ++i) {
+		(void)snprintf(line + 3 * i, 4, "%02x ", p[i]);
+	}
+	line[3 * m] = 0;
+	printf("SWEET TOUCH: %s: %s\n", what, line);
+}
+
+static int
+gb_confirm(void)
+{
+	uint8_t aa[8], back[8];
+	memset(aa, 0xaa, sizeof(aa));
+	for (unsigned tries = 0; tries < 3; ++tries) {
+		memset(back, 0, sizeof(back));
+		int err = gb_write(GB_BOOTOPTION, aa, sizeof(aa));
+		if (!err) {
+			err = gb_read(GB_BOOTOPTION, back, sizeof(back));
+		}
+		gb_hex("confirm 0x10000", back, sizeof(back));
+		bool same = !err;
+		for (unsigned i = 0; i < sizeof(back); ++i) {
+			same &= back[i] == 0xaa;
+		}
+		if (same) {
+			return 0;
+		}
+		kt_wait(5);
+	}
+	return ENODEV;
+}
+
+static int
+gb_info(void)
+{
+	uint8_t ver[28];
+	int err = gb_read(GB_FW_VERSION, ver, sizeof(ver));
+	if (err) {
+		return err;
+	}
+	gb_hex("fw version 0x10014", ver, sizeof(ver));
+	/* rom_pid[6] rom_vid[3] res patch_pid[8] patch_vid[4] res sensor_id res[2] checksum */
+	char rom[7], patch[9];
+	for (unsigned i = 0; i < 8; ++i) {
+		uint8_t c = ver[10 + i];
+		patch[i] = c >= 0x20 && c < 0x7f ? (char)c : '.';
+		if (i < 6) {
+			c = ver[i];
+			rom[i] = c >= 0x20 && c < 0x7f ? (char)c : '.';
+		}
+	}
+	rom[6] = 0;
+	patch[8] = 0;
+	printf("SWEET TOUCH: rom_pid=%s patch_pid=%s patch_vid=%02x%02x%02x%02x sensor=%u checksum=%d\n",
+	    rom, patch, ver[18], ver[19], ver[20], ver[21], ver[23], gb_checksum(ver, sizeof(ver)));
+	if (!gb_checksum(ver, sizeof(ver))) {
+		return EINVAL;
+	}
+	static uint8_t info[1024];
+	err = gb_read(GB_IC_INFO, info, 2);
+	if (err) {
+		return err;
+	}
+	unsigned length = gb_le16(info);
+	if (length < 64 || length >= sizeof(info)) {
+		printf("SWEET TOUCH: ic info length %u invalid\n", length);
+		return EINVAL;
+	}
+	err = gb_read(GB_IC_INFO, info, length);
+	if (err) {
+		return err;
+	}
+	gb_hex("ic info 0x10070", info, length);
+	if (!gb_checksum(info, length)) {
+		printf("SWEET TOUCH: ic info checksum error (length %u)\n", length);
+		return EINVAL;
+	}
+	/*
+	 * goodix_berlin_parse_ic_info(): length, version (16), feature (10),
+	 * drv/sen/button/force counts, five u8-counted le16 arrays, then the
+	 * packed misc block, where touch_data_addr follows cmd (6), cmd reply
+	 * (6), fw state (6), fw buffer (6), frame data (6), attr/log lengths (4),
+	 * pack bytes (2) and four struct lengths (8): misc + 44.
+	 */
+	unsigned off = 2 + 16 + 10 + 4;
+	for (unsigned k = 0; k < 5; ++k) {
+		if (off >= length) {
+			return EINVAL;
+		}
+		off += 1u + 2u * info[off];
+	}
+	if (off + 52 > length) {
+		printf("SWEET TOUCH: ic info misc beyond length (off %u, length %u)\n", off, length);
+		return EINVAL;
+	}
+	const uint8_t *m = info + off + 44;
+	kt.touch_addr = (uint32_t)m[0] | ((uint32_t)m[1] << 8) | ((uint32_t)m[2] << 16) | ((uint32_t)m[3] << 24);
+	printf("SWEET TOUCH: ic info length=%u misc@%u touch_data_addr=%#x head=%u point=%u\n",
+	    length, off, kt.touch_addr, gb_le16(m + 4), gb_le16(m + 6));
+	return kt.touch_addr ? 0 : EINVAL;
+}
+
+static void
+kt_report(uint32_t mask, const int *x, const int *y)
+{
+	for (unsigned id = 0; id < GB_MAX_TOUCH; ++id) {
+		uint32_t bit = 1u << id;
+		if (mask & bit) {
+			if (!(kt.active & bit) || x[id] != kt.x[id] || y[id] != kt.y[id]) {
+				sweet_hid_touch((int)id, 1, x[id], y[id] + KT_HID_YOFF);
+			}
+			if (!(kt.active & bit)) {
+				kt.downs++;
+				if (kt.logleft) {
+					kt.logleft--;
+					printf("SWEET TOUCH: down id=%u at %d,%d\n", id, x[id], y[id]);
+				}
+			}
+			kt.x[id] = x[id];
+			kt.y[id] = y[id];
+		} else if (kt.active & bit) {
+			sweet_hid_touch((int)id, 0, kt.x[id], kt.y[id] + KT_HID_YOFF);
+			kt.ups++;
+			if (kt.logleft) {
+				kt.logleft--;
+				printf("SWEET TOUCH: up id=%u at %d,%d\n", id, kt.x[id], kt.y[id]);
+			}
+		}
+	}
+	kt.active = mask;
+}
+
+static void
+gb_reset_pulse(void)
+{
+	kt_gpio(KT_PIN_RESET, 0, 3, 3, true, false);
+	kt_wait(2);
+	kt_gpio(KT_PIN_RESET, 0, 3, 3, true, true);
+	kt_wait(100);
+}
+
+/* goodix_berlin_irq(), polled */
+static int
+gb_poll(void)
+{
+	uint8_t ev[GB_HEAD + GB_MAX_TOUCH * GB_POINT + 2];
+	int err = gb_read(kt.touch_addr, ev, GB_EVENT_HEAD);
+	if (err) {
+		return err;
+	}
+	if (ev[0] == 0) {
+		return 0;
+	}
+	kt.frames++;
+	if (!gb_checksum(ev, GB_HEAD)) {
+		kt.bad_sum++;
+		if (kt.bad_sum < 4) {
+			gb_hex("bad head", ev, GB_HEAD);
+		}
+	} else {
+		if (ev[0] & 0x80u) {
+			unsigned n = ev[2] & 0x0fu;
+			bool ok = n <= GB_MAX_TOUCH;
+			if (ok && n > 2) {
+				/* the first read stopped 2 bytes into point 2 */
+				err = gb_read(kt.touch_addr + GB_EVENT_HEAD, ev + GB_EVENT_HEAD,
+				    (n - 2) * GB_POINT);
+				ok = !err;
+			}
+			if (ok && n) {
+				ok = gb_checksum(ev + GB_HEAD, n * GB_POINT + 2);
+			}
+			if (!ok) {
+				kt.bad_sum++;
+				if (kt.bad_sum < 4) {
+					gb_hex("bad points", ev, GB_EVENT_HEAD);
+				}
+			} else {
+				int x[GB_MAX_TOUCH] = {0}, y[GB_MAX_TOUCH] = {0};
+				uint32_t mask = 0;
+				for (unsigned i = 0; i < n; ++i) {
+					const uint8_t *p = ev + GB_HEAD + i * GB_POINT;
+					unsigned type = p[0] & 0x0fu, id = p[0] >> 4;
+					if (type == 1 || type == 3 || id >= GB_MAX_TOUCH) {
+						continue;   /* stylus hover/contact */
+					}
+					/* FDT panel-max 17280 x 38272 = 16 x 1080 x 2392 */
+					int px = (int)(gb_le16(p + 2) / 16u), py = (int)(gb_le16(p + 4) / 16u);
+					x[id] = px > KT_W - 1 ? KT_W - 1 : px;
+					y[id] = py > KT_H - 1 ? KT_H - 1 : py;
+					mask |= 1u << id;
+				}
+				kt_report(mask, x, y);
+				kt.last_event = mach_absolute_time();
+			}
+		}
+		if (ev[0] & 0x40u) {
+			printf("SWEET TOUCH: request %#x from the IC\n", ev[2]);
+			if (ev[2] == 3) {
+				kt.resets++;
+				gb_reset_pulse();
+			}
+		}
+	}
+	uint8_t zero = 0;
+	return gb_write(kt.touch_addr, &zero, 1);
+}
+
+static void
+kt_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 45;
+	(void)arg;
+	(void)result;
+	/*
+	 * Start late (boot-arg sweettouchdelay, seconds): if the bus access
+	 * below hangs the SoC, the persistent log and the GUI got there first.
+	 */
+	(void)PE_parse_boot_argn("sweettouchdelay", &delay_s, sizeof(delay_s));
+	printf("SWEET TOUCH: kunzite GT9916K on SPI SE3, starting in %u s\n", delay_s);
+	kt_wait(delay_s * 1000u);
+	kt.gcc = ml_io_map(KT_GCC_PA, KT_GCC_SIZE);
+	kt.tlmm = ml_io_map(KT_TLMM_PA, KT_TLMM_SIZE);
+	kt.se = ml_io_map(KT_SE_PA, 0x4000);
+	kt.qup = ml_io_map(KT_QUP_PA, 0x1000);
+	kt.rsc = ml_io_map(KT_RSC_PA, KT_RSC_SIZE);
+	kt.db = ml_io_map(KT_CMDDB_PA, KT_CMDDB_SIZE);
+	if (!kt.gcc || !kt.tlmm || !kt.se || !kt.qup || !kt.rsc || !kt.db) {
+		printf("SWEET TOUCH: MMIO mapping failed\n");
+		goto out;
+	}
+	kt_pin_dump("as found");
+	if (!kt_clocks() || !kt_se_init()) {
+		goto out;
+	}
+	/* goodix_berlin_power_on(): reset held, IOVDD, 3 ms, AVDD, 15 ms, release */
+	kt_gpio(KT_PIN_RESET, 0, 3, 3, true, false);
+	kt_gpio(KT_PIN_IRQ, 0, 3, 3, false, false);
+	for (unsigned pin = 10; pin <= 13; ++pin) {
+		kt_gpio(pin, 1, 0, 2, false, false);
+	}
+	kt_gpio(KT_PIN_IOVDD, 0, 3, 3, true, true);
+	kt_wait(3);
+	if (kt_avdd()) {
+		printf("SWEET TOUCH: AVDD vote failed; trying the IC anyway\n");
+	}
+	kt_gpio(KT_PIN_RESET, 0, 3, 3, true, true);
+	kt_wait(4);
+	kt_pin_dump("powered");
+	int err = gb_confirm();
+	printf("SWEET TOUCH: device confirm err=%d\n", err);
+	if (err) {
+		goto out;
+	}
+	kt_wait(100);   /* vendor: firmware fully booted */
+	err = gb_info();
+	if (err) {
+		printf("SWEET TOUCH: IC info err=%d; stopping\n", err);
+		goto out;
+	}
+	printf("SWEET TOUCH: polling every 8 ms, 1080x2392, HID y offset %d\n", KT_HID_YOFF);
+	unsigned errors = 0, polls = 0, stale_logs = 0;
+	uint64_t stale;
+	/* Lift comes from the IC's zero-touch report; sweettouchstale=ms adds a
+	 * timeout for ICs that go quiet instead (off by default: it would break
+	 * long presses if the IC stops reporting a still finger). */
+	nanoseconds_to_absolutetime((uint64_t)kt.stale_ms * NSEC_PER_MSEC, &stale);
+	while (!kt.dead) {
+		int e = gb_poll();
+		if (e) {
+			kt.errs++;
+			if ((errors++ % 100u) == 0) {
+				printf("SWEET TOUCH: poll err=%d (total %u)\n", e, kt.errs);
+			}
+			if (errors == 10) {
+				kt_report(0, kt.x, kt.y);   /* release after persistent bad reads */
+			}
+		} else {
+			errors = 0;
+		}
+		/* Berlin reports at the scan rate while touched; silence means lift. */
+		if (kt.stale_ms && kt.active && mach_absolute_time() - kt.last_event > stale) {
+			if (stale_logs++ < 8) {
+				printf("SWEET TOUCH: no report for %u ms with fingers down; releasing\n", kt.stale_ms);
+			}
+			kt_report(0, kt.x, kt.y);
+		}
+		if (++polls % 7500u == 0) {     /* ~60 s */
+			printf("SWEET TOUCH: stats frames=%u downs=%u ups=%u errs=%u bad-sum=%u resets=%u\n",
+			    kt.frames, kt.downs, kt.ups, kt.errs, kt.bad_sum, kt.resets);
+		}
+		kt_wait(8);
+	}
+	kt_report(0, kt.x, kt.y);
+out:
+	printf("SWEET TOUCH: stopped\n");
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+kunzite_touch_init(void)
+{
+	int enabled = 1, div = 4, logn = 24, stale_ms = 0;
+	thread_t thread;
+	if (kt.started) {
+		return;
+	}
+	kt.started = true;
+	(void)PE_parse_boot_argn("sweettouch", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("sweettouchdiv", &div, sizeof(div));
+	(void)PE_parse_boot_argn("sweettouchlog", &logn, sizeof(logn));
+	(void)PE_parse_boot_argn("sweettouchstale", &stale_ms, sizeof(stale_ms));
+	if (!enabled) {
+		printf("SWEET TOUCH: disabled (sweettouch=0)\n");
+		return;
+	}
+	/* 19.2 MHz / div; the FDT allows up to 12 MHz (div >= 2) */
+	kt.div = div >= 2 && div <= 64 ? (unsigned)div : 4u;
+	kt.logleft = logn > 0 ? (unsigned)logn : 0u;
+	kt.stale_ms = stale_ms > 0 && stale_ms <= 5000 ? (unsigned)stale_ms : 0u;
+	kern_return_t kr = kernel_thread_start(kt_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET TOUCH: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
