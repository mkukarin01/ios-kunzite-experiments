+#define CPUFREQ_DOM0_PA         0x17d91000u
+#define CPUFREQ_DOM1_PA         0x17d92000u
 #define CPUFREQ_FREQ_LUT        0x110u
 #define CPUFREQ_LUT_ROW         0x20u
 #define CPUFREQ_PERF_STATE      0x920u
@@ -26,29 +28,31 @@
 	if (!on) {
 		return 0;
