+	};
+	for (unsigned d = 0; d < 2; d++) {
+		vm_offset_t b = ml_io_map(dom[d].pa, 0x1000);
+		if (b == 0) {
+			continue;
+		}
+		uint32_t best = 0, bestKHz = 0, prevKHz = 0;
+		for (uint32_t i = 0; i < CPUFREQ_LUT_MAX; i++) {
