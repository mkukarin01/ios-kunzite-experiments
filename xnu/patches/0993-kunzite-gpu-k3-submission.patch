+/* ---- submission (glue plan K3): kgsl's gen7 ringbuffer, its fence, the ring wrapping ---- */
+
+#define KG_RB_DWORDS     (KG_RB_SIZE / 4u)
+#define KG_FENCE_OFF     0x200u          /* in the scratch page: the word the CP's fence writes */
+#define KG_SUB_IBS       128u            /* IBs in one submission, at most (RedwoodGPU's GPU_SUBMIT_CMDS) */
+#define KG_SUB_WORDS(n)  (25u + 4u * (n))
+#define KG_CP_NOP        0x10u
+#define KG_CP_THREAD_CONTROL 0x17u
+#define KG_CP_SET_MARKER 0x65u
+#define KG_CP_IB_PFE     0x3fu           /* CP_INDIRECT_BUFFER_PFE */
+#define KG_CP_EVENT_WRITE 0x46u
+#define KG_THREAD_BR     1u
+#define KG_THREAD_BOTH   3u
+#define KG_EV_CACHE_CLEAN 0x31u
+#define KG_EV_WRITE      (1u << 27)      /* the event writes a value (BIT(31) would also interrupt: we poll) */
+#define GEN7_CP_IB1_BASE                 0x928
+#define GEN7_CP_IB1_BASE_HI              0x929
+#define GEN7_CP_IB1_REM_SIZE             0x92a
+#define GEN7_CP_IB2_BASE                 0x92b
+#define GEN7_CP_IB2_BASE_HI              0x92c
+#define GEN7_CP_IB2_REM_SIZE             0x92d
+
+static LCK_GRP_DECLARE(kg_lck_grp, "kunzite_adreno");
+static LCK_MTX_DECLARE(kg_sub_lock, &kg_lck_grp);
+static struct {
+	volatile uint32_t *fence;       /* the fence word, through an uncached alias */
+	uint32_t seqno;                 /* the newest submission's fence */
+	unsigned submits, wraps, waits;
+	bool ready;
+} kg_sub;
+
+static uint32_t
+kg_pkt7(uint32_t op, uint32_t cnt)
+{
+	return 7u << 28 | cnt | kg_parity(cnt) << 15 | (op & 0x7fu) << 16 | kg_parity(op) << 23;
+}
+
+/*
+ * Once the CP runs out of secure mode (step 21): the fence word in the scratch page
+ * (GPU KG_GPU_SCRATCH_VA + KG_FENCE_OFF), read through an uncached alias of that page
+ * (unmapped by the undo), set to 0. Then redwood_gpu_submit takes command buffers.
+ */
+static bool
+kg_sub_setup(void)
+{
+	vm_offset_t scratch = kg_undo_mem("gpu scratch page"), alias;
+
+	if (kg_sub.ready) {
+		return true;
+	}
+	if (!kg_gpu_wrote || scratch == 0 || kg_rb_wptr == 0) {
+		printf("SWEET KGPU: %u submission needs steps 1-21 (the CP running out of secure mode)\n", kg.step);
+		return false;
+	}
+	alias = ml_io_map_unmappable((vm_offset_t)kvtophys(scratch), PAGE_SIZE, VM_WIMG_WCOMB);
+	if (alias == 0) {
+		printf("SWEET KGPU: %u no uncached alias of the scratch page\n", kg.step);
+		return false;
+	}
+	kg_undo_push(KG_UNDO_UNMAP, alias, 0, (uint32_t)PAGE_SIZE, "fence uncached alias");
+	kg_sub.fence = (volatile uint32_t *)(alias + KG_FENCE_OFF);
+	*kg_sub.fence = 0;
+	__asm__ volatile("dsb sy" ::: "memory");
+	kg_sub.seqno = 0;
+	kg_sub.ready = true;
+	printf("SWEET KGPU: %u submission ready: fence word at GPU %#llx (uncached alias), ring wptr %u of %u words\n", kg.step,
+	    KG_GPU_SCRATCH_VA + KG_FENCE_OFF, kg_rb_wptr, KG_RB_DWORDS);
+	return true;
+}
+
+/*
+ * n contiguous words at the ring's WPTR, waiting up to 2 s for the CP to read far
+ * enough. When the tail is too short, a NOP covers it and the words go from 0
+ * (kgsl adreno_ringbuffer_allocspace). WPTR never catches up with RPTR: equal
+ * means empty. The lock is held.
+ */
+static bool
+kg_rb_room(vm_offset_t rb, uint32_t n)
+{
+	bool waited = false;
+
+	for (unsigned t = 0; t < 20000; t++) {
+		uint32_t rptr = kg_rd(kg.gpu, 4u * GEN7_CP_RB_RPTR) % KG_RB_DWORDS, w = kg_rb_wptr;
+
+		if (w >= rptr) {
+			uint32_t tail = KG_RB_DWORDS - w;
+			if (tail > n || (tail == n && rptr != 0)) {
+				return true;
+			}
+			if (rptr > n) {
+				((volatile uint32_t *)rb)[w] = kg_pkt7(KG_CP_NOP, tail - 1u);
+				kg_to_memory(rb + 4u * w, 4);
+				kg_rb_wptr = 0;
+				kg_sub.wraps++;
+				continue;
+			}
+		} else if (rptr - w > n) {
+			return true;
+		}
+		if (!waited) {
+			kg_sub.waits++;
+			waited = true;
+		}
+		delay(100);
+	}
+	return false;
+}
+
+/*
+ * One submission: the IBs as kgsl's gen7 ringbuffer has them (gen7_ringbuffer_addcmds and
+ * _submitcmd): both threads, IFPC off (marker 0x101), BR; the IB list between markers 0xd
+ * and 0xe, one CP_INDIRECT_BUFFER_PFE each; the CCU invalidated (events 24, 25); the fence:
+ * CACHE_CLEAN writing the submission's number into the fence word once the work is done;
+ * both threads, IFPC on (0x100), BR. Returns the fence, 0 if it was not taken.
+ */
+static uint32_t
+kg_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count)
+{
+	uint32_t cmd[KG_SUB_WORDS(KG_SUB_IBS)], n = 0, fence;
+	uint64_t at = KG_GPU_SCRATCH_VA + KG_FENCE_OFF;
+	vm_offset_t rb = kg_undo_mem("gpu ringbuffer");
+
+	if (!kg_sub.ready || rb == 0 || count == 0 || count > KG_SUB_IBS) {
+		return 0;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		if (words[i] == 0 || words[i] > 0xfffffu || (addresses[i] & 3u) != 0) {
+			return 0;
+		}
+	}
+	lck_mtx_lock(&kg_sub_lock);
+	if (!kg_rb_room(rb, KG_SUB_WORDS(count))) {
+		lck_mtx_unlock(&kg_sub_lock);
+		return 0;
+	}
+	fence = ++kg_sub.seqno;
+	if (fence == 0) {
+		fence = kg_sub.seqno = 1;
+	}
+	cmd[n++] = kg_pkt7(KG_CP_THREAD_CONTROL, 1);
+	cmd[n++] = KG_THREAD_BOTH;
+	cmd[n++] = kg_pkt7(KG_CP_SET_MARKER, 1);
+	cmd[n++] = 0x101;                               /* IFPC disable */
+	cmd[n++] = kg_pkt7(KG_CP_THREAD_CONTROL, 1);
+	cmd[n++] = KG_THREAD_BR;
+	cmd[n++] = kg_pkt7(KG_CP_SET_MARKER, 1);
+	cmd[n++] = 0x00d;                               /* IB1LIST start */
+	for (uint32_t i = 0; i < count; i++) {
+		cmd[n++] = kg_pkt7(KG_CP_IB_PFE, 3);
+		cmd[n++] = (uint32_t)addresses[i];
+		cmd[n++] = (uint32_t)(addresses[i] >> 32);
+		cmd[n++] = words[i];
+	}
+	cmd[n++] = kg_pkt7(KG_CP_SET_MARKER, 1);
+	cmd[n++] = 0x00e;                               /* IB1LIST end */
+	cmd[n++] = kg_pkt7(KG_CP_EVENT_WRITE, 1);
+	cmd[n++] = 24;                                  /* CCU invalidate depth */
+	cmd[n++] = kg_pkt7(KG_CP_EVENT_WRITE, 1);
+	cmd[n++] = 25;                                  /* CCU invalidate color */
+	cmd[n++] = kg_pkt7(KG_CP_EVENT_WRITE, 4);
+	cmd[n++] = KG_EV_CACHE_CLEAN | KG_EV_WRITE;
+	cmd[n++] = (uint32_t)at;
+	cmd[n++] = (uint32_t)(at >> 32);
+	cmd[n++] = fence;
+	cmd[n++] = kg_pkt7(KG_CP_THREAD_CONTROL, 1);
+	cmd[n++] = KG_THREAD_BOTH;
+	cmd[n++] = kg_pkt7(KG_CP_SET_MARKER, 1);
+	cmd[n++] = 0x100;                               /* IFPC enable */
+	cmd[n++] = kg_pkt7(KG_CP_THREAD_CONTROL, 1);
+	cmd[n++] = KG_THREAD_BR;
+	memcpy((uint32_t *)rb + kg_rb_wptr, cmd, 4u * n);
+	kg_to_memory(rb + 4u * kg_rb_wptr, 4u * n);
+	kg_rb_wptr = (kg_rb_wptr + n) % KG_RB_DWORDS;
+	kg_wr(kg.gpu, 4u * GEN7_CP_RB_WPTR, kg_rb_wptr);
+	kg_sub.submits++;
+	lck_mtx_unlock(&kg_sub_lock);
+	return fence;
+}
+
+/* the CP has written fence `fence` (or a later one) */
+static bool
+kg_fence_done(uint32_t fence)
+{
+	return !kg_sub.ready || (int32_t)(*kg_sub.fence - fence) >= 0;
+}
+
+static void
+kg_gpu_report(const char *why)
+{
+	uint32_t cb = (kg.smmu_pages + KG_GPU_CB) * kg.smmu_page;
+
+	kg_wr(kg.gpu, 4u * GEN7_CP_SQE_STAT_ADDR, 1);
+	printf("SWEET KGPU: report (%s): fence %u, done %u; ring rptr %u wptr %u (%u wraps); rbbm_status %#x "
+	    "cp_hw_fault %#x interrupt %#x protect %#x sqe_stat %#x; ib1 %#x:%08x rem %u, ib2 %#x:%08x rem %u\n", why,
+	    kg_sub.seqno, kg_sub.ready ? *kg_sub.fence : 0, kg_rd(kg.gpu, 4u * GEN7_CP_RB_RPTR), kg_rb_wptr, kg_sub.wraps,
+	    kg_rd(kg.gpu, 4u * GEN7_RBBM_STATUS), kg_rd(kg.gpu, 4u * GEN7_CP_HW_FAULT),
+	    kg_rd(kg.gpu, 4u * GEN7_CP_INTERRUPT_STATUS), kg_rd(kg.gpu, 4u * GEN7_CP_PROTECT_STATUS),
+	    kg_rd(kg.gpu, 4u * GEN7_CP_SQE_STAT_DATA), kg_rd(kg.gpu, 4u * GEN7_CP_IB1_BASE_HI),
+	    kg_rd(kg.gpu, 4u * GEN7_CP_IB1_BASE), kg_rd(kg.gpu, 4u * GEN7_CP_IB1_REM_SIZE),
+	    kg_rd(kg.gpu, 4u * GEN7_CP_IB2_BASE_HI), kg_rd(kg.gpu, 4u * GEN7_CP_IB2_BASE),
+	    kg_rd(kg.gpu, 4u * GEN7_CP_IB2_REM_SIZE));
+	printf("SWEET KGPU: report (%s): cb0 fsr %#x far %#x:%08x fsynr0 %#x\n", why, kg_rd(kg.smmu, cb + SMMU_CB_FSR),
+	    kg_rd(kg.smmu, cb + SMMU_CB_FAR + 4), kg_rd(kg.smmu, cb + SMMU_CB_FAR), kg_rd(kg.smmu, cb + SMMU_CB_FSYNR0));
+}
+
+/* up to `ms` milliseconds for a fence; the time it took in microseconds, or ~0u */
+static unsigned
+kg_fence_wait(uint32_t fence, unsigned ms)
+{
+	for (unsigned us = 0; us <= ms * 1000u; us += 20) {
+		if (kg_fence_done(fence)) {
+			return us;
+		}
+		delay(20);
+	}
+	return ~0u;
+}
+
+/* an IB at byte `off` of the IB buffer: kg_cs copied there and cleaned to memory; its GPU address */
+static uint64_t
+kg_ib_put(struct kg_ubuf *ib, uint32_t off)
+{
+	memcpy((void *)(ib->mem + off), kg_cs, 4u * kg_cs_n);
+	kg_to_memory(ib->mem + off, 4u * kg_cs_n);
+	return ib->va + off;
+}
+
+/* kg_cs: an IB that fills rows [top, bottom) of 1024 pixels at va with one colour, the caches to memory after */
+static void
+kg_ib_fill(uint64_t va, uint32_t top, uint32_t bottom, uint8_t r, uint8_t g, uint8_t b)
+{
+	kg_cs_n = 0;
+	kg_cs_pkt7(0x46, 1);                            /* CCU_INVALIDATE_COLOR */
+	kg_cs_word(0x19);
+	kg_cs_pkt7(0x65, 1);                            /* CP_SET_MARKER RM6_BLIT2DSCALE */
+	kg_cs_word(12);
+	kg_cs_reg(0x88e5, 0x40u << 23);                 /* RB_CCU_CACHE_CNTL, as step 22 */
+	kg_cs_fill_at(va, KG_U_PITCH, KG_U_PITCH / 4u, top, bottom, r, g, b);
+	kg_cs_pkt7(0x46, 1);                            /* CCU_CLEAN_COLOR */
+	kg_cs_word(0x21);
+	kg_cs_pkt7(0x46, 1);                            /* CACHE_CLEAN */
+	kg_cs_word(0x31);
+}
+
+/*
+ * Step 24 (glue plan K3): submissions through redwood_gpu_submit, as RedwoodGPU will make
+ * them for Mesa: IBs in an own buffer of the GPU's (step 23's kind), a picture buffer of
+ * 1024 x 256; each submission ends in the fence, polled through its uncached word. No
+ * wait-for-idle and no marker in the IBs: the fence alone says the work is done.
+ * Checked: one IB of three bands; two IBs in one submission (top half, bottom half);
+ * 400 submissions of a one-row IB without waiting, which wraps the 8K-word ring and
+ * makes the submitter wait for room; their fences one after another; done(last) and
+ * not done(last + 1); the report. The buffers go in the step.
+ */
+#define KG_SUB_RUNS      400u
+static bool
+kg_step24(void)
+{
+	static const struct {
+		uint32_t top, bottom;
+		uint8_t r, g, b;
+	} band[3] = { { 0, 80, 255, 128, 0 }, { 80, 170, 255, 255, 255 }, { 170, 256, 0, 128, 255 } };
+	struct kg_ubuf pic, ib;
+	uint64_t va[2];
+	uint32_t len[2], f, first = 0, last = 0, wraps0;
+	unsigned bad = 0, us, order = 0;
+	bool ok = false;
+
+	bzero(&pic, sizeof(pic));
+	bzero(&ib, sizeof(ib));
+	if (!kg_sub_setup()) {
+		return false;
+	}
+	kg_next(24, "submissions through redwood_gpu_submit: IBs in the GPU's own memory, kgsl's gen7 wrapping, the fence "
+	    "polled; two IBs at once; 400 in a row around the ring");
+	if (!kg_ubuf_make(&pic, 0x100000, false) || !kg_ubuf_make(&ib, 0x10000, false)) {
+		goto out;
+	}
+
+	/* one IB, three bands */
+	kg_cs_n = 0;
+	kg_cs_pkt7(0x46, 1);
+	kg_cs_word(0x19);
+	kg_cs_pkt7(0x65, 1);
+	kg_cs_word(12);
+	kg_cs_reg(0x88e5, 0x40u << 23);
+	for (unsigned i = 0; i < 3; i++) {
+		kg_cs_fill_at(pic.va, KG_U_PITCH, KG_U_PITCH / 4u, band[i].top, band[i].bottom, band[i].r, band[i].g, band[i].b);
+	}
+	kg_cs_pkt7(0x46, 1);
+	kg_cs_word(0x21);
+	kg_cs_pkt7(0x46, 1);
+	kg_cs_word(0x31);
+	len[0] = kg_cs_n;
+	va[0] = kg_ib_put(&ib, 0);
+	f = kg_submit(va, len, 1);
+	us = f != 0 ? kg_fence_wait(f, 1000) : ~0u;
+	for (unsigned i = 0; i < 3 && us != ~0u; i++) {
+		bad += kg_ucheck(pic.mem + (vm_offset_t)band[i].top * KG_U_PITCH, band[i].bottom - band[i].top, band[i].r, band[i].g,
+		    band[i].b);
+	}
+	printf("SWEET KGPU: 24 one IB (%u words at GPU %#llx), three bands: fence %u done after %u us; %u of 512 samples wrong\n",
+	    len[0], va[0], f, us, bad);
+	if (f == 0 || us == ~0u || bad != 0) {
+		goto out;
+	}
+
+	/* two IBs in one submission */
+	kg_ib_fill(pic.va, 0, 128, 200, 0, 200);
+	len[0] = kg_cs_n;
+	va[0] = kg_ib_put(&ib, 0x1000);
+	kg_ib_fill(pic.va, 128, 256, 0, 200, 200);
+	len[1] = kg_cs_n;
+	va[1] = kg_ib_put(&ib, 0x2000);
+	f = kg_submit(va, len, 2);
+	us = f != 0 ? kg_fence_wait(f, 1000) : ~0u;
+	bad = us == ~0u ? 1u : kg_ucheck(pic.mem, 128, 200, 0, 200) + kg_ucheck(pic.mem + 128u * KG_U_PITCH, 128, 0, 200, 200);
+	printf("SWEET KGPU: 24 two IBs in one submission: fence %u done after %u us; %u of 512 samples wrong\n", f, us, bad);
+	if (f == 0 || us == ~0u || bad != 0) {
+		goto out;
+	}
+
+	/* 400 in a row, around the ring */
+	kg_ib_fill(pic.va, 0, 1, 7, 77, 177);
+	len[0] = kg_cs_n;
+	va[0] = kg_ib_put(&ib, 0x3000);
+	wraps0 = kg_sub.wraps;
+	for (unsigned i = 0; i < KG_SUB_RUNS; i++) {
+		f = kg_submit(va, len, 1);
+		if (f == 0) {
+			printf("SWEET KGPU: 24 submission %u of %u not taken (no room in 2 s?)\n", i, KG_SUB_RUNS);
+			goto out;
+		}
+		order += i != 0 && f != last + 1u;
+		first = i == 0 ? f : first;
+		last = f;
+	}
+	us = kg_fence_wait(last, 2000);
+	bad = us == ~0u ? 1u : kg_ucheck(pic.mem, 1, 7, 77, 177);
