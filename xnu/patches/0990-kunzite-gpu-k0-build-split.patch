+
+/*
+ * ---- the hardware interface, in place of TopazAdreno.cpp ----
+ *
+ * RedwoodGPU.cpp (the msm DRM user client Mesa talks to), SweetSurface.cpp and
+ * SweetFramebuffer.cpp use these by their C names (extern "C" there). Topaz's
+ * A610 driver, TopazAdreno.cpp and its firmware TopazAdrenoFw.cpp, is not built
+ * for kunzite (iokit/conf/files.arm64); this is its place (main repo
+ * ios/gpu-glue-plan.md 3.2, 3.7). Here the SMMU translates: no identity mode, and no
+ * GPU pool below 4 GiB (0x90000000 is the modem's carveout). Until keep mode
+ * (glue plan K1) holds the GPU up, it is never ready: RedwoodGPU's user client
+ * does not start and RedwoodGPUStart() is not called, so nothing below that
+ * needs a running GPU is reached yet.
+ */
+bool redwood_gpu_on(void);
+bool redwood_gpu_identity(void);
+bool topaz_gpu_midmem(void);
+uint64_t topaz_gpu_pool_alloc(uint64_t size, void **va);
+void *topaz_gpu_pool_md(uint64_t pa, uint64_t size);
+void topaz_gpu_pool_free(uint64_t pa, uint64_t size);
+bool redwood_gpu_ready(void);
+bool redwood_gpu_parameter(uint32_t which, uint64_t *value);
+uint64_t redwood_gpu_address(uint64_t size);
+void redwood_gpu_address_free(uint64_t address, uint64_t size);
+bool redwood_gpu_map(uint64_t address, uint64_t phys, bool read_only);
+void redwood_gpu_mapped(void);
+void redwood_gpu_unmap(uint64_t address, uint64_t size);
+void redwood_gpu_to_memory(void *start, uint64_t size);
+uint32_t redwood_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count);
+bool redwood_gpu_done(uint32_t fence);
+uint32_t redwood_gpu_last(void);
+void redwood_gpu_worked(uint64_t *microseconds, uint32_t *submissions, uint32_t by[7]);
+void redwood_gpu_report(const char *why);
+void redwood_gpu_stop(void);
+void redwood_tl(const char *format, ...) __printflike(1, 2);
+void topaz_adreno_init(void);
+
+/* RedwoodGPU.cpp's switch for a "tl: Q" line per submission (through redwood_tl); never set, as in topaz */
+uint32_t gpu_log;
+
+/* the GPU path runs this boot: SweetSurface's surfaces then get the rows the GPU's tiles run into (K1, K5) */
+bool
+redwood_gpu_on(void)
+{
+	return false;
+}
+
+/* GPU address = physical address: never here, the SMMU translates */
+bool
+redwood_gpu_identity(void)
+{
+	return false;
+}
+
+/* topaz's "the kernel has RAM below 4 GiB" (ADT --midmem): not here */
+bool
+topaz_gpu_midmem(void)
+{
+	return false;
+}
+
+/* no GPU pool: 0 */
+uint64_t
+topaz_gpu_pool_alloc(__unused uint64_t size, void **va)
+{
+	if (va != NULL) {
+		*va = NULL;
+	}
+	return 0;
+}
+
+/* (an IOMemoryDescriptor * in SweetSurface.cpp and RedwoodGPU.cpp) */
+void *
+topaz_gpu_pool_md(__unused uint64_t pa, __unused uint64_t size)
+{
+	return NULL;
+}
+
+void
+topaz_gpu_pool_free(__unused uint64_t pa, __unused uint64_t size)
+{
+}
+
+bool
+redwood_gpu_ready(void)
+{
+	return false;
+}
+
+/* the answers of glue plan 3.3 come with K4 */
+bool
+redwood_gpu_parameter(__unused uint32_t which, __unused uint64_t *value)
+{
+	return false;
+}
+
+/* GPU addresses and page tables for programs' buffers come with K2 */
+uint64_t
+redwood_gpu_address(__unused uint64_t size)
+{
+	return 0;
+}
+
+void
+redwood_gpu_address_free(__unused uint64_t address, __unused uint64_t size)
+{
+}
+
+bool
+redwood_gpu_map(__unused uint64_t address, __unused uint64_t phys, __unused bool read_only)
+{
+	return false;
+}
+
+void
+redwood_gpu_mapped(void)
+{
+}
+
+void
+redwood_gpu_unmap(__unused uint64_t address, __unused uint64_t size)
+{
+}
+
+/* out of this processor's cache into memory (clean + invalidate); (NULL, 0): the barrier alone */
+void
+redwood_gpu_to_memory(void *start, uint64_t size)
+{
+	if (start != NULL && size != 0) {
+		kg_to_memory((vm_offset_t)start, (vm_size_t)size);
+	} else {
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+}
+
+/* submission and fences come with K3: nothing is taken, and nothing is ever outstanding */
+uint32_t
+redwood_gpu_submit(__unused const uint64_t *addresses, __unused const uint32_t *words, __unused uint32_t count)
+{
+	return 0;
+}
+
+bool
+redwood_gpu_done(__unused uint32_t fence)
+{
+	return true;
+}
+
+uint32_t
+redwood_gpu_last(void)
+{
+	return 0;
+}
+
+void
+redwood_gpu_worked(uint64_t *microseconds, uint32_t *submissions, uint32_t by[7])
+{
+	*microseconds = 0;
+	*submissions = 0;
+	bzero(by, 7 * sizeof(uint32_t));
+}
+
+void
+redwood_gpu_report(const char *why)
+{
+	printf("SWEET KGPU: RedwoodGPU reports \"%s\", with no GPU behind it yet\n", why);
+}
+
+void
+redwood_gpu_stop(void)
+{
+}
+
+void
+redwood_tl(__unused const char *format, ...)
+{
+}
+
+/*
+ * From AppleCLCD::start (SweetFramebuffer.cpp), before the first IOSurface. Keep
+ * mode (K1) starts here; until then only a word for gpu=1, which asked for topaz's
+ * driver (and which SweetSurface still reads: contiguous memory for its surfaces).
+ */
+void
+topaz_adreno_init(void)
+{
+	int gpu = 0;
+
+	if (PE_parse_boot_argn("gpu", &gpu, sizeof(gpu)) && gpu != 0) {
+		printf("SWEET KGPU: gpu=%d asks for topaz's A610 driver, which kunzite does not build; "
+		    "no GPU path yet (glue plan K1)\n", gpu);
+	}
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
