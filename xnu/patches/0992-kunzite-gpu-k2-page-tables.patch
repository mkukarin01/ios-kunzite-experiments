+	kg_ubuf_drop(&a);
+	if ((entry & (PTE_AP_RO | PTE_AP_UNPRIV)) != (PTE_AP_RO | PTE_AP_UNPRIV)) {
+		goto out;
+	}
+
+	printf("SWEET KGPU: 23 THE GPU'S OWN BUFFERS WORK: %u rounds, two at once, a remap, 34 MB; tables %u used of %u "
+	    "(%u before), %u pages made on demand (%u before); all GPU addresses back (%u free range%s); cb0 fsr %#x\n",
+	    KG_U_ROUNDS, kg_space.used, kg_space.ntables, used0, kg_space.npages - kg_space.pool_pages, made0, kg_uva_n,
+	    kg_uva_n == 1 ? "" : "s", kg_rd(kg.smmu, cb + SMMU_CB_FSR));
+	ok = kg_uva_n == 1;
