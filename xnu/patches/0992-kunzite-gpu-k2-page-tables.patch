+	if (!kg_ufill("cp_rb_wptr (2d fill, the last 64K of 34 MB)", a.va + a.size - 0x10000u, 16, 10, 20, 250, 0x6b6723b0u)) {
+		goto out;
+	}
+	bad = kg_ucheck(a.mem + (vm_offset_t)a.size - 0x10000u, 16, 10, 20, 250);
