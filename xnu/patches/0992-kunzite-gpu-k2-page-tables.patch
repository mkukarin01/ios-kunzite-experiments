+/* the entries cleared and the TLB told before this returns: the memory may go right after */
+static void
+kg_uunmap(uint64_t va, uint64_t size)
+{
+	if (kg_space.ntables == 0 || va < KG_UVA_START || va + size > KG_UVA_END) {
+		return;
