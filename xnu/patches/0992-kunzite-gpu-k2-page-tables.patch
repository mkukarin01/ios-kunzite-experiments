+ * an unmap (the GPU must write the new pages, not the old ones: the TLB was told);
+ * a 34 MB buffer, whose last pages need tables beyond step 13's pool; a read-only
+ * entry. Nothing to undo: every buffer goes in the step; the tables made stay.
+ */
+#define KG_U_PITCH       4096u           /* 1024 pixels of 8888 a row */
+#define KG_U_ROUNDS      12u
+struct kg_ubuf {
+	vm_offset_t mem;
+	uint64_t va, size;
+};
+
+static bool
+kg_ubuf_make(struct kg_ubuf *b, uint64_t size, bool read_only)
+{
+	b->mem = 0;
+	b->va = 0;
+	b->size = size;
+	if (kmem_alloc(kernel_map, &b->mem, (vm_size_t)size, KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_BSD) != KERN_SUCCESS) {
+		b->mem = 0;
+		printf("SWEET KGPU: 23 no memory for a buffer of %llu KB\n", size >> 10);
+		return false;
+	}
+	kg_to_memory(b->mem, (vm_size_t)size);     /* the zeroes to memory, where the GPU reads */
+	b->va = kg_uva_alloc(size);
+	if (b->va == 0) {
+		printf("SWEET KGPU: 23 no GPU address for %llu KB\n", size >> 10);
+		return false;
+	}
+	for (uint64_t o = 0; o < size; o += 0x1000u) {
+		if (!kg_umap(b->va + o, kvtophys(b->mem + o), read_only)) {
+			printf("SWEET KGPU: 23 GPU %#llx not mapped\n", b->va + o);
+			return false;
+		}
+	}
+	kg_umapped();
+	return true;
+}
+
+static void
+kg_ubuf_drop(struct kg_ubuf *b)
+{
+	if (b->va != 0) {
+		kg_uunmap(b->va, b->size);
+		kg_uva_free(b->va, b->size);
+		b->va = 0;
+	}
+	if (b->mem != 0) {
+		kmem_free(kernel_map, b->mem, (vm_size_t)b->size);
+		b->mem = 0;
+	}
+}
+
+/* rows [0, rows) of 1024 pixels at GPU va filled with one colour, the caches to memory, idle, a marker */
+static bool
+kg_ufill(const char *what, uint64_t va, uint32_t rows, uint8_t r, uint8_t g, uint8_t b, uint32_t mark)
+{
+	uint64_t at = KG_GPU_SCRATCH_VA + KG_GPU_WORD_OFF + 8;
+
+	kg_cs_n = 0;
+	kg_cs_pkt7(0x46, 1);                            /* CCU_INVALIDATE_COLOR */
+	kg_cs_word(0x19);
+	kg_cs_pkt7(0x65, 1);                            /* CP_SET_MARKER RM6_BLIT2DSCALE */
+	kg_cs_word(12);
+	kg_cs_reg(0x88e5, 0x40u << 23);                 /* RB_CCU_CACHE_CNTL, as step 22 */
+	kg_cs_fill_at(va, KG_U_PITCH, KG_U_PITCH / 4u, 0, rows, r, g, b);
+	kg_cs_pkt7(0x46, 1);                            /* CCU_CLEAN_COLOR */
+	kg_cs_word(0x21);
+	kg_cs_pkt7(0x46, 1);                            /* CACHE_CLEAN */
+	kg_cs_word(0x31);
+	kg_cs_pkt7(0x26, 0);                            /* CP_WAIT_FOR_IDLE */
+	kg_cs_pkt7(0x3d, 3);                            /* CP_MEM_WRITE: the marker */
+	kg_cs_word((uint32_t)at);
+	kg_cs_word((uint32_t)(at >> 32));
+	kg_cs_word(mark);
+	kg_cs_pkt7(0x12, 0);                            /* CP_WAIT_MEM_WRITES */
+	return kg_cp_submit(what, kg_cs, kg_cs_n);
+}
+
+/* every row's first and last pixel of rows [0, rows) at kernel address p; the number that are not (r, g, b) */
+static unsigned
+kg_ucheck(vm_offset_t p, uint32_t rows, uint8_t r, uint8_t g, uint8_t b)
+{
+	unsigned bad = 0;
+
+	kg_to_memory(p, (vm_size_t)rows * KG_U_PITCH);
+	for (uint32_t y = 0; y < rows; y++) {
+		const volatile uint8_t *q = (const volatile uint8_t *)(p + (vm_offset_t)y * KG_U_PITCH);
+		bad += !(q[0] == b && q[1] == g && q[2] == r && q[3] == 0xff);
+		bad += !(q[KG_U_PITCH - 4] == b && q[KG_U_PITCH - 3] == g && q[KG_U_PITCH - 2] == r && q[KG_U_PITCH - 1] == 0xff);
+	}
+	return bad;
+}
