+/* ---- the GPU's own buffers (glue plan K2): addresses, tables on demand, map and unmap ---- */
+
+/*
+ * kgsl's 64-bit user range (kgsl_iommu.h KGSL_IOMMU_VA_BASE64/END64): inside our
+ * 39-bit tables, clear of the secure range at 0x1_0000_0000 and of the kernel's
+ * own addresses at 0xe0000000. Sizes go in 64K grains, and each buffer has one
+ * unmapped grain after it: a write past its end faults instead of landing in the
+ * next buffer.
+ */
+#define KG_UVA_START     0x4000000000ull
+#define KG_UVA_END       0x8000000000ull
+#define KG_UVA_GRAIN     0x10000ull
+#define KG_UVA_HOLES     256u
+static struct {
+	uint64_t start, size;
+} kg_uva[KG_UVA_HOLES];                 /* the free ranges, in address order */
+static unsigned kg_uva_n;
+static bool kg_uva_ready;
+
+static uint64_t
+kg_uva_need(uint64_t size)
+{
+	return ((size + KG_UVA_GRAIN - 1) & ~(KG_UVA_GRAIN - 1)) + KG_UVA_GRAIN;
+}
+
+/* a GPU address for `size` bytes (first fit); 0 if there is none */
+static uint64_t
+kg_uva_alloc(uint64_t size)
+{
+	uint64_t need = kg_uva_need(size);
+
+	if (!kg_uva_ready) {
+		kg_uva[0].start = KG_UVA_START;
+		kg_uva[0].size = KG_UVA_END - KG_UVA_START;
+		kg_uva_n = 1;
+		kg_uva_ready = true;
+	}
+	if (size == 0) {
+		return 0;
+	}
+	for (unsigned i = 0; i < kg_uva_n; i++) {
+		if (kg_uva[i].size >= need) {
+			uint64_t va = kg_uva[i].start;
+			kg_uva[i].start += need;
+			kg_uva[i].size -= need;
+			if (kg_uva[i].size == 0) {
+				memmove(&kg_uva[i], &kg_uva[i + 1], (--kg_uva_n - i) * sizeof(kg_uva[0]));
+			}
+			return va;
+		}
+	}
+	return 0;
+}
+
+/* the range back (its grain after it too), merged with its neighbours */
+static void
+kg_uva_free(uint64_t va, uint64_t size)
+{
+	uint64_t need = kg_uva_need(size);
+	unsigned at;
+
+	if (size == 0 || va < KG_UVA_START || va + need > KG_UVA_END) {
+		return;
+	}
+	for (at = 0; at < kg_uva_n && kg_uva[at].start < va; at++) {
+	}
+	if (at > 0 && kg_uva[at - 1].start + kg_uva[at - 1].size == va) {
+		kg_uva[at - 1].size += need;
+		if (at < kg_uva_n && va + need == kg_uva[at].start) {
+			kg_uva[at - 1].size += kg_uva[at].size;
+			memmove(&kg_uva[at], &kg_uva[at + 1], (--kg_uva_n - at) * sizeof(kg_uva[0]));
+		}
+	} else if (at < kg_uva_n && va + need == kg_uva[at].start) {
+		kg_uva[at].start = va;
+		kg_uva[at].size += need;
+	} else if (kg_uva_n < KG_UVA_HOLES) {
+		memmove(&kg_uva[at + 1], &kg_uva[at], (kg_uva_n++ - at) * sizeof(kg_uva[0]));
+		kg_uva[at].start = va;
+		kg_uva[at].size = need;
+	} else {
+		printf("SWEET KGPU: GPU addresses %#llx + %#llx not taken back: %u holes already\n", va, need, KG_UVA_HOLES);
+	}
