kunzite: live console over USB without losing the boot. The log thread used
to advance past datagrams that failed to send (every send fails until the Mac
has its address), and sent bursts with no pacing into the 32-frame ECM queue.
Now: failed chunks are retried, at most 8 datagrams per 10 ms tick go out, and
the PC can ask for a replay with a datagram to the phone's udp/5140 ("replay" =
whole 4 MiB ring, "tail N" = last N bytes; tools/udp-log.py sends it).

diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -761,21 +761,57 @@
 }
 
 /*
- * Live console log over USB Ethernet: every 100 ms the new bytes of the
+ * Live console log over USB Ethernet: the new bytes of the
  * console ring (bsd/dev/sweet_ufs.c) go as UDP datagrams to
- * 192.168.7.1:5140 (on the PC: nc -ukl 5140). Starts with the last 64 KiB
- * so the boot is included. Nothing here may print (it would feed itself).
- * Boot-arg sweetusblog=0 disables it.
+ * 192.168.7.1:5140 (on the PC: tools/udp-log.py).
+ * Nothing here may print (it would feed itself). Boot-arg
+ * sweetusblog=0 disables it.
+ *
+ * kunzite: paced, retried and replayable - the first 64 KiB still go out
+ * unprompted so the boot is included. The PC may ask for a replay by
+ * sending a datagram to the
+ * phone's port 5140: "replay" = the whole ring (4 MiB), "tail N" = the last
+ * N bytes. Sending is paced (at most UD_LOG_BURST datagrams per 10 ms tick:
+ * the ECM transmit queue holds UD_TXQ frames and drops the rest silently),
+ * and a datagram that fails to send is retried instead of skipped (before
+ * the PC has its address every send fails, and the boot used to be lost).
  */
 extern uint32_t sweet_log_copy(uint64_t *pos, char *out, uint32_t max);
 extern uint64_t sweet_log_position(void);
 
+#define UD_LOG_BURST    8
+
+static void
+ud_log_request(socket_t so, uint64_t *pos)
+{
+	char req[32];
+	for (;;) {
+		struct iovec iov = { .iov_base = req, .iov_len = sizeof(req) - 1 };
+		struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
+		size_t got = 0;
+		if (sock_receive(so, &msg, MSG_DONTWAIT, &got) != 0 || got == 0) {
+			return;
+		}
+		req[got] = 0;
+		uint64_t now = sweet_log_position();
+		if (strncmp(req, "replay", 6) == 0) {
+			*pos = 0;               /* sweet_log_copy skips to the oldest byte kept */
+		} else if (strncmp(req, "tail ", 5) == 0) {
+			uint64_t n = 0;
+			for (const char *c = req + 5; *c >= '0' && *c <= '9'; c++) {
+				n = n * 10 + (uint64_t)(*c - '0');
+			}
+			*pos = n < now ? now - n : 0;
+		}
+	}
+}
+
 static void
 ud_log_thread(void *arg __unused, wait_result_t wr __unused)
 {
 	static char chunk[1400];
 	socket_t so = NULL;
-	struct sockaddr_in to;
+	struct sockaddr_in to, me;
 	uint64_t pos = sweet_log_position();
 
 	pos = pos > 65536 ? pos - 65536 : 0;
@@ -784,25 +820,39 @@
 	to.sin_family = AF_INET;
 	to.sin_port = htons(5140);
 	to.sin_addr.s_addr = htonl(0xc0a80701);         /* 192.168.7.1 */
+	bzero(&me, sizeof(me));
+	me.sin_len = sizeof(me);
+	me.sin_family = AF_INET;
+	me.sin_port = htons(5140);                      /* replay requests */
 	for (;;) {
-		ud_sleep_ms(100);
+		ud_sleep_ms(10);
 		if (!ud.configured) {
 			continue;
 		}
-		if (so == NULL && sock_socket(PF_INET, SOCK_DGRAM, IPPROTO_UDP, NULL, NULL, &so) != 0) {
-			so = NULL;
-			continue;
-		}
-		uint32_t n;
-		while ((n = sweet_log_copy(&pos, chunk, sizeof(chunk))) > 0) {
+		if (so == NULL) {
+			if (sock_socket(PF_INET, SOCK_DGRAM, IPPROTO_UDP, NULL, NULL, &so) != 0) {
+				so = NULL;
+				continue;
+			}
+			(void)sock_bind(so, (struct sockaddr *)&me);
+		}
+		ud_log_request(so, &pos);
+		for (int burst = 0; burst < UD_LOG_BURST; burst++) {
+			uint32_t n = sweet_log_copy(&pos, chunk, sizeof(chunk));
+			if (n == 0) {
+				break;
+			}
 			struct iovec iov = { .iov_base = chunk, .iov_len = n };
 			struct msghdr msg = {
 				.msg_name = &to, .msg_namelen = sizeof(to),
 				.msg_iov = &iov, .msg_iovlen = 1,
 			};
 			size_t sent = 0;
-			if (sock_send(so, &msg, 0, &sent) != 0) {
-				break;          /* no route/ARP yet: retry later */
+			if (sock_send(so, &msg, 0, &sent) != 0 || sent != n) {
+				/* no route/ARP yet: retry this chunk later (it starts at
+				 * pos - n even when sweet_log_copy skipped ahead) */
+				pos -= n;
+				break;
 			}
 		}
 	}
