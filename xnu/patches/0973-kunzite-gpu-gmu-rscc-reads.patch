+/* ---- step 6: the first words from the GPU block ---- */
+
+/* a GMU-side register by its kgsl number */
+static uint32_t
+kg_gmu(uint32_t reg)
+{
+	return kg_rd(kg.gmu, 4u * reg - (KG_GMU_PA - KG_GPU_PA));
+}
+
+static uint32_t
+kg_gbif(uint32_t reg)
+{
+	return kg_rd(kg.gbif, 4u * reg - (KG_GBIF_PA - KG_GPU_PA));
+}
+
+/* what steps 6 and 7 stand on: CX powered and the GMU's clock running */
+static bool
+kg_cx_ready(unsigned step)
+{
+	uint32_t gmu_clk = kg.gpucc != 0 ? kg_rd(kg.gpucc, 0x913c) : 0;
+	if (kg.gpucc == 0 || !kg_cx_on() || (gmu_clk & (KG_CBCR_ENABLE | KG_CBCR_OFF)) != KG_CBCR_ENABLE) {
+		printf("SWEET KGPU: %u needs CX on and cx_gmu running (cx_gmu %#x): steps 4 and 5\n", step, gmu_clk);
+		return false;
+	}
+	return true;
+}
+
+/* how fast a 32-bit counter runs, over 10 ms */
+static unsigned
+kg_rate(uint32_t reg)
+{
+	uint64_t nanos;
+	uint64_t t0 = mach_absolute_time();
+	uint32_t c0 = kg_gmu(reg);
+	delay(10000);
+	uint32_t c1 = kg_gmu(reg);
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &nanos);
+	return nanos ? (unsigned)((uint64_t)(c1 - c0) * NSEC_PER_SEC / nanos) : 0;
+}
+
+static bool
+kg_step6(void)
+{
+	if (!kg_cx_ready(6)) {
+		return false;
+	}
+	kg_announce(6, "GMU 0x3d68000: CM3 state, HFI status, power state (the first words from the GPU block)");
+	kg.gmu = kg_map("GMU", KG_GMU_PA, KG_GMU_SIZE);
+	if (kg.gmu == 0) {
+		return false;
+	}
+	printf("SWEET KGPU: 6 cm3 sysreset %#x boot_config %#x fw_init_result %#x cfg %#x\n",
+	    kg_gmu(GEN7_GMU_CM3_SYSRESET), kg_gmu(GEN7_GMU_CM3_BOOT_CONFIG), kg_gmu(GEN7_GMU_CM3_FW_INIT_RESULT),
+	    kg_gmu(GEN7_GMU_CM3_CFG));
+	printf("SWEET KGPU: 6 hfi_ctrl_status %#x general_7 %#x rpmh_power_state %#x gfx_pwr_clk_status %#x keepalive %#x\n",
+	    kg_gmu(GEN7_GMU_HFI_CTRL_STATUS), kg_gmu(GEN7_GMU_GENERAL_7), kg_gmu(GEN7_GMU_RPMH_POWER_STATE),
+	    kg_gmu(GEN7_GMU_GFX_PWR_CLK_STATUS), kg_gmu(GEN7_GMU_PWR_COL_KEEPALIVE));
+	printf("SWEET KGPU: 6 ao host_interrupt_status %#x gpu_cx_busy_status %#x ahb_fence_status %#x\n",
+	    kg_gmu(GEN7_GMU_AO_HOST_INTERRUPT_STATUS), kg_gmu(GEN7_GMU_AO_GPU_CX_BUSY_STATUS),
+	    kg_gmu(GEN7_GMU_AHB_FENCE_STATUS));
+
+	kg_announce(6, "the GMU's two always-on counters, twice 10 ms apart");
+	uint32_t cx_hi = kg_gmu(GEN7_GMU_CX_AO_COUNTER_HI), cx_lo = kg_gmu(GEN7_GMU_CX_AO_COUNTER_LO);
+	uint32_t ao_hi = kg_gmu(GEN7_GMU_ALWAYS_ON_COUNTER_H), ao_lo = kg_gmu(GEN7_GMU_ALWAYS_ON_COUNTER_L);
+	unsigned cx_hz = kg_rate(GEN7_GMU_CX_AO_COUNTER_LO), ao_hz = kg_rate(GEN7_GMU_ALWAYS_ON_COUNTER_L);
+	bool alive = (cx_hz > 18000000u && cx_hz < 20500000u) || (ao_hz > 18000000u && ao_hz < 20500000u);
+	printf("SWEET KGPU: 6 cx_ao_counter %#x:%08x at %u Hz, always_on_counter %#x:%08x at %u Hz: %s\n",
+	    cx_hi, cx_lo, cx_hz, ao_hi, ao_lo, ao_hz,
+	    alive ? "the 19.2 MHz crystal: THE GPU BLOCK ANSWERS" : "no counter at 19.2 MHz (firmware may start them)");
+
+	kg_announce(6, "the first words of the GMU's ITCM and DTCM");
+	printf("SWEET KGPU: 6 itcm %#x %#x %#x %#x, dtcm %#x %#x %#x %#x\n",
+	    kg_gmu(GEN7_GMU_CM3_ITCM_START), kg_gmu(GEN7_GMU_CM3_ITCM_START + 1), kg_gmu(GEN7_GMU_CM3_ITCM_START + 2),
+	    kg_gmu(GEN7_GMU_CM3_ITCM_START + 3), kg_gmu(GEN7_GMU_CM3_DTCM_START), kg_gmu(GEN7_GMU_CM3_DTCM_START + 1),
+	    kg_gmu(GEN7_GMU_CM3_DTCM_START + 2), kg_gmu(GEN7_GMU_CM3_DTCM_START + 3));
+
+	kg_announce(6, "GBIF 0x3d0f000 (CX side of the bus interface)");
+	kg.gbif = kg_map("GBIF", KG_GBIF_PA, 0x1000);
+	if (kg.gbif == 0) {
+		return false;
+	}
+	printf("SWEET KGPU: 6 gbif cx_config %#x scache_cntl0 %#x halt %#x halt_ack %#x\n",
+	    kg_gbif(GEN7_GBIF_CX_CONFIG), kg_gbif(GEN7_GBIF_SCACHE_CNTL0), kg_gbif(GEN7_GBIF_HALT),
+	    kg_gbif(GEN7_GBIF_HALT_ACK));
+
+	kg_announce(6, "CX misc 0x3d9e040: AHB controls");
+	printf("SWEET KGPU: 6 cx_misc ahb aon %#x gmu %#x cp %#x vbif_smmu %#x host %#x\n",
+	    kg_gmu(GEN7_CX_MISC_CX_AHB_AON_CNTL), kg_gmu(GEN7_CX_MISC_CX_AHB_AON_CNTL + 1),
+	    kg_gmu(GEN7_CX_MISC_CX_AHB_AON_CNTL + 2), kg_gmu(GEN7_CX_MISC_CX_AHB_AON_CNTL + 3),
+	    kg_gmu(GEN7_CX_MISC_CX_AHB_AON_CNTL + 4));
+	return true;
+}
+
+/* ---- step 7: the GMU's channel to RPMh ---- */
+
+static bool
+kg_step7(void)
+{
+	if (!kg_cx_ready(7) || kg.gmu == 0) {
+		return false;
+	}
+	kg_announce(7, "RSCC 0x3d50000 (the GMU's RPMh channel) and the GMU's rscc_control_ack");
+	kg.rscc = kg_map("RSCC", KG_RSCC_PA, KG_RSCC_SIZE);
+	if (kg.rscc == 0) {
+		return false;
+	}
+	printf("SWEET KGPU: 7 rscc status0 %#x pdc_slave_id %#x seq_busy %#x seq_mem_0 %#x drv_config %#x control_ack %#x\n",
+	    kg_rd(kg.rscc, 4u * GEN7_RSCC_RSC_STATUS0_DRV0), kg_rd(kg.rscc, 4u * GEN7_RSCC_PDC_SLAVE_ID_DRV0),
+	    kg_rd(kg.rscc, 4u * GEN7_RSCC_SEQ_BUSY_DRV0), kg_rd(kg.rscc, 4u * GEN7_RSCC_SEQ_MEM_0_DRV0),
+	    kg_rd(kg.rscc, 0xc), kg_gmu(GEN7_GMU_RSCC_CONTROL_ACK));
+	printf("SWEET KGPU: 7 rscc slots irq enable %#x pending %#x\n", kg_rd(kg.rscc, KG_RSCC_SLOTS),
+	    kg_rd(kg.rscc, KG_RSCC_SLOTS + 4));
+	for (uint32_t slot = 0; slot < 4; slot++) {
+		uint32_t at = KG_RSCC_SLOTS + KG_RSCC_SLOT * slot;
+		printf("SWEET KGPU: 7 rscc slot %u wait %#x control %#x idle %#x enabled %#x cmd0 %#x/%#x/%#x/%#x\n", slot,
+		    kg_rd(kg.rscc, at + 0x10), kg_rd(kg.rscc, at + 0x14), kg_rd(kg.rscc, at + 0x18), kg_rd(kg.rscc, at + 0x1c),
+		    kg_rd(kg.rscc, at + 0x30), kg_rd(kg.rscc, at + 0x34), kg_rd(kg.rscc, at + 0x38), kg_rd(kg.rscc, at + 0x3c));
+	}
+
+	kg_announce(7, "PDC 0xb270000: enable_pdc +0x4500, seq_start_addr +0x4520");
+	kg.pdc = kg_map("PDC", KG_PDC_PA, KG_PDC_SIZE);
+	if (kg.pdc == 0) {
+		return false;
+	}
+	printf("SWEET KGPU: 7 pdc enable %#x seq_start_addr %#x\n", kg_rd(kg.pdc, 4u * GEN7_PDC_GPU_ENABLE_PDC),
+	    kg_rd(kg.pdc, 4u * GEN7_PDC_GPU_SEQ_START_ADDR));
+	return true;
+}
