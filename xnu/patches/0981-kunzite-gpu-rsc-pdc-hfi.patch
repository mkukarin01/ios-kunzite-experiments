+/* non-zero words in the GMU's log, read from memory */
+static unsigned
+kg_gmu_log_words(void)
+{
+	volatile uint32_t *log = (volatile uint32_t *)kg_gmu_host(KG_GMU_LOG_VA);
+	unsigned n = 0;
+
+	kg_to_memory((vm_offset_t)log, KG_GMU_LOG_SIZE);
+	for (unsigned i = 0; i < KG_GMU_LOG_SIZE / 4u; i++) {
+		n += log[i] != 0;
+	}
+	return n;
+}
