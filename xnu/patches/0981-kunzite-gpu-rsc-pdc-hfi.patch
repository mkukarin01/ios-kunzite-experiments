+/* ---- step 16: the GMU's RPMh channel, HFI ---- */
+
+#define GEN7_RSCC_PDC_SEQ_START_ADDR     0x008
+#define GEN7_RSCC_PDC_MATCH_VALUE_LO     0x009
+#define GEN7_RSCC_PDC_MATCH_VALUE_HI     0x00a
+#define GEN7_RSCC_HIDDEN_TCS_CMD0_ADDR   0x00d   /* cmd n at +2 n (RSC_CMD_OFFSET) */
+#define GEN7_RSCC_HIDDEN_TCS_CMD0_DATA   0x00e
+#define GEN7_RSCC_OVERRIDE_START_ADDR    0x100
+#define GEN7_GMU_HFI_CTRL_INIT           0x1f986
+#define KG_PDC_ENABLE    0x80000001u     /* GEN7_PDC_ENABLE_REG_VALUE */
+#define KG_HFI_MSGQ      (1u << 0)       /* GMU2HOST_INTR_INFO, adreno_hfi.h */
+#define KG_HFI_DBGQ      (1u << 2)
+#define KG_HFI_CM3_FAULT (1u << 15)
+
+/* kgsl gen7_load_rsc_ucode, in its order (gen7_3_0: SEQ_MEM_0 0x180, cmd2 data 0x80000000) */
+static const struct {
+	uint32_t reg, val;
+	const char *name;
+} kg_rsc[] = {
+	{ GEN7_RSCC_RSC_STATUS0_DRV0, 1u << 24, "rscc status0 (sde clock gating off)" },
+	{ GEN7_RSCC_PDC_SLAVE_ID_DRV0, 1, "rscc pdc_slave_id" },
+	{ GEN7_RSCC_HIDDEN_TCS_CMD0_DATA, 0, "rscc hidden tcs cmd0 data" },
+	{ GEN7_RSCC_HIDDEN_TCS_CMD0_ADDR, 0, "rscc hidden tcs cmd0 addr" },
+	{ GEN7_RSCC_HIDDEN_TCS_CMD0_DATA + 2, 0, "rscc hidden tcs cmd1 data" },
+	{ GEN7_RSCC_HIDDEN_TCS_CMD0_ADDR + 2, 0, "rscc hidden tcs cmd1 addr" },
+	{ GEN7_RSCC_HIDDEN_TCS_CMD0_DATA + 4, 0x80000000u, "rscc hidden tcs cmd2 data" },
+	{ GEN7_RSCC_HIDDEN_TCS_CMD0_ADDR + 4, 0, "rscc hidden tcs cmd2 addr" },
+	{ GEN7_RSCC_OVERRIDE_START_ADDR, 0, "rscc override_start_addr" },
+	{ GEN7_RSCC_PDC_SEQ_START_ADDR, 0x4520, "rscc pdc_seq_start_addr" },
+	{ GEN7_RSCC_PDC_MATCH_VALUE_LO, 0x4510, "rscc pdc_match_value_lo" },
+	{ GEN7_RSCC_PDC_MATCH_VALUE_HI, 0x4514, "rscc pdc_match_value_hi" },
+	{ GEN7_RSCC_SEQ_MEM_0_DRV0, 0xeaaae5a0u, "rscc seq_mem_0" },
+	{ GEN7_RSCC_SEQ_MEM_0_DRV0 + 1, 0xe1a1ebabu, "rscc seq_mem_1" },
+	{ GEN7_RSCC_SEQ_MEM_0_DRV0 + 2, 0xa2e0a581u, "rscc seq_mem_2" },
+	{ GEN7_RSCC_SEQ_MEM_0_DRV0 + 3, 0xecac82e2u, "rscc seq_mem_3" },
+	{ GEN7_RSCC_SEQ_MEM_0_DRV0 + 4, 0x0020edadu, "rscc seq_mem_4" },
+};
+
+/*
+ * kgsl gen7_gmu_first_boot after gen7_gmu_device_start: the RSC and PDC
+ * words (once per boot in kgsl, never taken back; here undone at the end,
+ * while the GMU still runs, before step 15's reset), then gen7_gmu_hfi_start.
+ * No HFI message is sent (step 17).
+ */
+static bool
+kg_step16(void)
+{
+	unsigned rsc = sizeof(kg_rsc) / sizeof(kg_rsc[0]), bad = 0;
+
+	if (!kg_gmu_runs || kg.rscc == 0 || kg.pdc == 0) {
+		printf("SWEET KGPU: 16 needs steps 4-15 (the GMU running in this run)\n");
+		return false;
+	}
+	kg_announce(16, "the GMU's state and the RSCC/PDC words kgsl writes");
+	uint32_t init = kg_gmu(GEN7_GMU_CM3_FW_INIT_RESULT), sysreset = kg_gmu(GEN7_GMU_CM3_SYSRESET);
+	printf("SWEET KGPU: 16 fw_init_result %#x sysreset %#x hfi_ctrl_status %#x gmu2host_intr_info %#x "
+	    "rscc_control_ack %#x\n",
+	    init, sysreset, kg_gmu(GEN7_GMU_HFI_CTRL_STATUS), kg_gmu(GEN7_GMU_GMU2HOST_INTR_INFO),
+	    kg_gmu(GEN7_GMU_RSCC_CONTROL_ACK));
+	printf("SWEET KGPU: 16 rscc seq_busy %#x; pdc enable %#x seq_start_addr %#x\n",
+	    kg_rd(kg.rscc, 4u * GEN7_RSCC_SEQ_BUSY_DRV0), kg_rd(kg.pdc, 4u * GEN7_PDC_GPU_ENABLE_PDC),
+	    kg_rd(kg.pdc, 4u * GEN7_PDC_GPU_SEQ_START_ADDR));
+	if ((init & 0x1ffu) != 0x100u || (sysreset & 1u)) {
+		printf("SWEET KGPU: 16 the GMU is not running as step 15 left it\n");
+		return false;
+	}
+
+	kg_next(16, "the RSC's words (kgsl gen7_load_rsc_ucode, RSCC 0x3d50000), undone at the end");
+	for (unsigned i = 0; i < rsc; i++) {
+		kg_put("RSCC", kg.rscc, 4u * kg_rsc[i].reg, kg_rsc[i].val, KG_UNDO_WORD, 0, kg_rsc[i].name);
+	}
+	for (unsigned i = 0; i < rsc; i++) {
+		uint32_t now = kg_rd(kg.rscc, 4u * kg_rsc[i].reg);
+		if (now != kg_rsc[i].val) {
+			printf("SWEET KGPU: 16   %s reads %#x\n", kg_rsc[i].name, now);
+			bad++;
+		}
+	}
+	printf("SWEET KGPU: 16 rscc: %u of %u words read back different; seq_busy %#x\n", bad, rsc,
+	    kg_rd(kg.rscc, 4u * GEN7_RSCC_SEQ_BUSY_DRV0));
+
+	kg_next(16, "the GPU PDC (kgsl gen7_load_pdc_ucode, 0xb270000: seq_start_addr 0, enable_pdc 0x80000001), "
+	    "undone at the end");
+	kg_put("PDC", kg.pdc, 4u * GEN7_PDC_GPU_SEQ_START_ADDR, 0, KG_UNDO_WORD, 0, "pdc seq_start_addr");
+	kg_put("PDC", kg.pdc, 4u * GEN7_PDC_GPU_ENABLE_PDC, KG_PDC_ENABLE, KG_UNDO_WORD, 0, "pdc enable_pdc");
+	printf("SWEET KGPU: 16 pdc enable %#x seq_start_addr %#x\n", kg_rd(kg.pdc, 4u * GEN7_PDC_GPU_ENABLE_PDC),
+	    kg_rd(kg.pdc, 4u * GEN7_PDC_GPU_SEQ_START_ADDR));
+
+	kg_next(16, "HFI start (kgsl gen7_gmu_hfi_start): HFI_CTRL_INIT 1, HFI_CTRL_STATUS bit 0 for up to 100 ms");
+	uint32_t status0 = kg_gmu(GEN7_GMU_HFI_CTRL_STATUS);
+	unsigned log0 = kg_gmu_log_words();
+	kg_set("GMU", kg.gmu, KG_GMU_OFF(GEN7_GMU_HFI_CTRL_INIT), 1, "hfi_ctrl_init");
+	bool up = kg_poll(kg.gmu, KG_GMU_OFF(GEN7_GMU_HFI_CTRL_STATUS), 1u, 1u, 100);
+	kg_wait(100);                   /* time for the firmware to say more */
+
+	/* what the GMU did: registers, its log, the queues, the SMMU's view */
+	struct kg_hfi_table *t = (struct kg_hfi_table *)kg_gmu_host(KG_GMU_HFI_VA);
+	uint32_t cb = (kg.smmu_pages + KG_GMU_CB) * kg.smmu_page;
+	uint32_t info = kg_gmu(GEN7_GMU_GMU2HOST_INTR_INFO), fsr = kg_rd(kg.smmu, cb + SMMU_CB_FSR);
+	init = kg_gmu(GEN7_GMU_CM3_FW_INIT_RESULT);
+	printf("SWEET KGPU: 16 hfi_ctrl_status %#x -> %#x, fw_init_result %#x, gmu2host_intr_info %#x "
+	    "(msgq %u dbgq %u cm3 fault %u oob %#x), ao_host_interrupt_status %#x\n", status0,
+	    kg_gmu(GEN7_GMU_HFI_CTRL_STATUS), init, info, !!(info & KG_HFI_MSGQ), !!(info & KG_HFI_DBGQ),
+	    !!(info & KG_HFI_CM3_FAULT), info >> 16, kg_gmu(GEN7_GMU_AO_HOST_INTERRUPT_STATUS));
+	printf("SWEET KGPU: 16 gmu log: %u words written before HFI_CTRL_INIT, %u after\n", log0,
+	    kg_gmu_log_words());
+	kg_to_memory((vm_offset_t)t, sizeof(*t));
+	for (unsigned i = 0; i < 3; i++) {
+		printf("SWEET KGPU: 16 hfi queue %u status %#x type %#x size %u r/w %u/%u\n", i, t->q[i].status,
+		    t->q[i].type, t->q[i].queue_size, t->q[i].read_index, t->q[i].write_index);
+	}
+	volatile uint32_t *dbg = (volatile uint32_t *)kg_gmu_host(t->q[2].start_addr);
+	if (t->q[2].write_index != 0 && dbg != NULL) {
+		kg_to_memory((vm_offset_t)dbg, 0x1000);
+		printf("SWEET KGPU: 16 debug queue: %#x %#x %#x %#x\n", dbg[0], dbg[1], dbg[2], dbg[3]);
+	}
+	printf("SWEET KGPU: 16 cb1 fsr %#x sgfsr %#x; rscc seq_busy %#x control_ack %#x\n", fsr,
+	    kg_rd(kg.smmu, SMMU_SGFSR), kg_rd(kg.rscc, 4u * GEN7_RSCC_SEQ_BUSY_DRV0),
+	    kg_gmu(GEN7_GMU_RSCC_CONTROL_ACK));
+
+	bool ok = up && bad == 0 && (init & 0xe00u) == 0 && !(info & KG_HFI_CM3_FAULT) && !(fsr & SMMU_FSR_ALL);
+	printf("SWEET KGPU: 16 %s%s\n", ok ? "HFI IS UP (HFI_CTRL_STATUS bit 0, as kgsl waits for)" :
+	    !up ? "HFI_CTRL_STATUS bit 0 does not come in 100 ms" :
+	    bad ? "the RSCC does not keep kgsl's words" : "the GMU faulted (NMI, CM3 fault or SMMU)",
+	    (status0 & 1u) ? "; bit 0 was set before HFI_CTRL_INIT too" : "");
+	return ok;
+}
