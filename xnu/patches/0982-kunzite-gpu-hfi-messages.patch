+/*
+ * kgsl gen7_hfi_send_generic_req (HFI 2.1: the result is the ack's third
+ * word): the command into the command queue, the doorbell, then
+ * GMU2HOST_INTR_INFO bit 0 (or the message queue moving) for up to 1 s,
+ * giving up early on an NMI as poll_gmu_reg does; then every message.
+ */
+static bool
+kg_hfi_cmd(const char *what, uint32_t *cmd, uint32_t dwords)
+{
+	volatile struct kg_hfi_queue *h = &kg_hfi->q[0];
+	uint32_t w = h->write_index, r = h->read_index, size = h->queue_size, align = (dwords + 3u) & ~3u;
+	uint32_t space = w >= r ? size - (w - r) : r - w;
+
+	if (w >= size || space <= align) {
+		printf("SWEET KGPU: 17 %s: no room in the command queue (r/w %u/%u)\n", what, r, w);
+		return false;
+	}
+	kg_hfi_seq = (kg_hfi_seq + 1u) & 0xfffu;
+	cmd[0] = kg_hfi_seq << 20 | dwords << 8 | (cmd[0] & 0xffu);
+	uint32_t sent = cmd[0];
+	for (uint32_t i = 0; i < align; i++) {
+		kg_hfi_queue[0][w] = i < dwords ? cmd[i] : 0xfafafafau;
+		w = (w + 1u) % size;
+	}
+	__asm__ volatile("dmb oshst" ::: "memory");
+	h->write_index = w;
+	printf("SWEET KGPU: 17 send %s: hdr %#x, %u words, command queue w %u; HOST2GMU_INTR_SET 1\n", what, sent,
+	    dwords, w);
+	kg_wr(kg.gmu, KG_GMU_OFF(GEN7_GMU_HOST2GMU_INTR_SET), 1);
+
+	uint32_t info = 0, init = 0;
+	unsigned t;
+	for (t = 0; t < 10000; t++) {
+		info = kg_gmu(GEN7_GMU_GMU2HOST_INTR_INFO);
+		init = kg_gmu(GEN7_GMU_CM3_FW_INIT_RESULT);
+		if ((info & KG_HFI_MSGQ) || (init & 0xe00u) || kg_hfi->q[1].write_index != kg_hfi->q[1].read_index) {
+			break;
+		}
+		delay(100);
+	}
+	kg_wr(kg.gmu, KG_GMU_OFF(GEN7_GMU_GMU2HOST_INTR_CLR), KG_HFI_MSGQ);
+	printf("SWEET KGPU: 17   after %u.%u ms: gmu2host_intr_info %#x fw_init_result %#x; command queue r %u, "
+	    "message queue r/w %u/%u\n", t / 10, t % 10, info, init, h->read_index, kg_hfi->q[1].read_index,
+	    kg_hfi->q[1].write_index);
+
+	uint32_t m[KG_HFI_RCVD_MAX], result = ~0u;
+	bool acked = false;
+	while (kg_hfi_read(1, m)) {
+		kg_hfi_show(1, m);
+		if (((m[0] >> 16) & 0xfu) == KG_HFI_TYPE_ACK && ((m[1] ^ sent) & ~KG_HFI_RECORD) == 0) {
+			acked = true;
+			result = m[2];
+		}
+	}
+	kg_hfi_drain(2);
+	if (!acked || result != 0) {
+		printf("SWEET KGPU: 17 %s: %s\n", what, !acked ? "NO ACK" : "the GMU refuses it (result not 0)");
+	}
+	return acked && result == 0;
+}
