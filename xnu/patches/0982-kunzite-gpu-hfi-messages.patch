+static bool
+kg_arc_vote(uint32_t *vote, const uint16_t *pri, unsigned npri, const uint16_t *sec, unsigned nsec, uint16_t vlvl)
+{
+	unsigned k, j;
+
+	for (k = 0; k < npri && pri[k] < vlvl; k++) {
+	}
+	if (k == npri) {
+		printf("SWEET KGPU: 17 no ARC level >= %u\n", vlvl);
+		return false;
+	}
+	for (j = 0; j < nsec; j++) {
+		if (sec[j] >= pri[k] || j + 1 == nsec) {
+			break;
+		}
+	}
+	if (j == nsec) {
+		j = 0;
+	}
+	*vote = (uint32_t)pri[k] << 16 | j << 8 | k;
+	return true;
+}
