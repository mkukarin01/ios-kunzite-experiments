+/* kgsl gen7_hfi_queue_read: one message from a queue, or false */
+static bool
+kg_hfi_read(unsigned qi, uint32_t *m)
+{
+	volatile struct kg_hfi_queue *h = &kg_hfi->q[qi];
+	uint32_t r = h->read_index, w = h->write_index, size = h->queue_size;
+
+	if (r == w) {
+		return false;
+	}
+	__asm__ volatile("dmb oshld" ::: "memory");
+	uint32_t n = r < size ? (kg_hfi_queue[qi][r] >> 8) & 0xffu : 0;
+	if (size != 0x1000u / 4 || n == 0 || n > KG_HFI_RCVD_MAX) {
+		printf("SWEET KGPU: 17 hfi queue %u: r/w %u/%u size %u, message of %u words: dropping what is queued\n",
+		    qi, r, w, size, n);
+		h->read_index = w;
+		return false;
+	}
+	memset(m, 0, KG_HFI_RCVD_MAX * 4);
+	for (uint32_t i = 0; i < n; i++) {
+		m[i] = kg_hfi_queue[qi][r];
+		r = (r + 1u) % size;
+	}
+	h->read_index = (r + 3u) / 4u * 4u % size;
+	return true;
+}
+
+static void
+kg_hfi_show(unsigned qi, const uint32_t *m)
+{
+	uint32_t id = m[0] & 0xffu, type = (m[0] >> 16) & 0xfu;
+
+	if (type == KG_HFI_TYPE_ACK) {
+		printf("SWEET KGPU: 17   q%u ack %#x for %#x: result %#x %#x\n", qi, m[0], m[1], m[2], m[3]);
+	} else if (id == KG_F2H_ERR) {
+		char text[17];
+		memcpy(text, &m[2], 16);
+		for (unsigned i = 0; i < 16; i++) {
+			text[i] = text[i] >= 0x20 && text[i] < 0x7f ? text[i] : (text[i] == 0 ? 0 : '.');
+		}
+		text[16] = 0;
+		printf("SWEET KGPU: 17   q%u GMU ERROR %u %u \"%s\"\n", qi, m[1] >> 16, m[1] & 0xffffu, text);
+	} else if (id == KG_F2H_DEBUG) {
+		printf("SWEET KGPU: 17   q%u debug type %u timestamp %#x data %#x\n", qi, m[1], m[2], m[3]);
+	} else {
+		printf("SWEET KGPU: 17   q%u message %#x: %#x %#x %#x\n", qi, m[0], m[1], m[2], m[3]);
+	}
+}
+
+static void
+kg_hfi_drain(unsigned qi)
+{
+	uint32_t m[KG_HFI_RCVD_MAX];
+	for (unsigned n = 0; n < 16 && kg_hfi_read(qi, m); n++) {
+		kg_hfi_show(qi, m);
+	}
+}
