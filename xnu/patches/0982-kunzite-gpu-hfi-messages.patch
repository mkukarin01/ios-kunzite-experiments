+	unsigned log0 = kg_gmu_log_words();
+	bool ok = false;
+
+	kg_next(17, "HFI H2F_MSG_PERF_TBL (kgsl gen7_hfi_send_gpu_perf_table, the legacy table of HFI 2.1)");
+	if (!kg_hfi_cmd("perf table", (uint32_t *)&kg_perf, sizeof(kg_perf) / 4)) {
+		goto out;
+	}
+	kg_next(17, "HFI H2F_MSG_BW_VOTE_TBL (kgsl build_bw_table)");
+	if (!kg_hfi_cmd("bw table", (uint32_t *)&kg_bw, sizeof(kg_bw) / 4)) {
+		goto out;
+	}
+	kg_next(17, "HFI H2F_MSG_FEATURE_CTRL x3: IFPC, ACD, BCL off");
+	for (unsigned i = 0; i < sizeof(off) / sizeof(off[0]); i++) {
+		uint32_t cmd[4] = { KG_H2F_FEATURE_CTRL, off[i].feature, 0, 0 };
+		(void)kg_hfi_cmd(off[i].name, cmd, 4);
+	}
+	kg_next(17, "HFI H2F_MSG_CORE_FW_START (kgsl gen7_hfi_send_core_fw_start)");
+	uint32_t start[2] = { KG_H2F_CORE_FW_START, 0 };
+	ok = kg_hfi_cmd("core fw start", start, 2);
+	kg_wait(100);
+	kg_hfi_drain(1);
+	kg_hfi_drain(2);
+
+out:;
+	uint32_t cb = (kg.smmu_pages + KG_GMU_CB) * kg.smmu_page, init = kg_gmu(GEN7_GMU_CM3_FW_INIT_RESULT);
+	printf("SWEET KGPU: 17 fw_init_result %#x hfi_ctrl_status %#x gmu2host_intr_info %#x ao_host_interrupt_status %#x "
+	    "rpmh_power_state %#x gfx_pwr_clk_status %#x\n", init, kg_gmu(GEN7_GMU_HFI_CTRL_STATUS),
+	    kg_gmu(GEN7_GMU_GMU2HOST_INTR_INFO), kg_gmu(GEN7_GMU_AO_HOST_INTERRUPT_STATUS),
+	    kg_gmu(GEN7_GMU_RPMH_POWER_STATE), kg_gmu(GEN7_GMU_GFX_PWR_CLK_STATUS));
+	printf("SWEET KGPU: 17 rscc seq_busy %#x control_ack %#x; cb1 fsr %#x sgfsr %#x; gmu log %u -> %u words\n",
+	    kg_rd(kg.rscc, 4u * GEN7_RSCC_SEQ_BUSY_DRV0), kg_gmu(GEN7_GMU_RSCC_CONTROL_ACK),
+	    kg_rd(kg.smmu, cb + SMMU_CB_FSR), kg_rd(kg.smmu, SMMU_SGFSR), log0, kg_gmu_log_words());
+	ok = ok && (init & 0xe00u) == 0 && !(kg_rd(kg.smmu, cb + SMMU_CB_FSR) & SMMU_FSR_ALL);
+	printf("SWEET KGPU: 17 %s\n", ok ? "THE GMU ANSWERS OVER HFI: tables taken, core firmware started" :
+	    "HFI did not get through (see above)");
+	kg_hfi = NULL;
+	ml_io_unmap(alias, KG_GMU_HFI_SIZE);
