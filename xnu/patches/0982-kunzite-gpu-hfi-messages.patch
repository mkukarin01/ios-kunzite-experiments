+static bool
+kg_bcm_read(struct kg_bcm *b)
+{
+	unsigned slave = 0, len = 0;
+	uint32_t aux = 0;
+
+	if (kg_db_find(b->name, &slave, &b->addr, &aux, &len) == 0 || slave != KG_DB_BCM || len < 8) {
+		printf("SWEET KGPU: 17 rpmh %s: no BCM entry in cmd-db (slave %u, %u bytes)\n", b->name, slave, len);
+		return false;
+	}
+	b->unit = kg_db16(aux) | (uint32_t)kg_db16(aux + 2) << 16;
+	b->width = kg_db16(aux + 4);
+	b->vcd = (uint8_t)kg_db16(aux + 6);
+	printf("SWEET KGPU: 17 bcm %s addr %#x unit %u width %u vcd %u\n", b->name, b->addr, b->unit, b->width, b->vcd);
+	return b->fixed || b->unit != 0;
+}
