+/* kgsl tcs_cmd_data for one bandwidth level, ab 0 (no GMU AB vote): one BCM command per BCM */
+static void
+kg_bw_level(const struct kg_bcm *b, unsigned n, uint32_t ib, uint32_t perfmode, uint32_t *data)
+{
+	for (unsigned i = 0; i < n; i++) {
+		bool commit = i == n - 1 || b[i].vcd != b[i + 1].vcd;
+		if (b[i].fixed) {
+			data[i] = KG_BCM_CMD(commit, ib != 0, 0, ib != 0 ? perfmode : 0);
+			continue;
+		}
+		uint64_t y = (uint64_t)ib * b[i].width / b[i].buswidth * 1000u / b[i].unit;
+		if (ib != 0 && y == 0) {
+			y = 1;
+		}
+		if (y > 0x3fffu) {
+			y = 0x3fffu;
+		}
+		data[i] = KG_BCM_CMD(commit, y != 0, 0, y);
+	}
+}
+
+static uint32_t
+kg_bcm_waits(const struct kg_bcm *b, unsigned n)
+{
+	uint32_t mask = 0;
+	for (unsigned i = 0; i < n; i++) {
+		if (i == n - 1 || b[i].vcd != b[i + 1].vcd) {
+			mask |= 1u << i;
+		}
+	}
+	return mask;
+}
