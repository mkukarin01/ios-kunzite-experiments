+/* an ARC's levels, counted as kgsl adreno_rpmh_arc_cmds does (up to the first 0 after a non-0) */
+static unsigned
+kg_arc_levels(const char *res, uint16_t *val)
+{
+	unsigned slave = 0, len = 0, num;
+	uint32_t addr = 0, aux = 0;
+	bool dummy = true;
+
+	if (kg_db_find(res, &slave, &addr, &aux, &len) == 0 || slave != KG_DB_ARC || len < 4) {
+		printf("SWEET KGPU: 17 rpmh %s: no ARC levels in cmd-db\n", res);
+		return 0;
+	}
+	len = len / 2 > KG_ARC_MAX ? KG_ARC_MAX : len / 2;
+	for (unsigned k = 0; k < len; k++) {
+		val[k] = kg_db16(aux + 2 * k);
+	}
+	for (num = 1; num < len; num++) {
+		if (val[num] != 0) {
+			dummy = false;
+		}
+		if (val[num - 1] != 0 && val[num] == 0) {
+			break;
+		}
+	}
+	return dummy ? 0 : num;
+}
