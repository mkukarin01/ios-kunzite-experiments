+/* ---- step 13: GMU memory through the SMMU ---- */
+
+/* the SMMU reads the tables from memory, not from this processor's cache */
+static void
+kg_to_memory(vm_offset_t start, vm_size_t size)
+{
+	for (vm_offset_t line = start & ~(vm_offset_t)63; line < start + size; line += 64) {
+		__asm__ volatile("dc civac, %0" : : "r"(line) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/*
+ * Stream 5 (the GMU) through HLOS entry 1 and context 1, with tables of
+ * ours (3 levels of 4K pages, 39-bit addresses), mapping one test page at the
+ * GMU's 0x60000000. This SMMU has no address translation operations (IDR0
+ * ATOSNS), so what is checked here is that it takes and keeps the
+ * configuration and finishes a TLB sync; the GMU reading through it (steps
+ * 14-15) is the proof of the translation.
+ */
+static bool
+kg_step13(void)
+{
+	static const uint32_t gmu_va_l1 = (uint32_t)(KG_GMU_TEST_VA >> 30) & 0x1ffu;
+	vm_offset_t mem = 0;
+	vm_size_t size = PAGE_SIZE >= 0x4000 ? PAGE_SIZE : 0x4000;
+
+	if (!kg_cx_ready(13) || kg.smmu == 0 || kg.smmu_pages == 0) {
+		printf("SWEET KGPU: 13 needs steps 4-8\n");
+		return false;
+	}
+	uint32_t cb = (kg.smmu_pages + KG_GMU_CB) * kg.smmu_page, gr1 = kg.smmu_page;
+	kg_announce(13, "SMR/S2CR entry 1 and context 1 before using them");
+	uint32_t smr = kg_rd(kg.smmu, SMMU_SMR(KG_GMU_MATCH)), cbar = kg_rd(kg.smmu, gr1 + SMMU_CBAR(KG_GMU_CB));
+	int taken = kg_smmu_match(KG_GMU_STREAM);
+	printf("SWEET KGPU: 13 smr1 %#x cbar1 %#x cb1 sctlr %#x; stream 5 matched by entry %d\n", smr, cbar,
+	    kg_rd(kg.smmu, cb + SMMU_CB_SCTLR), taken);
+	if ((smr & SMMU_SMR_VALID) || cbar != 0 || taken >= 0) {
+		printf("SWEET KGPU: 13 entry 1 / context 1 / stream 5 are in use: not ours to take\n");
+		return false;
+	}
+
+	if (kmem_alloc(kernel_map, &mem, size, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET KGPU: 13 no memory for the tables\n");
+		return false;
+	}
+	kg_undo_push(KG_UNDO_KFREE, mem, 0, (uint32_t)size, "gmu tables and test page");
+	uint64_t phys = kvtophys(mem);
+	if (kvtophys(mem + 0x3000) != phys + 0x3000) {
+		printf("SWEET KGPU: 13 the tables' memory is not in one piece\n");
+		return false;
+	}
+	uint64_t *l1 = (uint64_t *)mem, *l2 = (uint64_t *)(mem + 0x1000), *l3 = (uint64_t *)(mem + 0x2000);
+	uint32_t *test = (uint32_t *)(mem + 0x3000);
+	l1[gmu_va_l1] = (phys + 0x1000) | PTE_TABLE;
+	l2[(KG_GMU_TEST_VA >> 21) & 0x1ffu] = (phys + 0x2000) | PTE_TABLE;
+	l3[(KG_GMU_TEST_VA >> 12) & 0x1ffu] = (phys + 0x3000) | PTE_GMU | PTE_PAGE;
+	for (uint32_t i = 0; i < 1024; i++) {
+		test[i] = 0x6a000000u | i;
+	}
+	kg_to_memory(mem, 0x4000);
+	uint64_t root = phys | (uint64_t)KG_GMU_CB << 48;      /* tagged with the context's ASID */
+	printf("SWEET KGPU: 13 tables at %#llx (l1[%u] %#llx, l2 %#llx, l3 %#llx), GMU %#llx -> test page %#llx\n",
+	    phys, gmu_va_l1, l1[gmu_va_l1], l2[(KG_GMU_TEST_VA >> 21) & 0x1ffu], l3[(KG_GMU_TEST_VA >> 12) & 0x1ffu],
+	    KG_GMU_TEST_VA, phys + 0x3000);
+
+	kg_next(13, "context 1 gets our tables (the first SMMU writes)");
+	kg_put("SMMU", kg.smmu, cb + SMMU_CB_SCTLR, 0, KG_UNDO_WORD, 0, "cb1 sctlr");
+	kg_put("SMMU", kg.smmu, gr1 + SMMU_CBA2R(KG_GMU_CB), SMMU_CBA2R_VA64, KG_UNDO_WORD, 0, "cba2r1");
+	kg_put("SMMU", kg.smmu, gr1 + SMMU_CBAR(KG_GMU_CB), SMMU_CBAR_S1, KG_UNDO_WORD, 0, "cbar1");
+	kg_put("SMMU", kg.smmu, cb + SMMU_CB_TCR2, SMMU_TCR2_VAL, KG_UNDO_WORD, 0, "cb1 tcr2");
+	kg_put("SMMU", kg.smmu, cb + SMMU_CB_TCR, SMMU_TCR_39BIT, KG_UNDO_WORD, 0, "cb1 tcr");
+	kg_put("SMMU", kg.smmu, cb + SMMU_CB_TTBR0, (uint32_t)root, KG_UNDO_WORD, 0, "cb1 ttbr0 lo");
+	kg_put("SMMU", kg.smmu, cb + SMMU_CB_TTBR0 + 4, (uint32_t)(root >> 32), KG_UNDO_WORD, 0, "cb1 ttbr0 hi");
+	kg_put("SMMU", kg.smmu, cb + SMMU_CB_TTBR1, 0, KG_UNDO_WORD, 0, "cb1 ttbr1 lo");
+	kg_put("SMMU", kg.smmu, cb + SMMU_CB_TTBR1 + 4, 0, KG_UNDO_WORD, 0, "cb1 ttbr1 hi");
+	kg_put("SMMU", kg.smmu, cb + SMMU_CB_MAIR0, SMMU_MAIR0_VAL, KG_UNDO_WORD, 0, "cb1 mair0");
+	kg_put("SMMU", kg.smmu, cb + SMMU_CB_MAIR1, 0, KG_UNDO_WORD, 0, "cb1 mair1");
+
+	kg_next(13, "context 1: clear its fault status, forget ASID 1, TLB sync");
+	printf("SWEET KGPU: 13 command fsr <- %#x, tlbiasid <- %u, tlbsync <- 1\n", SMMU_FSR_ALL, KG_GMU_CB);
+	kg_wr(kg.smmu, cb + SMMU_CB_FSR, SMMU_FSR_ALL);
+	kg_wr(kg.smmu, cb + SMMU_CB_TLBIASID, KG_GMU_CB);
+	kg_wr(kg.smmu, cb + SMMU_CB_TLBSYNC, 1);
+	bool synced = kg_poll(kg.smmu, cb + SMMU_CB_TLBSTATUS, 1u, 0, 100);
+	printf("SWEET KGPU: 13 tlbstatus %#x: %s\n", kg_rd(kg.smmu, cb + SMMU_CB_TLBSTATUS),
+	    synced ? "sync done" : "SYNC DOES NOT FINISH");
+	if (!synced) {
+		return false;
+	}
+
+	kg_next(13, "context 1 on, then stream 5 -> entry 1 -> context 1");
+	kg_put("SMMU", kg.smmu, cb + SMMU_CB_SCTLR, SMMU_SCTLR_ON, KG_UNDO_WORD, 0, "cb1 sctlr");
+	kg_put("SMMU", kg.smmu, SMMU_S2CR(KG_GMU_MATCH), KG_GMU_CB, KG_UNDO_WORD, 0, "s2cr1");
+	kg_put("SMMU", kg.smmu, SMMU_SMR(KG_GMU_MATCH), SMMU_SMR_VALID | SMMU_STREAM_MASK << 16 | KG_GMU_STREAM,
+	    KG_UNDO_WORD, 0, "smr1");
+
+	uint32_t r_smr = kg_rd(kg.smmu, SMMU_SMR(KG_GMU_MATCH)), r_s2cr = kg_rd(kg.smmu, SMMU_S2CR(KG_GMU_MATCH));
+	uint32_t r_cbar = kg_rd(kg.smmu, gr1 + SMMU_CBAR(KG_GMU_CB)), r_sctlr = kg_rd(kg.smmu, cb + SMMU_CB_SCTLR);
+	uint32_t r_lo = kg_rd(kg.smmu, cb + SMMU_CB_TTBR0), r_hi = kg_rd(kg.smmu, cb + SMMU_CB_TTBR0 + 4);
+	printf("SWEET KGPU: 13 read back smr1 %#x s2cr1 %#x cbar1 %#x cba2r1 %#x sctlr %#x tcr %#x tcr2 %#x ttbr0 %#x:%08x "
+	    "mair0 %#x fsr %#x sgfsr %#x\n", r_smr, r_s2cr, r_cbar, kg_rd(kg.smmu, gr1 + SMMU_CBA2R(KG_GMU_CB)), r_sctlr,
+	    kg_rd(kg.smmu, cb + SMMU_CB_TCR), kg_rd(kg.smmu, cb + SMMU_CB_TCR2), r_hi, r_lo,
+	    kg_rd(kg.smmu, cb + SMMU_CB_MAIR0), kg_rd(kg.smmu, cb + SMMU_CB_FSR), kg_rd(kg.smmu, SMMU_SGFSR));
+	bool kept = r_smr == (SMMU_SMR_VALID | SMMU_STREAM_MASK << 16 | KG_GMU_STREAM) &&
+	    (r_s2cr & 0x300ffu) == KG_GMU_CB && (r_cbar & 0x30000u) == (SMMU_CBAR_S1 & 0x30000u) && (r_sctlr & 1u) &&
+	    r_lo == (uint32_t)root && r_hi == (uint32_t)(root >> 32);
+	if (!kept) {
+		printf("SWEET KGPU: 13 the SMMU did not keep what was written: stream 5 is not going through context 1\n");
+		return false;
+	}
+	printf("SWEET KGPU: 13 THE SMMU TAKES OUR TABLES: stream 5 (GMU) -> entry 1 -> context 1, GMU %#llx -> %#llx "
+	    "(no ATOS here: the GMU's own reads are the proof)\n", KG_GMU_TEST_VA, phys + 0x3000);
+	return true;
+}
