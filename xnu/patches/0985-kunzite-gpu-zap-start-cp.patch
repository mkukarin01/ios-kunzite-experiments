+/*
+ * kgsl_zap_shader_load = qcom_mdt_load + PAS_AUTH_AND_RESET(13). qcom_mdt_pas_init's
+ * PAS_INIT_IMAGE was step 12's, in this run; then PAS_MEM_SETUP(13, region,
+ * max - min of the loadable segments), each segment copied to region +
+ * paddr - min (relocatable) from the .mdt or its .bNN file, the rest zeroed,
+ * then AUTH_AND_RESET. TrustZone keeps the region from then on: it is not
+ * touched again, and nothing undoes the load (kgsl never unloads it either).
+ */
+static bool
+kg_zap_load(void)
+{
+	void *mdt = NULL, *seg = NULL;
+	size_t mdt_size = 0, seg_size = 0;
+	uint64_t res;
+	bool ok = false;
+
+	if (topaz_fw_read(KG_ZAP_MDT, &mdt, &mdt_size) != 0 || !kg_zap_header_ok(mdt, mdt_size)) {
+		printf("SWEET KGPU: 20 cannot use " KG_ZAP_MDT "\n");
+		if (mdt != NULL) {
+			topaz_fw_free(mdt, mdt_size);
+		}
+		return false;
+	}
+	const uint8_t *m = mdt;
+	unsigned phnum = (unsigned)m[44] | (unsigned)m[45] << 8;
+	uint32_t min = ~0u, max = 0;
+	bool reloc = false;
+#define KG_PH(i, f) ((uint32_t)m[52 + 32 * (i) + (f)] | (uint32_t)m[53 + 32 * (i) + (f)] << 8 | \
+	(uint32_t)m[54 + 32 * (i) + (f)] << 16 | (uint32_t)m[55 + 32 * (i) + (f)] << 24)
+	/* mdt_phdr_valid: PT_LOAD, not the hash segment, memsz != 0 */
+#define KG_PH_LOAD(i) (KG_PH(i, 0) == 1 && ((KG_PH(i, 24) >> 24) & 7u) != 2 && KG_PH(i, 20) != 0)
+	for (unsigned i = 0; i < phnum; i++) {
+		if (!KG_PH_LOAD(i)) {
+			continue;
+		}
+		reloc |= (KG_PH(i, 24) & KG_MDT_RELOC) != 0;
+		min = KG_PH(i, 12) < min ? KG_PH(i, 12) : min;
+		uint32_t end = (KG_PH(i, 12) + KG_PH(i, 20) + 0xfffu) & ~0xfffu;
+		max = end > max ? end : max;
+	}
+	if (min == ~0u || !reloc || max - min > KG_ZAP_SIZE) {
+		printf("SWEET KGPU: 20 zap segments %#x..%#x%s: not what this loader handles\n", min, max,
+		    reloc ? "" : " (not relocatable)");
+		goto out;
+	}
+	printf("SWEET KGPU: 20 zap: loadable %#x..%#x (relocatable) -> region %#x+%#x\n", min, max, KG_ZAP_PA, max - min);
+
+	kg_next(20, "PAS_MEM_SETUP(13, the zap region, its size) (qcom_mdt_pas_init; INIT_IMAGE was step 12's)");
+	if (kg_scm(20, "pas mem setup", KG_SCM_PAS_MEM_SETUP, KG_SCM_ARGS_VAL3, KG_PAS_GPU, KG_ZAP_PA, max - min, &res) != 0 ||
+	    res != 0) {
+		printf("SWEET KGPU: 20 TrustZone does not take the zap region\n");
+		goto out;
+	}
+
+	kg_next(20, "the zap segments into the region 0x89e1a000 (uncached, words)");
+	vm_offset_t region = kg_map("zap region", KG_ZAP_PA, KG_ZAP_SIZE);
+	if (region == 0) {
+		goto out;
+	}
+	for (unsigned i = 0; i < phnum; i++) {
+		if (!KG_PH_LOAD(i)) {
+			continue;
+		}
+		uint32_t off = KG_PH(i, 12) - min, fsz = KG_PH(i, 16), msz = KG_PH(i, 20), foff = KG_PH(i, 4);
+		const uint8_t *src = NULL;
+		if (fsz > msz) {
+			printf("SWEET KGPU: 20 zap segment %u: file size above memory size\n", i);
+			goto out;
+		}
+		if (fsz != 0 && foff < mdt_size && foff + fsz <= mdt_size) {
+			src = m + foff;
+		} else if (fsz != 0) {
+			char path[64];
+			snprintf(path, sizeof(path), KG_ZAP_SEG, i);
+			if (topaz_fw_read(path, &seg, &seg_size) != 0 || seg_size < fsz) {
+				printf("SWEET KGPU: 20 cannot read %s (%lu bytes, %u wanted): upload the phone's vendor one\n", path,
+				    (unsigned long)seg_size, fsz);
+				goto out;
+			}
+			src = seg;
+		}
+		printf("SWEET KGPU: 20 zap segment %u: %u bytes (+%u zero) at region +%#x\n", i, fsz, msz - fsz, off);
+		for (uint32_t o = 0; o < msz; o += 4) {
+			uint32_t w = 0;
+			for (uint32_t k = 0; k < 4 && o + k < fsz; k++) {
+				w |= (uint32_t)src[o + k] << (8 * k);
+			}
+			kg_wr(region, off + o, w);
+		}
+		if (seg != NULL) {
+			topaz_fw_free(seg, seg_size);
+			seg = NULL;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	kg_next(20, "PAS_AUTH_AND_RESET(13): TrustZone checks and takes the zap shader");
+	uint64_t ret = kg_scm(20, "pas auth and reset (zap)", KG_SCM_PAS_AUTH_RESET, KG_SCM_ARGS_VAL, KG_PAS_GPU, 0, 0, &res);
+	ok = ret == 0 && res == 0;
+	printf("SWEET KGPU: 20 %s\n", ok ? "THE ZAP SHADER IS LOADED (TrustZone authenticated it)" :
+	    "TrustZone does not authenticate the zap shader");
+#undef KG_PH_LOAD
+#undef KG_PH
+out:
+	if (seg != NULL) {
+		topaz_fw_free(seg, seg_size);
+	}
+	topaz_fw_free(mdt, mdt_size);
+	return ok;
+}
