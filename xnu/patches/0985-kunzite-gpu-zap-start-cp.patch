+/* a block of GPU registers, announced as one, written, then read back */
+static unsigned
+kg_gpu_regs(const char *what, const struct kg_reg *r, unsigned n)
+{
+	unsigned bad = 0;
+
+	printf("SWEET KGPU: 20 write %u GPU registers: %s\n", n, what);
+	for (unsigned i = 0; i < n; i++) {
+		kg_wr(kg.gpu, 4u * r[i].reg, r[i].val);
+	}
+	for (unsigned i = 0; i < n; i++) {
+		uint32_t v = kg_rd(kg.gpu, 4u * r[i].reg);
+		if (v != r[i].val) {
+			printf("SWEET KGPU: 20   %#x reads %#x, not %#x\n", r[i].reg, v, r[i].val);
+			bad++;
+		}
+	}
+	return bad;
+}
