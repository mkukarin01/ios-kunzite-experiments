+/*
+ * The port map's 19-20 with GX on and the GPU's context from step 19: the
+ * zap shader through TrustZone, then gen7_start for gen7_3_0 (its writes in
+ * kgsl's order; not done: preemption, LLCC slices, the IFPC power-up list,
+ * perfcounters, coresight, interrupts), then gen7_rb_start: RPTR_ADDR to the
+ * scratch page, RB_CNTL, CP_SQE_CNTL 1 (the CP fetches the microcode through
+ * context 0: the first proof of the GPU's translation), CP_THREAD_CONTROL +
+ * CP_ME_INIT (gen7_cp_init_cmds, its power-up list empty, in the scratch
+ * page) at the ring's head, WPTR 10, and adreno_spin_idle: RPTR = WPTR and
+ * CX busy bit 23 clear, for up to 2 s. The GX registers go with GX in the
+ * slumber; the undo halts the CP first (CP_SQE_CNTL 0), before stream 0 is
+ * unrouted and its memory freed.
+ */
+static bool
+kg_step20(void)
+{
+	if (kg.gpu == 0 || !kg_gx_on() || kg_rd(kg.gpu, 4u * GEN7_CP_SQE_INSTR_BASE_LO) != (uint32_t)KG_GPU_SQE_VA) {
+		printf("SWEET KGPU: 20 needs steps 1-19 (GX on, the CP's ring and microcode set, in this run)\n");
+		return false;
+	}
+	kg_announce(20, "the zap shader " KG_ZAP_MDT " again, for its segments");
+	if (!kg_zap_load()) {
+		return false;
+	}
+
+	kg_next(20, "gen7_start's registers (GX registers, kept: they go with GX)");
+	unsigned bad = kg_gpu_regs("gen7_start, plain writes", kg_gen7_start_regs,
+	    sizeof(kg_gen7_start_regs) / sizeof(kg_gen7_start_regs[0]));
+	kg_set("GMU", kg.gmu, KG_GMU_OFF(GEN7_GMU_CX_GMU_POWER_COUNTER_SELECT_1), 0x4, "power_counter_select_1 (ifpc)");
+	kg_set("GPU", kg.gpu, 4u * GEN7_RB_CMP_DBG_ECO_CNTL, kg_rd(kg.gpu, 4u * GEN7_RB_CMP_DBG_ECO_CNTL) | (1u << 11),
+	    "rb_cmp_dbg_eco_cntl | bit 11");
+	kg_set("GMU", kg.gmu, KG_GMU_OFF(GEN7_GPU_GMU_AO_GPU_CX_BUSY_MASK), 0xff000000u, "ao_gpu_cx_busy_mask");
+	kg_set("GMU", kg.gmu, KG_GMU_OFF(GEN7_GMU_CX_GMU_POWER_COUNTER_SELECT_0),
+	    (kg_gmu(GEN7_GMU_CX_GMU_POWER_COUNTER_SELECT_0) & ~0xffu) | 0x20u, "power_counter_select_0 (gpu busy)");
+	kg_set("GMU", kg.gmu, KG_GMU_OFF(GEN7_GMU_CX_GMU_POWER_COUNTER_ENABLE), 1, "power_counter_enable");
+	kg_set("GPU", kg.gpu, 4u * GEN7_CP_PROTECT_CNTL, 0xbu, "cp_protect_cntl (GEN7_PROTECT_DEFAULT)");
+	struct kg_reg prot[sizeof(kg_protect) / sizeof(kg_protect[0])];
+	for (unsigned i = 0; i < sizeof(kg_protect) / sizeof(kg_protect[0]); i++) {
+		prot[i].reg = GEN7_CP_PROTECT_REG + kg_protect[i].n;
+		prot[i].val = kg_protect[i].start | (kg_protect[i].end - kg_protect[i].start) << 18 |
+		    (uint32_t)kg_protect[i].noaccess << 31;
+	}
+	bad += kg_gpu_regs("gen7_protect_init (gen7_0_0_protected_regs)", prot, sizeof(prot) / sizeof(prot[0]));
+	kg_set("GPU", kg.gpu, 4u * GEN7_CP_APRIV_CNTL, 0x6fu, "cp_apriv_cntl (GEN7_BR_APRIV_DEFAULT)");
+	static const struct kg_reg secvid[] = {
+		{ 0xf803, 0 }, { 0xf800, 0xf0000000u }, { 0xf801, 0 }, { 0xf802, 0xfffff000u },
+	};
+	bad += kg_gpu_regs("_set_secvid: TSB off, trusted 0xf0000000 + 0xfffff000 (64-bit kgsl)", secvid, 4);
+	for (unsigned i = 0; i < sizeof(kg_ao_hwcg) / sizeof(kg_ao_hwcg[0]); i++) {
+		kg_set("GMU", kg.gmu, KG_GMU_OFF(kg_ao_hwcg[i].reg), kg_ao_hwcg[i].val, "ao hwcg");
+	}
+	uint32_t clock = kg_rd(kg.gpu, 4u * GEN7_RBBM_CLOCK_CNTL);
+	if (clock != KG_CLOCK_CNTL_ON) {
+		bad += kg_gpu_regs("gen7_hwcg_set(on): gen7_3_0_hwcg_regs", kg_hwcg, sizeof(kg_hwcg) / sizeof(kg_hwcg[0]));
+		kg_set("GPU", kg.gpu, 4u * GEN7_RBBM_CLOCK_CNTL, KG_CLOCK_CNTL_ON, "rbbm_clock_cntl (top level hwcg)");
+	}
+	printf("SWEET KGPU: 20 gen7_start done: %u registers read back different (rbbm_clock_cntl was %#x); rbbm_status %#x, "
+	    "cb0 fsr %#x\n", bad, clock, kg_rd(kg.gpu, 4u * GEN7_RBBM_STATUS),
+	    kg_rd(kg.smmu, (kg.smmu_pages + KG_GPU_CB) * kg.smmu_page + SMMU_CB_FSR));
+
+	/* gen7_rb_start; the CP_ME_INIT stream of gen7_cp_init_cmds at the ring's head */
+	vm_offset_t rb = 0, scratch = 0;
+	for (unsigned i = 0; i < kg.nundo; i++) {
+		if (kg.undo[i].kind == KG_UNDO_KFREE && strcmp(kg.undo[i].name, "gpu ringbuffer") == 0) {
+			rb = kg.undo[i].base;
+		} else if (kg.undo[i].kind == KG_UNDO_KFREE && strcmp(kg.undo[i].name, "gpu scratch page") == 0) {
+			scratch = kg.undo[i].base;
+		}
+	}
+	if (rb == 0 || scratch == 0) {
+		printf("SWEET KGPU: 20 step 19's ring or scratch page is gone\n");
+		return false;
+	}
+	uint64_t reglist = KG_GPU_SCRATCH_VA + KG_SCRATCH_REGLIST;
+	const uint32_t init[10] = {
+		0x70970001u, 1u << 27,          /* CP_THREAD_CONTROL: concurrent binning off */
+		0x70c80007u, KG_ME_INIT_MASK, 0x3, 0x20000000u, 0x2, (uint32_t)reglist, (uint32_t)(reglist >> 32), 1u << 31,
+	};
+	memcpy((void *)rb, init, sizeof(init));
+	memset((void *)scratch, 0, 0x1000);
+	kg_to_memory(rb, sizeof(init));
+	kg_to_memory(scratch, 0x1000);
+
+	kg_next(20, "gen7_rb_start: RPTR_ADDR (the scratch page), RB_CNTL, then CP_SQE_CNTL 1: THE CP STARTS");
+	kg_set("GPU", kg.gpu, 4u * GEN7_CP_RB_RPTR_ADDR_LO, (uint32_t)KG_GPU_SCRATCH_VA, "cp_rb_rptr_addr_lo");
+	kg_set("GPU", kg.gpu, 4u * GEN7_CP_RB_RPTR_ADDR_HI, (uint32_t)(KG_GPU_SCRATCH_VA >> 32), "cp_rb_rptr_addr_hi");
+	kg_set("GPU", kg.gpu, 4u * GEN7_CP_RB_CNTL, KG_CP_RB_CNTL, "cp_rb_cntl");
+	kg_put("GPU", kg.gpu, 4u * GEN7_CP_SQE_CNTL, 1, KG_UNDO_WORD, 0, "cp_sqe_cntl (the CP halted again)");
+	kg_wait(10);
+	uint32_t cb = (kg.smmu_pages + KG_GPU_CB) * kg.smmu_page;
+	printf("SWEET KGPU: 20 cp started: rbbm_status %#x cp_status_1 %#x rptr %u; cp_interrupt_status %#x hw_fault %#x; "
+	    "cb0 fsr %#x\n", kg_rd(kg.gpu, 4u * GEN7_RBBM_STATUS), kg_rd(kg.gpu, 4u * GEN7_CP_STATUS_1),
+	    kg_rd(kg.gpu, 4u * GEN7_CP_RB_RPTR), kg_rd(kg.gpu, 4u * GEN7_CP_INTERRUPT_STATUS),
+	    kg_rd(kg.gpu, 4u * GEN7_CP_HW_FAULT), kg_rd(kg.smmu, cb + SMMU_CB_FSR));
+
+	kg_next(20, "CP_THREAD_CONTROL + CP_ME_INIT (10 words at the ring's head), WPTR 10, then RPTR = 10 and idle "
+	    "for up to 2 s (adreno_spin_idle)");
+	kg_set("GPU", kg.gpu, 4u * GEN7_CP_RB_WPTR, 10, "cp_rb_wptr");
+	uint32_t fence = kg_gmu(GEN7_GMU_AHB_FENCE_STATUS);
+	uint32_t rptr = 0, busy = 0;
+	unsigned t;
+	for (t = 0; t < 20000; t++) {
+		rptr = kg_rd(kg.gpu, 4u * GEN7_CP_RB_RPTR);
+		busy = kg_gmu(GEN7_GMU_AO_GPU_CX_BUSY_STATUS);
+		if (rptr == 10 && !(busy & (1u << 23))) {
+			break;
+		}
+		delay(100);
+	}
+	kg_to_memory(scratch, 64);
+	kg_wr(kg.gpu, 4u * GEN7_CP_SQE_STAT_ADDR, 1);
+	printf("SWEET KGPU: 20 after %u.%u ms: rptr %u (shadow %u) wptr 10, cx_busy %#x, fence status %#x\n", t / 10, t % 10,
+	    rptr, *(volatile uint32_t *)scratch, busy, fence);
+	printf("SWEET KGPU: 20 rbbm_status %#x status3 %#x int_0 %#x; cp_status_1 %#x interrupt %#x hw_fault %#x protect %#x "
+	    "sqe_stat %#x\n", kg_rd(kg.gpu, 4u * GEN7_RBBM_STATUS), kg_rd(kg.gpu, 4u * GEN7_RBBM_STATUS3),
+	    kg_rd(kg.gpu, 4u * GEN7_RBBM_INT_0_STATUS), kg_rd(kg.gpu, 4u * GEN7_CP_STATUS_1),
+	    kg_rd(kg.gpu, 4u * GEN7_CP_INTERRUPT_STATUS), kg_rd(kg.gpu, 4u * GEN7_CP_HW_FAULT),
+	    kg_rd(kg.gpu, 4u * GEN7_CP_PROTECT_STATUS), kg_rd(kg.gpu, 4u * GEN7_CP_SQE_STAT_DATA));
+	printf("SWEET KGPU: 20 cb0 fsr %#x far %#x:%08x fsynr0 %#x; sgfsr %#x\n", kg_rd(kg.smmu, cb + SMMU_CB_FSR),
+	    kg_rd(kg.smmu, cb + SMMU_CB_FAR + 4), kg_rd(kg.smmu, cb + SMMU_CB_FAR), kg_rd(kg.smmu, cb + SMMU_CB_FSYNR0),
+	    kg_rd(kg.smmu, SMMU_SGFSR));
+	bool ok = rptr == 10 && !(busy & (1u << 23));
+	printf("SWEET KGPU: 20 %s\n", ok ? "THE CP RUNS: CP_ME_INIT consumed, the GPU idle (microcode fetched through "
+	    "context 0)" : rptr == 10 ? "the CP took CP_ME_INIT but the GPU does not go idle" :
+	    "the CP does not consume CP_ME_INIT");
+	return ok;
+}
